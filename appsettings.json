{

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=portfolio_db;Username=portfolio_user;Password=change-me"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Privacy": {
    "PageViewRetentionDays": 30,
    "ContentVisitorCookieDays": 90,
    "ConsentCookieDays": 180,
    "TicketSecurityMetadataDays": 30,
    "TicketRetentionDays": 365,
    "ControllerName": "",
    "ContactEmail": "",
    "HostingProvider": "",
    "HostingCountry": ""
  },
  "GeoLocation": {
    "DatabasePath": "geoip/GeoLite2-City.mmdb"
  },
  "Monitoring": {
    "WeeklyReportToken": ""
  },
  "TicketEmail": {
    "Enabled": false,
    "ApiKey": "",
    "FromName": "Emecworks",
    "FromAddress": "",
    "ReplyToAddress": "",
    "PublicBaseUrl": "https://emecworks.com",
    "PollIntervalSeconds": 30,
    "MaxAttempts": 8
  },
  "MediaStorage": {
    // Phase 1 uses local storage; a later phase can move media to Cloudflare R2.
    "Provider": "Local",
    "LocalPath": "wwwroot/uploads",
    "BaseUrl": "/uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedMimeTypes": [ "image/jpeg", "image/png", "image/webp", "image/gif" ]
  }
}
