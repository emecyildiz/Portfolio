{
	admin off
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

http://:8080 {
	encode zstd gzip

	@www host www.emecworks.com
	handle @www {
		redir https://emecworks.com{uri} permanent
	}

	@portfolio_http {
		host emecworks.com
		header X-Forwarded-Proto http
	}
	handle @portfolio_http {
		redir https://emecworks.com{uri} permanent
	}

	@n8n_editor host n8n.emecworks.com
	handle @n8n_editor {
		reverse_proxy n8n-app:5678
	}

	@n8n_hooks {
		host hooks.emecworks.com
		path /webhook /webhook/* /webhook-test /webhook-test/* /webhook-waiting /webhook-waiting/* /form /form/* /form-test /form-test/*
	}
	handle @n8n_hooks {
		reverse_proxy n8n-app:5678
	}

	@hooks_host host hooks.emecworks.com
	handle @hooks_host {
		respond "Not Found" 404
	}

	@portfolio_internal host emecworks-internal
	handle @portfolio_internal {
		reverse_proxy web:8080 {
			header_up Host emecworks.com
		}
	}

	@portfolio_private_paths {
		host emecworks.com
		path /internal/*
	}
	handle @portfolio_private_paths {
		respond "Not Found" 404
	}

	@portfolio host emecworks.com
	handle @portfolio {
		reverse_proxy web:8080
	}

	handle {
		respond "Unknown tunnel hostname" 404
	}

	log {
		output stdout
		format json
	}
}
