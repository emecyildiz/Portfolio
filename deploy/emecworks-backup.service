[Unit]
Description=Back up the Emecworks portfolio, n8n, and CTI data
Requires=docker.service
After=docker.service
ConditionPathExists=/etc/emecworks/portfolio.env
ConditionPathExists=/etc/emecworks/n8n-db.env
ConditionPathExists=/etc/emecworks/n8n-app.env
ConditionPathExists=/etc/emecworks/cti-db.env
ConditionPathIsDirectory=/var/lib/emecworks/n8n-files

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/emecworks-backup
Environment=BACKUP_RETENTION_DAYS=7
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/emecworks/portfolio.env /etc/emecworks/n8n-db.env /etc/emecworks/n8n-app.env /etc/emecworks/cti-db.env /var/lib/emecworks/n8n-files
ReadWritePaths=/var/backups/emecworks /run/lock
TimeoutStartSec=30min
