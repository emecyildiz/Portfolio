# Install as /etc/emecworks/n8n-app.env with owner root:root and mode 0600.
# The database password must match n8n-db.env. Never commit the real file.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=db
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_PASSWORD=REPLACE_WITH_THE_DATABASE_PASSWORD

# Keep this key stable. Changing or losing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_ENCRYPTION_KEY

NODE_ENV=production
N8N_HOST=n8n.emecworks.com
N8N_PORT=5678
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.emecworks.com/
N8N_WEBHOOK_URL=https://hooks.emecworks.com/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true

GENERIC_TIMEZONE=Europe/Istanbul
TZ=Europe/Istanbul

# Must match N8N_RUNNERS_AUTH_TOKEN in n8n-runners.env.
N8N_RUNNERS_MODE=external
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
N8N_RUNNERS_AUTH_TOKEN=REPLACE_WITH_A_RANDOM_RUNNER_AUTH_TOKEN
N8N_RUNNERS_MAX_CONCURRENCY=4
N8N_RUNNERS_TASK_TIMEOUT=300
N8N_RUNNERS_TASK_REQUEST_TIMEOUT=60

N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true
N8N_GIT_NODE_DISABLE_BARE_REPOS=true
N8N_RESTRICT_FILE_ACCESS_TO=/home/node/.n8n-files
N8N_UNVERIFIED_PACKAGES_ENABLED=false
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=268435456
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=1000

N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=true
N8N_PUBLIC_API_DISABLED=true
N8N_PUBLIC_API_SWAGGERUI_DISABLED=true

N8N_DEFAULT_BINARY_DATA_MODE=filesystem
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
