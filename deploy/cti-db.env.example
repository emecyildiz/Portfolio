# Install as /etc/emecworks/cti-db.env with owner root:root and mode 0600.
# Generate two different random passwords. Never commit the real file.
POSTGRES_DB=cti
POSTGRES_USER=cti_owner
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_OWNER_PASSWORD
CTI_APP_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_N8N_PASSWORD
