# Install as /etc/emecworks/n8n-runners.env with owner root:root and mode 0600.
# Never commit the real file.

N8N_RUNNERS_TASK_BROKER_URI=http://n8n:5679
# Must match N8N_RUNNERS_AUTH_TOKEN in n8n-app.env.
N8N_RUNNERS_AUTH_TOKEN=REPLACE_WITH_A_RANDOM_RUNNER_AUTH_TOKEN
N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT=15
N8N_RUNNERS_MAX_CONCURRENCY=4
N8N_RUNNERS_LAUNCHER_LOG_LEVEL=info

GENERIC_TIMEZONE=Europe/Istanbul
TZ=Europe/Istanbul
