# Install as /etc/emecworks/cti-dashboard.env with owner root:root and mode 0600.
# Use the password assigned to the dedicated read-only cti_dashboard role.
CTI_DASHBOARD_PASSWORD=REPLACE_WITH_A_RANDOM_READ_ONLY_PASSWORD
# Must exactly match the single email allowed by the Cloudflare Access policy.
CTI_ACCESS_EMAIL=REPLACE_WITH_THE_AUTHORIZED_EMAIL
