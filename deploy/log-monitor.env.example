# Install as /etc/emecworks/log-monitor.env with owner root:root and mode 0600.
# Use the production URL generated by the n8n Webhook node.
N8N_LOG_WEBHOOK_URL=https://hooks.emecworks.com/webhook/portfolio-log-alert
# Generate with: openssl rand -hex 32
N8N_LOG_WEBHOOK_TOKEN=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
