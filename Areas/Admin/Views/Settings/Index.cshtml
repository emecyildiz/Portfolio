@model Portfolio.Models.SiteSettings
@{
    ViewData["Title"] = "Settings";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Site configuration</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Settings</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Manage public footer destinations and the downloadable CV asset.</p>
    </div>
    @if (Model.Id > 0)
    {
        <span class="w-fit border border-line bg-panel px-3 py-2 font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">Updated @Model.UpdatedAt.ToString("dd MMM yyyy HH:mm")</span>
    }
</div>

<div class="grid max-w-7xl gap-6 xl:grid-cols-[minmax(0,1.4fr)_minmax(20rem,.6fr)]">
    <section class="admin-surface p-5 sm:p-6" aria-labelledby="footer-links-heading">
        <div class="flex flex-col gap-4 border-b border-line pb-5 sm:flex-row sm:items-start sm:justify-between">
            <div>
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Public navigation</p>
                <h3 id="footer-links-heading" class="mt-2 text-lg font-semibold text-white">Footer links</h3>
                <p class="mt-2 max-w-xl text-sm leading-6 text-slate-500">Add trusted website, profile or email destinations and control their display order.</p>
            </div>
            <button type="button" id="addFooterLinkButton" class="focus-ring inline-flex w-fit shrink-0 items-center gap-2 border border-cyan/20 px-3 py-2 text-xs text-cyan transition hover:bg-cyan/10">
                <span aria-hidden="true">+</span>
                Add link
            </button>
        </div>

        <form method="post" action="@Url.Action("SaveFooterLinks", "Settings", new { area = "Admin" })" id="footerLinksForm" class="mt-5">
            @Html.AntiForgeryToken()
            <input type="hidden" name="footerLinksJson" id="footerLinksJson" />

            <div id="footer-links-container" class="space-y-3"></div>
            <div id="footer-links-empty" class="hidden border border-dashed border-line bg-ink/40 px-5 py-10 text-center">
                <p class="font-mono text-xs uppercase tracking-[0.14em] text-slate-500">No footer links</p>
                <p class="mt-2 text-sm text-slate-600">The public footer will omit the external link list.</p>
            </div>

            <div class="mt-5 flex justify-end border-t border-line pt-5">
                <button type="submit" class="focus-ring bg-signal px-6 py-2.5 text-sm font-semibold text-ink transition hover:bg-white">Save footer links</button>
            </div>
        </form>
    </section>

    <aside class="admin-surface h-fit p-5 sm:p-6" aria-labelledby="cv-heading">
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Public document</p>
        <h3 id="cv-heading" class="mt-2 text-lg font-semibold text-white">CV / Resume</h3>
        <p class="mt-2 text-sm leading-6 text-slate-500">Upload the PDF visitors can download from the portfolio.</p>

        @if (!string.IsNullOrWhiteSpace(Model.CvFileUrl))
        {
            <div class="mt-5 flex items-center justify-between gap-4 border border-signal/15 bg-signal/[0.04] p-4">
                <div>
                    <p class="font-mono text-[10px] uppercase tracking-[0.13em] text-signal">Current file</p>
                    <p class="mt-1 text-xs text-slate-500">A CV is available publicly.</p>
                </div>
                <a href="@Model.CvFileUrl" target="_blank" rel="noopener noreferrer" class="focus-ring border border-line px-3 py-1.5 text-xs text-slate-300 transition hover:border-slate-500 hover:text-white">View</a>
            </div>
        }

        <form method="post" action="@Url.Action("UploadCv", "Settings", new { area = "Admin" })" enctype="multipart/form-data" class="mt-5">
            @Html.AntiForgeryToken()
            <label for="cvFile" class="admin-label">PDF file</label>
            <input type="file"
                   id="cvFile"
                   name="cvFile"
                   accept="application/pdf,.pdf"
                   required
                   aria-describedby="cv-file-help"
                   class="focus-ring w-full border border-line bg-ink p-3 text-sm text-slate-400 file:mr-3 file:border-0 file:bg-raised file:px-3 file:py-2 file:text-xs file:font-medium file:text-slate-300 hover:file:bg-line" />
            <p id="cv-file-help" class="admin-hint">PDF only, maximum 10 MB. The server verifies the extension, MIME type and PDF contents. A new upload replaces the existing file.</p>
            <button type="submit" class="focus-ring mt-5 w-full bg-signal px-6 py-2.5 text-sm font-semibold text-ink transition hover:bg-white">Upload CV</button>
        </form>
    </aside>
</div>

@section Scripts {
    <script>
        let footerLinks = @Html.Raw(ViewBag.FooterLinksJson ?? "[]");

        const footerLinksContainer = document.getElementById('footer-links-container');
        const footerLinksEmpty = document.getElementById('footer-links-empty');
        const footerLinkEscapeMap = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };

        function escapeFooterLinkHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, character => footerLinkEscapeMap[character]);
        }

        function addFooterLink() {
            footerLinks.push({ label: '', url: '', openInNewTab: true });
            renderFooterLinks();
        }

        function removeFooterLink(index) {
            footerLinks.splice(index, 1);
            renderFooterLinks();
        }

        function moveFooterLink(index, direction) {
            const targetIndex = index + direction;
            if (targetIndex < 0 || targetIndex >= footerLinks.length) return;

            [footerLinks[index], footerLinks[targetIndex]] = [footerLinks[targetIndex], footerLinks[index]];
            renderFooterLinks();
        }

        function renderFooterLinks() {
            footerLinksEmpty.classList.toggle('hidden', footerLinks.length > 0);
            footerLinksContainer.innerHTML = footerLinks.map((link, index) => {
                const isFirst = index === 0;
                const isLast = index === footerLinks.length - 1;
                return `
                    <fieldset class="border border-line bg-ink/45 p-4">
                        <legend class="px-2 font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">Link ${index + 1}</legend>
                        <div class="grid gap-4 lg:grid-cols-[minmax(9rem,.65fr)_minmax(15rem,1.35fr)]">
                            <div>
                                <label for="footer-link-label-${index}" class="admin-label">Label</label>
                                <input id="footer-link-label-${index}"
                                       type="text"
                                       value="${escapeFooterLinkHtml(link.label)}"
                                       data-index="${index}"
                                       data-field="label"
                                       maxlength="60"
                                       autocomplete="off"
                                       placeholder="GitHub"
                                       class="admin-input" />
                            </div>
                            <div>
                                <label for="footer-link-url-${index}" class="admin-label">Address</label>
                                <input id="footer-link-url-${index}"
                                       type="text"
                                       value="${escapeFooterLinkHtml(link.url)}"
                                       data-index="${index}"
                                       data-field="url"
                                       maxlength="2000"
                                       autocomplete="off"
                                       inputmode="url"
                                       placeholder="https://... or mailto:..."
                                       class="admin-input font-mono" />
                            </div>
                        </div>
                        <div class="mt-4 flex flex-col gap-3 border-t border-line pt-4 sm:flex-row sm:items-center sm:justify-between">
                            <label class="flex cursor-pointer items-center gap-3 text-xs text-slate-400">
                                <input type="checkbox"
                                       ${link.openInNewTab ? 'checked' : ''}
                                       data-index="${index}"
                                       data-field="openInNewTab"
                                       class="admin-checkbox" />
                                Open in a new tab
                            </label>
                            <div class="flex flex-wrap items-center gap-2">
                                <button type="button" data-action="move-up" data-index="${index}" ${isFirst ? 'disabled' : ''} class="focus-ring border border-line px-2.5 py-1.5 text-[10px] text-slate-500 transition hover:text-white disabled:cursor-not-allowed disabled:opacity-30">Move up</button>
                                <button type="button" data-action="move-down" data-index="${index}" ${isLast ? 'disabled' : ''} class="focus-ring border border-line px-2.5 py-1.5 text-[10px] text-slate-500 transition hover:text-white disabled:cursor-not-allowed disabled:opacity-30">Move down</button>
                                <button type="button" data-action="remove" data-index="${index}" class="focus-ring border border-rose-300/20 px-2.5 py-1.5 text-[10px] text-rose-300 transition hover:bg-rose-300/10">Remove</button>
                            </div>
                        </div>
                    </fieldset>`;
            }).join('');
        }

        document.getElementById('addFooterLinkButton').addEventListener('click', addFooterLink);

        footerLinksContainer.addEventListener('input', event => {
            const field = event.target.dataset.field;
            const index = Number(event.target.dataset.index);
            if ((field === 'label' || field === 'url') && Number.isInteger(index) && footerLinks[index]) {
                footerLinks[index][field] = event.target.value;
            }
        });

        footerLinksContainer.addEventListener('change', event => {
            if (event.target.dataset.field !== 'openInNewTab') return;
            const index = Number(event.target.dataset.index);
            if (Number.isInteger(index) && footerLinks[index]) footerLinks[index].openInNewTab = event.target.checked;
        });

        footerLinksContainer.addEventListener('click', event => {
            const button = event.target.closest('button[data-action]');
            if (!button) return;
            const index = Number(button.dataset.index);
            if (!Number.isInteger(index)) return;

            if (button.dataset.action === 'move-up') moveFooterLink(index, -1);
            if (button.dataset.action === 'move-down') moveFooterLink(index, 1);
            if (button.dataset.action === 'remove') removeFooterLink(index);
        });

        document.getElementById('footerLinksForm').addEventListener('submit', () => {
            document.getElementById('footerLinksJson').value = JSON.stringify(footerLinks);
        });

        renderFooterLinks();
    </script>
}
