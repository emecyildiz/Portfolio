@model List<Portfolio.Models.SecurityResearch>
@{
    ViewData["Title"] = "Güvenlik Araştırmaları";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex items-center justify-between mb-8">
    <div>
        <h2 class="text-2xl font-bold text-white">Güvenlik Araştırmaları</h2>
        <p class="text-gray-500 mt-1">Malware, donanım açıkları, RF güvenliği</p>
    </div>
    <a href="@Url.Action("Create", "Security", new { area = "Admin" })"
       class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
        + Yeni Araştırma
    </a>
</div>

<div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="border-b border-gray-800">
                <th class="text-left px-6 py-3 text-gray-400 font-medium">Başlık</th>
                <th class="text-left px-6 py-3 text-gray-400 font-medium">Tür</th>
                <th class="text-left px-6 py-3 text-gray-400 font-medium">Açıklama Durumu</th>
                <th class="text-left px-6 py-3 text-gray-400 font-medium">Yayın</th>
                <th class="text-right px-6 py-3 text-gray-400 font-medium">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr class="border-b border-gray-800/50 hover:bg-gray-800/30 transition">
                    <td class="px-6 py-4">
                        <p class="text-white font-medium">@r.Title</p>
                        @if (!string.IsNullOrEmpty(r.CveId))
                        {
                            <p class="text-red-400 text-xs mt-0.5 font-mono">@r.CveId</p>
                        }
                    </td>
                    <td class="px-6 py-4">
                        <span class="text-gray-400 text-xs">@r.ResearchType</span>
                    </td>
                    <td class="px-6 py-4">
                        @{
                            var disclosureClass = r.DisclosureStatus switch
                            {
                                Portfolio.Models.Enums.DisclosureStatus.Private => "bg-gray-800 text-gray-500",
                                Portfolio.Models.Enums.DisclosureStatus.Coordinated => "bg-amber-900/40 text-amber-400",
                                Portfolio.Models.Enums.DisclosureStatus.PubliclyDisclosed => "bg-green-900/40 text-green-400",
                                _ => "bg-gray-800 text-gray-500"
                            };
                        }
                        <span class="text-xs px-2 py-1 rounded-full @disclosureClass">@r.DisclosureStatus</span>
                    </td>
                    <td class="px-6 py-4">
                        @if (r.Status == Portfolio.Models.Enums.VisibilityStatus.Public)
                        {
                            <span class="bg-green-900/40 text-green-400 text-xs px-2 py-1 rounded-full">Yayında</span>
                        }
                        else
                        {
                            <span class="bg-gray-800 text-gray-500 text-xs px-2 py-1 rounded-full">Taslak</span>
                        }
                </td>
                <td class="px-6 py-4">
                    <div class="flex items-center justify-end gap-2">
                            @if (r.Status == Portfolio.Models.Enums.VisibilityStatus.Public &&
                                                    r.DisclosureStatus == Portfolio.Models.Enums.DisclosureStatus.PubliclyDisclosed)
                            {
                                <a href="/security/@r.Slug" target="_blank"
                                   class="text-xs px-3 py-1.5 rounded-lg border border-gray-700 text-gray-400 hover:bg-gray-800 transition">
                                    👁 Önizle
                                </a>
                            }
                        <form method="post" action="@Url.Action("Toggle", "Security", new { area = "Admin", id = r.Id })">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="text-xs px-3 py-1.5 rounded-lg border transition
                                        @(r.Status == Portfolio.Models.Enums.VisibilityStatus.Public
                                                                                ? "border-green-800 text-green-400 hover:bg-green-900/30"
                                                                                : "border-gray-700 text-gray-400 hover:bg-gray-800")">
                                @(r.Status == Portfolio.Models.Enums.VisibilityStatus.Public ? "Gizle" : "Yayınla")
                            </button>
                        </form>
                        <a href="@Url.Action("Edit", "Security", new { area = "Admin", id = r.Id })"
                           class="text-xs px-3 py-1.5 rounded-lg border border-gray-700 text-gray-400 hover:bg-gray-800 transition">
                            Düzenle
                        </a>
                        <form method="post"
                              action="@Url.Action("Delete", "Security", new { area = "Admin", id = r.Id })"
                              onsubmit="return confirm('Bu araştırmayı silmek istediğine emin misin?')">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="text-xs px-3 py-1.5 rounded-lg border border-red-900 text-red-400 hover:bg-red-900/30 transition">
                                Sil
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
                        }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="text-center py-16 text-gray-600">
            Henüz güvenlik araştırması yok.
        </div>
    }
</div>