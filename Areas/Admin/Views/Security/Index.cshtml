@model List<Portfolio.Models.SecurityResearch>
@{
    ViewData["Title"] = "Security Research";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Research archive</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Security research</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Manage malware analysis, vulnerability research and responsible disclosure records.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
        <span class="border border-line bg-panel px-3 py-2 font-mono text-[10px] uppercase tracking-[0.15em] text-slate-500">@Model.Count entries</span>
        <a href="@Url.Action("Create", "Security", new { area = "Admin" })"
           class="focus-ring inline-flex items-center gap-2 bg-signal px-4 py-2.5 text-sm font-semibold text-ink transition hover:bg-white">
            <span aria-hidden="true">+</span>
            New research entry
        </a>
    </div>
</div>

<section class="admin-surface overflow-hidden" aria-labelledby="security-table-heading">
    <h3 id="security-table-heading" class="sr-only">Security research records</h3>
    @if (Model.Any())
    {
        <div class="overflow-x-auto">
            <table class="w-full min-w-[1000px] text-left text-sm">
                <thead class="border-b border-line bg-ink/55">
                    <tr>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Research</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Type</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Disclosure</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Publication</th>
                        <th scope="col" class="px-5 py-3.5 text-right font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                    @foreach (var research in Model)
                    {
                        var isPublic = research.Status == Portfolio.Models.Enums.VisibilityStatus.Public;
                        var isDisclosed = research.DisclosureStatus == Portfolio.Models.Enums.DisclosureStatus.PubliclyDisclosed;
                        var disclosureClass = research.DisclosureStatus switch
                        {
                            Portfolio.Models.Enums.DisclosureStatus.Private => "border-line text-slate-500",
                            Portfolio.Models.Enums.DisclosureStatus.Coordinated => "border-amber-300/20 bg-amber-300/[0.06] text-amber-200",
                            Portfolio.Models.Enums.DisclosureStatus.PubliclyDisclosed => "border-signal/20 bg-signal/[0.05] text-signal",
                            _ => "border-line text-slate-500"
                        };
                        var disclosureLabel = research.DisclosureStatus switch
                        {
                            Portfolio.Models.Enums.DisclosureStatus.PubliclyDisclosed => "Publicly disclosed",
                            _ => research.DisclosureStatus.ToString()
                        };
                        <tr class="transition hover:bg-white/[0.025]">
                            <td class="px-5 py-4">
                                <p class="max-w-md font-medium text-white">@research.Title</p>
                                @if (!string.IsNullOrWhiteSpace(research.CveId))
                                {
                                    <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.08em] text-rose-300">@research.CveId</p>
                                }
                                else
                                {
                                    <p class="mt-1 font-mono text-[11px] text-slate-600">/@research.Slug</p>
                                }
                            </td>
                            <td class="px-5 py-4 text-xs text-slate-400">@research.ResearchType</td>
                            <td class="px-5 py-4">
                                <span class="inline-flex border px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.1em] @disclosureClass">@disclosureLabel</span>
                            </td>
                            <td class="px-5 py-4">
                                <span class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.13em] @(isPublic ? "text-signal" : "text-slate-500")">
                                    <span class="h-1.5 w-1.5 rounded-full @(isPublic ? "bg-signal" : "bg-slate-600")" aria-hidden="true"></span>
                                    @(isPublic ? "Public" : "Draft")
                                </span>
                            </td>
                            <td class="px-5 py-4">
                                <div class="flex flex-wrap items-center justify-end gap-2">
                                    @if (isPublic && isDisclosed)
                                    {
                                        <a href="/security/@research.Slug" target="_blank" rel="noopener noreferrer"
                                           class="focus-ring border border-cyan/20 px-3 py-1.5 text-xs text-cyan transition hover:bg-cyan/10">Preview</a>
                                    }
                                    <form method="post" action="@Url.Action("Toggle", "Security", new { area = "Admin", id = research.Id })">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="focus-ring border px-3 py-1.5 text-xs transition @(isPublic ? "border-signal/25 text-signal hover:bg-signal/10" : "border-line text-slate-400 hover:border-slate-500 hover:text-white")">
                                            @(isPublic ? "Hide" : "Publish")
                                        </button>
                                    </form>
                                    <a href="@Url.Action("Edit", "Security", new { area = "Admin", id = research.Id })"
                                       class="focus-ring border border-line px-3 py-1.5 text-xs text-slate-400 transition hover:border-slate-500 hover:text-white">Edit</a>
                                    <form method="post"
                                          action="@Url.Action("Delete", "Security", new { area = "Admin", id = research.Id })"
                                          onsubmit="return confirm('Delete this research entry? This action cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="focus-ring border border-rose-300/20 px-3 py-1.5 text-xs text-rose-300 transition hover:bg-rose-300/10">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-16 text-center">
            <p class="font-mono text-xs uppercase tracking-[0.16em] text-slate-500">No research entries yet</p>
            <p class="mt-2 text-sm text-slate-600">New security research will appear in this archive.</p>
        </div>
    }
</section>
