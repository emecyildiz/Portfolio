@model Portfolio.Models.SecurityResearch
@{
    ViewData["Title"] = "Edit Security Research";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var toolsString = ViewBag.ToolsString as string ?? "";
    var images = ViewBag.Images as List<Portfolio.Models.Media> ?? new List<Portfolio.Models.Media>();
}

<div class="mb-8">
    <h2 class="text-2xl font-bold text-white">Edit Security Research</h2>
    <p class="text-gray-500 mt-1">/@Model.Slug</p>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css">
<script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />

    <div class="grid grid-cols-3 gap-6">
        <div class="col-span-2 space-y-4">
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4">
                <h3 class="text-sm font-medium text-gray-400">Content</h3>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Title</label>
                    <input asp-for="Title"
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500" />
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Summary</label>
                    <textarea asp-for="Summary" rows="2"
                              class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500"></textarea>
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Content (Markdown)</label>
                    <textarea asp-for="Content" id="content-editor"></textarea>
                </div>
            </div>

            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4">
                <h3 class="text-sm font-medium text-gray-400">Research Details</h3>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm text-gray-400 mb-1">Research Type</label>
                        <select asp-for="ResearchType"
                                asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.ResearchType>()"
                                class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500">
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm text-gray-400 mb-1">Target Category</label>
                        <input asp-for="TargetCategory"
                               class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm text-gray-400 mb-1">CVE ID</label>
                        <input asp-for="CveId"
                               class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm font-mono focus:outline-none focus:border-blue-500" />
                    </div>
                    <div>
                        <label class="block text-sm text-gray-400 mb-1">Severity</label>
                        <select asp-for="SeverityLevel"
                                class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500">
                            <option value="">Select</option>
                            <option value="critical">Critical</option>
                            <option value="high">High</option>
                            <option value="medium">Medium</option>
                            <option value="low">Low</option>
                            <option value="info">Info</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Tools Used</label>
                    <input name="ToolsUsed" value="@toolsString"
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500" />
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Disclosure Status</label>
                    <select asp-for="DisclosureStatus"
                            asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.DisclosureStatus>()"
                            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500">
                    </select>
                </div>
            </div>

            @if (images.Any())
            {
                <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
                    <h3 class="text-sm font-medium text-gray-400 mb-4">Existing Images</h3>
                    <div class="grid grid-cols-3 gap-3">
                        @foreach (var img in images)
                        {
                            <div class="relative group">
                                <img src="@img.Url" alt="@img.AltText"
                                     class="w-full h-32 object-cover rounded-lg @(img.IsCover ? "ring-2 ring-blue-500" : "")" />
                                @if (img.IsCover)
                                {
                                    <span class="absolute top-1 left-1 bg-blue-600 text-white text-xs px-1.5 py-0.5 rounded">Cover</span>
                                }
                                <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition rounded-lg flex items-center justify-center gap-2">
                                    <form method="post" action="@Url.Action("SetCover", "Security", new { area = "Admin" })">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="mediaId" value="@img.Id" />
                                        <input type="hidden" name="researchId" value="@Model.Id" />
                                        <button type="submit" class="text-xs bg-blue-600 text-white px-2 py-1 rounded">Set Cover</button>
                                    </form>
                                    <form method="post" action="@Url.Action("DeleteImage", "Security", new { area = "Admin" })">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="mediaId" value="@img.Id" />
                                        <input type="hidden" name="researchId" value="@Model.Id" />
                                        <button type="submit" class="text-xs bg-red-600 text-white px-2 py-1 rounded">Delete</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
                <h3 class="text-sm font-medium text-gray-400 mb-4">Add New Images</h3>
                <input name="Images" type="file" multiple accept="image/*"
                       class="w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-gray-800 file:text-gray-300 hover:file:bg-gray-700" />
            </div>
        </div>

        <div class="space-y-4">
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4">
                <h3 class="text-sm font-medium text-gray-400">Settings</h3>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Status</label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.VisibilityStatus>()"
                            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500">
                    </select>
                </div>

                <label class="flex items-center gap-2 text-sm text-gray-400 cursor-pointer">
                    <input asp-for="IsFeatured" type="checkbox" class="w-4 h-4 rounded" />
                    Feature on the homepage
                </label>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">GitHub / PoC</label>
                    <input asp-for="GithubUrl"
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500" />
                </div>

                <div class="bg-red-900/20 border border-red-900/50 rounded-lg p-3">
                    <p class="text-xs text-red-400">
                        ⚠ Public visibility requires both Status=Public and DisclosureStatus=PubliclyDisclosed.
                    </p>
                </div>

                <div class="pt-2 border-t border-gray-800 text-xs text-gray-600 space-y-1">
                    <p>Created: @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                    <p>Views: @Model.ViewCount</p>
                    <p>Reading time: @Model.ReadingTimeMinutes min</p>
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <button type="submit"
                        class="w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2.5 rounded-lg transition">
                    Update
                </button>
                <a href="@Url.Action("Index", "Security", new { area = "Admin" })"
                   class="w-full text-center border border-gray-700 text-gray-400 hover:bg-gray-800 text-sm py-2.5 rounded-lg transition">
                    Cancel
                </a>
            </div>
        </div>
    </div>
</form>

<script>
    new EasyMDE({
        element: document.getElementById('content-editor'),
        spellChecker: false,
        toolbar: ['bold', 'italic', 'heading', '|', 'quote', 'unordered-list', 'ordered-list', '|', 'link', 'image', '|', 'preview', 'side-by-side', 'fullscreen']
    });
</script>
