@model Portfolio.Models.SecurityResearch
@{
    ViewData["Title"] = "New Security Research";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/vendor/easymde/easymde.min.css" asp-append-version="true" />
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-rose-300">Research archive</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">New security research</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Document defensive research, reverse engineering and responsibly disclosed findings.</p>
    </div>
    <a href="@Url.Action("Index", "Security", new { area = "Admin" })" class="focus-ring w-fit border border-line px-4 py-2.5 text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Back to security</a>
</div>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly"></div>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_21rem]">
        <div class="space-y-6">
            <section class="admin-surface p-5 sm:p-6" aria-labelledby="security-content-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Research narrative</p>
                <h3 id="security-content-heading" class="mt-2 text-lg font-semibold text-white">Title, summary and write-up</h3>
                <div class="mt-6 space-y-5">
                    <div>
                        <label asp-for="Title" class="admin-label">Title</label>
                        <input asp-for="Title" class="admin-input" autocomplete="off" />
                        <p class="admin-hint">The public slug is generated from this title.</p>
                        <span asp-validation-for="Title"></span>
                    </div>
                    <div>
                        <label asp-for="Summary" class="admin-label">Summary</label>
                        <textarea asp-for="Summary" rows="3" class="admin-textarea" placeholder="A concise, non-sensitive description of the research."></textarea>
                        <span asp-validation-for="Summary"></span>
                    </div>
                    <div>
                        <label asp-for="Content" class="admin-label">Content <span class="font-normal text-slate-600">(Markdown)</span></label>
                        <textarea asp-for="Content" id="content-editor"></textarea>
                        <p class="admin-hint">Local draft recovery is enabled in this browser while creating the research entry.</p>
                        <span asp-validation-for="Content"></span>
                    </div>
                </div>
            </section>

            <section class="admin-surface p-5 sm:p-6" aria-labelledby="security-details-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Classification</p>
                <h3 id="security-details-heading" class="mt-2 text-lg font-semibold text-white">Research details</h3>
                <div class="mt-6 grid gap-5 sm:grid-cols-2">
                    <div>
                        <label asp-for="ResearchType" class="admin-label">Research type</label>
                        <select asp-for="ResearchType" asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.ResearchType>()" class="admin-select"></select>
                        <span asp-validation-for="ResearchType"></span>
                    </div>
                    <div>
                        <label asp-for="TargetCategory" class="admin-label">Target category <span class="font-normal text-slate-600">(optional)</span></label>
                        <input asp-for="TargetCategory" class="admin-input" autocomplete="off" placeholder="Automotive, IoT, mobile..." />
                        <span asp-validation-for="TargetCategory"></span>
                    </div>
                    <div>
                        <label asp-for="CveId" class="admin-label">CVE ID <span class="font-normal text-slate-600">(optional)</span></label>
                        <input asp-for="CveId" class="admin-input font-mono" autocomplete="off" placeholder="CVE-2026-XXXXX" />
                        <span asp-validation-for="CveId"></span>
                    </div>
                    <div>
                        <label asp-for="SeverityLevel" class="admin-label">Severity</label>
                        <select asp-for="SeverityLevel" class="admin-select">
                            <option value="">Not assigned</option>
                            <option value="critical">Critical</option>
                            <option value="high">High</option>
                            <option value="medium">Medium</option>
                            <option value="low">Low</option>
                            <option value="info">Informational</option>
                        </select>
                        <span asp-validation-for="SeverityLevel"></span>
                    </div>
                    <div class="sm:col-span-2">
                        <label for="ToolsUsed" class="admin-label">Tools used <span class="font-normal text-slate-600">(optional)</span></label>
                        <input name="ToolsUsed" id="ToolsUsed" class="admin-input" autocomplete="off" placeholder="Ghidra, Wireshark, HackRF" aria-describedby="security-tools-help" />
                        <p id="security-tools-help" class="admin-hint">Separate tool names with commas.</p>
                    </div>
                    <div class="sm:col-span-2">
                        <label asp-for="DisclosureStatus" class="admin-label">Disclosure status</label>
                        <select asp-for="DisclosureStatus" asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.DisclosureStatus>()" class="admin-select"></select>
                        <span asp-validation-for="DisclosureStatus"></span>
                    </div>
                </div>
            </section>

            <section class="admin-surface p-5 sm:p-6" aria-labelledby="security-media-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Evidence media</p>
                <h3 id="security-media-heading" class="mt-2 text-lg font-semibold text-white">Add images</h3>
                <label for="securityImages" class="admin-label mt-5">Image files <span class="font-normal text-slate-600">(optional)</span></label>
                <input name="Images" id="securityImages" type="file" multiple accept="image/jpeg,image/png,image/webp,image/gif" aria-describedby="security-images-help" class="focus-ring w-full border border-line bg-ink p-3 text-sm text-slate-400 file:mr-3 file:border-0 file:bg-raised file:px-3 file:py-2 file:text-xs file:font-medium file:text-slate-300 hover:file:bg-line" />
                <p id="security-images-help" class="admin-hint">JPEG, PNG, WebP or GIF; maximum 10 MB per file. The first image becomes the cover.</p>
            </section>
        </div>

        <aside class="h-fit space-y-4 xl:sticky xl:top-6" aria-labelledby="security-settings-heading">
            <section class="admin-surface p-5 sm:p-6">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Publishing</p>
                <h3 id="security-settings-heading" class="mt-2 text-lg font-semibold text-white">Research settings</h3>
                <div class="mt-6 space-y-5">
                    <div>
                        <label asp-for="Status" class="admin-label">Visibility</label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.VisibilityStatus>()" class="admin-select"></select>
                        <span asp-validation-for="Status"></span>
                    </div>
                    <label class="flex cursor-pointer items-start gap-3 border border-line bg-ink/50 p-4">
                        <input asp-for="IsFeatured" type="checkbox" class="admin-checkbox mt-0.5 shrink-0" />
                        <span><span class="block text-sm font-medium text-slate-300">Feature on homepage</span><span class="mt-1 block text-xs leading-5 text-slate-600">Give this research additional visibility after disclosure.</span></span>
                    </label>
                    <div>
                        <label asp-for="GithubUrl" class="admin-label">GitHub / PoC URL <span class="font-normal text-slate-600">(optional)</span></label>
                        <input asp-for="GithubUrl" type="url" class="admin-input" inputmode="url" autocomplete="url" pattern="https://.+" title="Use an HTTPS URL." placeholder="https://github.com/..." />
                        <span asp-validation-for="GithubUrl"></span>
                    </div>
                    <div class="border border-rose-300/20 bg-rose-300/[0.05] p-4 text-xs leading-5 text-rose-200">
                        Public visibility requires both a Public status and a Publicly Disclosed disclosure status. Review the write-up for sensitive data before publishing.
                    </div>
                </div>
            </section>
            <div class="flex flex-col gap-2">
                <button type="submit" class="focus-ring w-full bg-signal px-6 py-3 text-sm font-semibold text-ink transition hover:bg-white">Create research</button>
                <a href="@Url.Action("Index", "Security", new { area = "Admin" })" class="focus-ring w-full border border-line px-5 py-3 text-center text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Cancel</a>
            </div>
        </aside>
    </div>
</form>

@section Scripts {
    <script src="~/vendor/easymde/easymde.min.js" asp-append-version="true"></script>
    <script>
        new EasyMDE({
            element: document.getElementById('content-editor'),
            spellChecker: false,
            autosave: { enabled: true, uniqueId: 'security-create' },
            toolbar: window.portfolioMarkdownToolbar
        });
    </script>
}
