@model List<Portfolio.Models.Service>
@{
    ViewData["Title"] = "Services";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Hire configuration</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Services</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Manage the capabilities and engagement options displayed on the Hire page.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
        <span class="border border-line bg-panel px-3 py-2 font-mono text-[10px] uppercase tracking-[0.15em] text-slate-500">@Model.Count services</span>
        <a href="@Url.Action("Create", "Service", new { area = "Admin" })" class="focus-ring inline-flex items-center gap-2 bg-signal px-4 py-2.5 text-sm font-semibold text-ink transition hover:bg-white">
            <span aria-hidden="true">+</span>
            New service
        </a>
    </div>
</div>

<section class="admin-surface overflow-hidden" aria-labelledby="services-table-heading">
    <h3 id="services-table-heading" class="sr-only">Service records</h3>
    @if (Model.Any())
    {
        <div class="overflow-x-auto">
            <table class="w-full min-w-[760px] text-left text-sm">
                <thead class="border-b border-line bg-ink/55">
                    <tr>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Order</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Service</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Visibility</th>
                        <th scope="col" class="px-5 py-3.5 text-right font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                    @foreach (var service in Model)
                    {
                        var isPublic = service.Status == Portfolio.Models.Enums.VisibilityStatus.Public;
                        <tr class="transition hover:bg-white/[0.025]">
                            <td class="px-5 py-4 font-mono text-xs text-slate-500">@service.SortOrder.ToString("00")</td>
                            <td class="px-5 py-4">
                                <p class="font-medium text-white">@service.Title</p>
                                <p class="mt-1 max-w-2xl line-clamp-2 text-xs leading-5 text-slate-500">@service.Description</p>
                            </td>
                            <td class="px-5 py-4">
                                <span class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.13em] @(isPublic ? "text-signal" : "text-slate-500")">
                                    <span class="h-1.5 w-1.5 rounded-full @(isPublic ? "bg-signal" : "bg-slate-600")" aria-hidden="true"></span>
                                    @(isPublic ? "Public" : "Hidden")
                                </span>
                            </td>
                            <td class="px-5 py-4">
                                <div class="flex flex-wrap items-center justify-end gap-2">
                                    <a href="@Url.Action("Edit", "Service", new { area = "Admin", id = service.Id })" class="focus-ring border border-line px-3 py-1.5 text-xs text-slate-400 transition hover:border-slate-500 hover:text-white">Edit</a>
                                    <form method="post" action="@Url.Action("Delete", "Service", new { area = "Admin", id = service.Id })" onsubmit="return confirm('Delete this service? This action cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="focus-ring border border-rose-300/20 px-3 py-1.5 text-xs text-rose-300 transition hover:bg-rose-300/10">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-16 text-center">
            <p class="font-mono text-xs uppercase tracking-[0.16em] text-slate-500">No services yet</p>
            <p class="mt-2 text-sm text-slate-600">Create a service before accepting related project requests.</p>
        </div>
    }
</section>
