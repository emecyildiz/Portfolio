@model Portfolio.Models.Service
@{
    ViewData["Title"] = "Edit Service";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Hire configuration</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Edit service</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Update the public service description and request visibility.</p>
    </div>
    <a href="@Url.Action("Index", "Service", new { area = "Admin" })" class="focus-ring w-fit border border-line px-4 py-2.5 text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Back to services</a>
</div>

<form method="post" class="max-w-5xl">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly"></div>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(18rem,.7fr)]">
        <section class="admin-surface p-5 sm:p-6" aria-labelledby="service-content-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Public copy</p>
            <h3 id="service-content-heading" class="mt-2 text-lg font-semibold text-white">Service information</h3>

            <div class="mt-6 space-y-5">
                <div>
                    <label asp-for="Title" class="admin-label">Title</label>
                    <input asp-for="Title" class="admin-input" autocomplete="off" />
                    <span asp-validation-for="Title"></span>
                </div>

                <div>
                    <label asp-for="Description" class="admin-label">Description</label>
                    <textarea asp-for="Description" rows="8" class="admin-textarea" aria-describedby="service-description-help"></textarea>
                    <p id="service-description-help" class="admin-hint">This text appears on the public Hire page. Do not include internal pricing or private operating details.</p>
                    <span asp-validation-for="Description"></span>
                </div>
            </div>
        </section>

        <aside class="admin-surface h-fit p-5 sm:p-6" aria-labelledby="service-settings-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Configuration</p>
            <h3 id="service-settings-heading" class="mt-2 text-lg font-semibold text-white">Display settings</h3>

            <div class="mt-6 space-y-5">
                <div>
                    <label asp-for="IconClass" class="admin-label">Icon class</label>
                    <input asp-for="IconClass" class="admin-input font-mono" autocomplete="off" />
                    <span asp-validation-for="IconClass"></span>
                </div>

                <div>
                    <label asp-for="SortOrder" class="admin-label">Sort order</label>
                    <input asp-for="SortOrder" type="number" class="admin-input" inputmode="numeric" />
                    <span asp-validation-for="SortOrder"></span>
                </div>

                <div>
                    <label asp-for="Status" class="admin-label">Visibility</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.VisibilityStatus>()" class="admin-select"></select>
                    <p class="admin-hint">Only public services are shown to visitors.</p>
                    <span asp-validation-for="Status"></span>
                </div>

                <div class="border-t border-line pt-4 font-mono text-[10px] uppercase tracking-[0.1em] text-slate-700">
                    <p>Created @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                    <p class="mt-1">Updated @Model.UpdatedAt.ToString("dd MMM yyyy HH:mm")</p>
                </div>
            </div>
        </aside>
    </div>

    <div class="mt-6 flex flex-col-reverse gap-3 border-t border-line pt-5 sm:flex-row sm:justify-end">
        <a href="@Url.Action("Index", "Service", new { area = "Admin" })" class="focus-ring border border-line px-5 py-2.5 text-center text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Cancel</a>
        <button type="submit" class="focus-ring bg-signal px-6 py-2.5 text-sm font-semibold text-ink transition hover:bg-white">Save changes</button>
    </div>
</form>
