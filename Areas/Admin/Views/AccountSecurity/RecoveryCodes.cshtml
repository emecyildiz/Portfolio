@model Portfolio.Models.ViewModels.RecoveryCodesViewModel
@{
    ViewData["Title"] = "Recovery Codes";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-4xl">
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-amber-300">One-time display</p>
    <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Store your recovery codes now</h2>
    <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-400">These codes will not be shown again. Save them in a password manager or an encrypted offline location, separate from the authenticator device.</p>

    <section class="admin-surface mt-8 p-5 sm:p-7" aria-label="Recovery codes">
        <div class="grid gap-3 sm:grid-cols-2">
            @foreach (var code in Model.RecoveryCodes)
            {
                <code class="border border-line bg-ink px-4 py-3 text-center font-mono text-sm tracking-[0.08em] text-signal">@code</code>
            }
        </div>
    </section>

    <aside class="mt-6 border border-amber-300/20 bg-amber-300/[0.05] p-4 text-sm leading-6 text-amber-100/80">
        Leaving this page removes access to this list. Generating another set later invalidates every code shown here.
    </aside>

    <a asp-action="Index" class="focus-ring mt-6 inline-flex bg-signal px-6 py-2.5 text-sm font-semibold text-ink transition hover:bg-white">I stored the codes</a>
</div>
