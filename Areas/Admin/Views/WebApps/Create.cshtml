@model Portfolio.Models.Project
@{
    ViewData["Title"] = "New Web Application";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-8">
    <h2 class="text-2xl font-bold text-white">New Web Application</h2>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css">
<script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="grid grid-cols-3 gap-6">
        <div class="col-span-2 space-y-4">
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4">
                <h3 class="text-sm font-medium text-gray-400">Content</h3>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Title</label>
                    <input asp-for="Title"
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500" />
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Summary</label>
                    <textarea asp-for="Summary" rows="2"
                              class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500"></textarea>
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Content (Markdown)</label>
                    <textarea asp-for="Content" id="content-editor"></textarea>
                </div>
            </div>

            <!-- Web application-specific fields -->
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4">
                <h3 class="text-sm font-medium text-gray-400">Technical Details</h3>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Tech Stack</label>
                    <input name="TechStack"
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500"
                           placeholder="React, FastAPI, PostgreSQL (comma-separated)" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm text-gray-400 mb-1">Team Size</label>
                        <input name="TeamSize" type="number" min="1"
                               class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500"
                               placeholder="3" />
                    </div>
                    <div>
                        <label class="block text-sm text-gray-400 mb-1">My Role</label>
                        <input name="MyRole"
                               class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500"
                               placeholder="Backend Developer" />
                    </div>
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Subdomain</label>
                    <input name="Subdomain"
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500"
                           placeholder="muhasebe.siteadi.com" />
                </div>

                <label class="flex items-center gap-2 text-sm text-gray-400 cursor-pointer">
                    <input name="IsSchoolProject" type="checkbox" class="w-4 h-4 rounded" />
                    Academic project
                </label>
            </div>

            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
                <h3 class="text-sm font-medium text-gray-400 mb-4">Images</h3>
                <input name="Images" type="file" multiple accept="image/*"
                       class="w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-gray-800 file:text-gray-300 hover:file:bg-gray-700" />
            </div>
        </div>

        <div class="space-y-4">
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4">
                <h3 class="text-sm font-medium text-gray-400">Settings</h3>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Status</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.VisibilityStatus>()"
                            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500">
                    </select>
                </div>

                <label class="flex items-center gap-2 text-sm text-gray-400 cursor-pointer">
                    <input asp-for="IsFeatured" type="checkbox" class="w-4 h-4 rounded" />
                    Feature on the homepage
                </label>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">GitHub</label>
                    <input asp-for="GithubUrl"
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500"
                           placeholder="https://github.com/..." />
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Live Demo</label>
                    <input asp-for="LiveDemoUrl"
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500"
                           placeholder="https://..." />
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <button type="submit"
                        class="w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2.5 rounded-lg transition">
                    Save
                </button>
                <a href="@Url.Action("Index", "WebApps", new { area = "Admin" })"
                   class="w-full text-center border border-gray-700 text-gray-400 hover:bg-gray-800 text-sm py-2.5 rounded-lg transition">
                    Cancel
                </a>
            </div>
        </div>
    </div>
</form>

<script>
    new EasyMDE({
        element: document.getElementById('content-editor'),
        spellChecker: false,
        autosave: { enabled: true, uniqueId: 'webapps-create' },
        toolbar: ['bold', 'italic', 'heading', '|', 'quote', 'unordered-list', 'ordered-list', '|', 'link', 'image', '|', 'preview', 'side-by-side', 'fullscreen']
    });
</script>
