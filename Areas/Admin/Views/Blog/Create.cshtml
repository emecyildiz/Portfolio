@model Portfolio.Models.BlogPost
@{
    ViewData["Title"] = "New Blog Post";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css" />
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Editorial archive</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">New blog post</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Document technical work, experiments and development progress.</p>
    </div>
    <a href="@Url.Action("Index", "Blog", new { area = "Admin" })" class="focus-ring w-fit border border-line px-4 py-2.5 text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Back to blog</a>
</div>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly"></div>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="space-y-6">
            <section class="admin-surface p-5 sm:p-6" aria-labelledby="blog-content-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Article content</p>
                <h3 id="blog-content-heading" class="mt-2 text-lg font-semibold text-white">Title, summary and body</h3>

                <div class="mt-6 space-y-5">
                    <div>
                        <label asp-for="Title" class="admin-label">Title</label>
                        <input asp-for="Title" class="admin-input" autocomplete="off" />
                        <p class="admin-hint">The public slug is generated from this title.</p>
                        <span asp-validation-for="Title"></span>
                    </div>

                    <div>
                        <label asp-for="Summary" class="admin-label">Summary</label>
                        <textarea asp-for="Summary" rows="3" class="admin-textarea" placeholder="A concise description for archive cards and search results."></textarea>
                        <span asp-validation-for="Summary"></span>
                    </div>

                    <div>
                        <label asp-for="Content" class="admin-label">Content <span class="font-normal text-slate-600">(Markdown)</span></label>
                        <textarea asp-for="Content" id="content-editor"></textarea>
                        <p class="admin-hint">Local draft recovery is enabled in this browser while creating the post.</p>
                        <span asp-validation-for="Content"></span>
                    </div>
                </div>
            </section>

            <section class="admin-surface p-5 sm:p-6" aria-labelledby="blog-media-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Media</p>
                <h3 id="blog-media-heading" class="mt-2 text-lg font-semibold text-white">Cover image</h3>
                <label for="blogImages" class="admin-label mt-5">Image file <span class="font-normal text-slate-600">(optional)</span></label>
                <input name="Images" id="blogImages" type="file" accept="image/jpeg,image/png,image/webp,image/gif" aria-describedby="blog-images-help" class="focus-ring w-full border border-line bg-ink p-3 text-sm text-slate-400 file:mr-3 file:border-0 file:bg-raised file:px-3 file:py-2 file:text-xs file:font-medium file:text-slate-300 hover:file:bg-line" />
                <p id="blog-images-help" class="admin-hint">JPEG, PNG, WebP or GIF; maximum 10 MB. The uploaded image becomes the cover.</p>
            </section>
        </div>

        <aside class="h-fit space-y-4 xl:sticky xl:top-6" aria-labelledby="blog-settings-heading">
            <section class="admin-surface p-5 sm:p-6">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Publishing</p>
                <h3 id="blog-settings-heading" class="mt-2 text-lg font-semibold text-white">Post settings</h3>

                <div class="mt-6 space-y-5">
                    <div>
                        <label asp-for="Status" class="admin-label">Status</label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.VisibilityStatus>()" class="admin-select"></select>
                        <span asp-validation-for="Status"></span>
                    </div>

                    <label class="flex cursor-pointer items-start gap-3 border border-line bg-ink/50 p-4">
                        <input asp-for="IsFeatured" type="checkbox" class="admin-checkbox mt-0.5 shrink-0" />
                        <span>
                            <span class="block text-sm font-medium text-slate-300">Feature on homepage</span>
                            <span class="mt-1 block text-xs leading-5 text-slate-600">Give this post additional visibility.</span>
                        </span>
                    </label>
                </div>
            </section>

            <div class="flex flex-col gap-2">
                <button type="submit" class="focus-ring w-full bg-signal px-6 py-3 text-sm font-semibold text-ink transition hover:bg-white">Create post</button>
                <a href="@Url.Action("Index", "Blog", new { area = "Admin" })" class="focus-ring w-full border border-line px-5 py-3 text-center text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Cancel</a>
            </div>
        </aside>
    </div>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
    <script>
        new EasyMDE({
            element: document.getElementById('content-editor'),
            spellChecker: false,
            autosave: { enabled: true, uniqueId: 'blog-create' },
            toolbar: window.portfolioMarkdownToolbar
        });
    </script>
}
