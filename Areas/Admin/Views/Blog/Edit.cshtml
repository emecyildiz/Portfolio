@model Portfolio.Models.BlogPost
@{
    ViewData["Title"] = "Edit Blog Post";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var images = ViewBag.Images as List<Portfolio.Models.Media> ?? new List<Portfolio.Models.Media>();
    var isPublic = Model.Status == Portfolio.Models.Enums.VisibilityStatus.Public;
}

@section Head {
    <link rel="stylesheet" href="~/vendor/easymde/easymde.min.css" asp-append-version="true" />
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Editorial archive</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Edit blog post</h2>
        <p class="mt-2 font-mono text-[11px] text-slate-600">/blog/@Model.Slug</p>
    </div>
    <div class="flex flex-wrap gap-3">
        @if (isPublic)
        {
            <a href="/blog/@Model.Slug" target="_blank" rel="noopener noreferrer" class="focus-ring border border-cyan/20 px-4 py-2.5 text-sm text-cyan transition hover:bg-cyan/10">Preview</a>
        }
        <a href="@Url.Action("Index", "Blog", new { area = "Admin" })" class="focus-ring border border-line px-4 py-2.5 text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Back to blog</a>
    </div>
</div>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly"></div>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="space-y-6">
            <section class="admin-surface p-5 sm:p-6" aria-labelledby="blog-content-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Article content</p>
                <h3 id="blog-content-heading" class="mt-2 text-lg font-semibold text-white">Title, summary and body</h3>

                <div class="mt-6 space-y-5">
                    <div>
                        <label asp-for="Title" class="admin-label">Title</label>
                        <input asp-for="Title" class="admin-input" autocomplete="off" />
                        <p class="admin-hint">Changing the title also updates the public slug.</p>
                        <span asp-validation-for="Title"></span>
                    </div>

                    <div>
                        <label asp-for="Summary" class="admin-label">Summary</label>
                        <textarea asp-for="Summary" rows="3" class="admin-textarea"></textarea>
                        <span asp-validation-for="Summary"></span>
                    </div>

                    <div>
                        <label asp-for="Content" class="admin-label">Content <span class="font-normal text-slate-600">(Markdown)</span></label>
                        <textarea asp-for="Content" id="content-editor"></textarea>
                        <span asp-validation-for="Content"></span>
                    </div>
                </div>
            </section>

            @if (images.Any())
            {
                <section class="admin-surface p-5 sm:p-6" aria-labelledby="blog-existing-media-heading">
                    <div class="flex items-end justify-between gap-4">
                        <div>
                            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Media library</p>
                            <h3 id="blog-existing-media-heading" class="mt-2 text-lg font-semibold text-white">Existing images</h3>
                        </div>
                        <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">@images.Count files</span>
                    </div>
                    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        @foreach (var image in images)
                        {
                            <article class="overflow-hidden border @(image.IsCover ? "border-signal/35" : "border-line") bg-ink/50">
                                <div class="relative">
                                    <img src="@image.Url" alt="@image.AltText" class="h-40 w-full object-cover" />
                                    @if (image.IsCover)
                                    {
                                        <span class="absolute left-2 top-2 bg-signal px-2 py-1 font-mono text-[9px] uppercase tracking-[0.12em] text-ink">Cover</span>
                                    }
                                </div>
                                <div class="flex items-center justify-end gap-2 p-3">
                                    @if (!image.IsCover)
                                    {
                                        <button type="submit" form="blog-cover-@image.Id" class="focus-ring border border-cyan/20 px-2.5 py-1.5 text-[10px] text-cyan transition hover:bg-cyan/10">Set cover</button>
                                    }
                                    <button type="submit" form="blog-delete-@image.Id" class="focus-ring border border-rose-300/20 px-2.5 py-1.5 text-[10px] text-rose-300 transition hover:bg-rose-300/10">Delete</button>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            <section class="admin-surface p-5 sm:p-6" aria-labelledby="blog-media-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Media upload</p>
                <h3 id="blog-media-heading" class="mt-2 text-lg font-semibold text-white">Add images</h3>
                <label for="blogImages" class="admin-label mt-5">Image files <span class="font-normal text-slate-600">(optional)</span></label>
                <input name="Images" id="blogImages" type="file" multiple accept="image/jpeg,image/png,image/webp,image/gif" aria-describedby="blog-images-help" class="focus-ring w-full border border-line bg-ink p-3 text-sm text-slate-400 file:mr-3 file:border-0 file:bg-raised file:px-3 file:py-2 file:text-xs file:font-medium file:text-slate-300 hover:file:bg-line" />
                <p id="blog-images-help" class="admin-hint">JPEG, PNG, WebP or GIF; maximum 10 MB per file.</p>
            </section>
        </div>

        <aside class="h-fit space-y-4 xl:sticky xl:top-6" aria-labelledby="blog-settings-heading">
            <section class="admin-surface p-5 sm:p-6">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Publishing</p>
                <h3 id="blog-settings-heading" class="mt-2 text-lg font-semibold text-white">Post settings</h3>

                <div class="mt-6 space-y-5">
                    <div>
                        <label asp-for="Status" class="admin-label">Status</label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.VisibilityStatus>()" class="admin-select"></select>
                        <span asp-validation-for="Status"></span>
                    </div>

                    <label class="flex cursor-pointer items-start gap-3 border border-line bg-ink/50 p-4">
                        <input asp-for="IsFeatured" type="checkbox" class="admin-checkbox mt-0.5 shrink-0" />
                        <span>
                            <span class="block text-sm font-medium text-slate-300">Feature on homepage</span>
                            <span class="mt-1 block text-xs leading-5 text-slate-600">Give this post additional visibility.</span>
                        </span>
                    </label>

                    <div class="border-t border-line pt-4 font-mono text-[10px] uppercase tracking-[0.1em] text-slate-700">
                        <p>Created @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                        <p class="mt-1">@Model.ViewCount unique views</p>
                        <p class="mt-1">@Model.ReadingTimeMinutes min read</p>
                    </div>
                </div>
            </section>

            <div class="flex flex-col gap-2">
                <button type="submit" class="focus-ring w-full bg-signal px-6 py-3 text-sm font-semibold text-ink transition hover:bg-white">Save changes</button>
                <a href="@Url.Action("Index", "Blog", new { area = "Admin" })" class="focus-ring w-full border border-line px-5 py-3 text-center text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Cancel</a>
            </div>
        </aside>
    </div>
</form>

@foreach (var image in images)
{
    <form id="blog-cover-@image.Id" method="post" action="@Url.Action("SetCover", "Blog", new { area = "Admin" })" class="hidden">
        @Html.AntiForgeryToken()
        <input type="hidden" name="mediaId" value="@image.Id" />
        <input type="hidden" name="postId" value="@Model.Id" />
    </form>
    <form id="blog-delete-@image.Id" method="post" action="@Url.Action("DeleteImage", "Blog", new { area = "Admin" })" onsubmit="return confirm('Delete this image permanently?');" class="hidden">
        @Html.AntiForgeryToken()
        <input type="hidden" name="mediaId" value="@image.Id" />
        <input type="hidden" name="postId" value="@Model.Id" />
    </form>
}

@section Scripts {
    <script src="~/vendor/easymde/easymde.min.js" asp-append-version="true"></script>
    <script>
        window.createPortfolioMarkdownEditor({
            element: document.getElementById('content-editor'),
            spellChecker: false,
            autoDownloadFontAwesome: false,
            toolbar: window.portfolioMarkdownToolbar
        });
    </script>
}
