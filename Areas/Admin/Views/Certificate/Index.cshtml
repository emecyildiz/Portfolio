@model List<Portfolio.Models.Certificate>
@{
    ViewData["Title"] = "Sertifikalar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex items-center justify-between mb-8">
    <div>
        <h2 class="text-2xl font-bold text-white">Sertifikalar</h2>
        <p class="text-gray-500 mt-1">Ana sayfada gösterilecek sertifikalar</p>
    </div>
    <a href="@Url.Action("Create", "Certificate", new { area = "Admin" })"
       class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
        + Yeni Sertifika
    </a>
</div>

<div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="border-b border-gray-800">
                <th class="text-left px-6 py-3 text-gray-400 font-medium">Sertifika</th>
                <th class="text-left px-6 py-3 text-gray-400 font-medium">Veren Kurum</th>
                <th class="text-left px-6 py-3 text-gray-400 font-medium">Tarih</th>
                <th class="text-left px-6 py-3 text-gray-400 font-medium">Durum</th>
                <th class="text-right px-6 py-3 text-gray-400 font-medium">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr class="border-b border-gray-800/50 hover:bg-gray-800/30 transition">
                    <td class="px-6 py-4 text-white font-medium">@c.Title</td>
                    <td class="px-6 py-4 text-gray-400">@c.Issuer</td>
                    <td class="px-6 py-4 text-gray-500 text-xs">@c.IssuedDate.ToString("MMM yyyy")</td>
                    <td class="px-6 py-4">
                        @if (c.Status == Portfolio.Models.Enums.VisibilityStatus.Public)
                        {
                            <span class="bg-green-900/40 text-green-400 text-xs px-2 py-1 rounded-full">Yayında</span>
                        }
                        else
                        {
                            <span class="bg-gray-800 text-gray-500 text-xs px-2 py-1 rounded-full">Gizli</span>
                        }
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex items-center justify-end gap-2">
                            <a href="@Url.Action("Edit", "Certificate", new { area = "Admin", id = c.Id })"
                               class="text-xs px-3 py-1.5 rounded-lg border border-gray-700 text-gray-400 hover:bg-gray-800 transition">
                                Düzenle
                            </a>
                            <form method="post" action="@Url.Action("Delete", "Certificate", new { area = "Admin", id = c.Id })"
                                  onsubmit="return confirm('Bu sertifikayı silmek istediğine emin misin?')">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="text-xs px-3 py-1.5 rounded-lg border border-red-900 text-red-400 hover:bg-red-900/30 transition">
                                    Sil
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="text-center py-16 text-gray-600">Henüz sertifika yok.</div>
    }
</div>