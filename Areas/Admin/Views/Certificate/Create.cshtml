@model Portfolio.Models.Certificate
@{
    ViewData["Title"] = "New Certificate";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Credential archive</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">New certificate</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Add a verifiable learning or professional credential.</p>
    </div>
    <a href="@Url.Action("Index", "Certificate", new { area = "Admin" })" class="focus-ring w-fit border border-line px-4 py-2.5 text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Back to certificates</a>
</div>

<form method="post" class="max-w-6xl">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly"></div>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(19rem,.7fr)]">
        <section class="admin-surface p-5 sm:p-6" aria-labelledby="certificate-content-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Credential details</p>
            <h3 id="certificate-content-heading" class="mt-2 text-lg font-semibold text-white">Identity and verification</h3>

            <div class="mt-6 space-y-5">
                <div class="grid gap-5 sm:grid-cols-2">
                    <div>
                        <label asp-for="Title" class="admin-label">Certificate name</label>
                        <input asp-for="Title" class="admin-input" autocomplete="off" placeholder="CompTIA Security+" />
                        <span asp-validation-for="Title"></span>
                    </div>
                    <div>
                        <label asp-for="Issuer" class="admin-label">Issuer</label>
                        <input asp-for="Issuer" class="admin-input" autocomplete="organization" placeholder="CompTIA" />
                        <span asp-validation-for="Issuer"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="CredentialId" class="admin-label">Credential ID <span class="font-normal text-slate-600">(optional)</span></label>
                    <input asp-for="CredentialId" class="admin-input font-mono" autocomplete="off" />
                    <span asp-validation-for="CredentialId"></span>
                </div>

                <div>
                    <label asp-for="CredentialUrl" class="admin-label">Verification link <span class="font-normal text-slate-600">(optional)</span></label>
                    <input asp-for="CredentialUrl" type="url" class="admin-input" inputmode="url" autocomplete="url" aria-describedby="credential-url-help" placeholder="https://issuer.example/verify/..." />
                    <p id="credential-url-help" class="admin-hint">Use the issuer's official HTTPS verification page. This becomes a public external link.</p>
                    <span asp-validation-for="CredentialUrl"></span>
                </div>

                <div>
                    <label asp-for="ImageUrl" class="admin-label">Badge image path <span class="font-normal text-slate-600">(optional)</span></label>
                    <input asp-for="ImageUrl" class="admin-input font-mono" autocomplete="off" aria-describedby="certificate-image-help" placeholder="/uploads/certificates/badge.webp" />
                    <p id="certificate-image-help" class="admin-hint">Use a trusted uploaded asset or an approved external image URL.</p>
                    <span asp-validation-for="ImageUrl"></span>
                </div>
            </div>
        </section>

        <aside class="admin-surface h-fit p-5 sm:p-6" aria-labelledby="certificate-settings-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Lifecycle</p>
            <h3 id="certificate-settings-heading" class="mt-2 text-lg font-semibold text-white">Dates and visibility</h3>

            <div class="mt-6 space-y-5">
                <div>
                    <label asp-for="IssuedDate" class="admin-label">Issue date</label>
                    <input asp-for="IssuedDate" type="date" class="admin-input" />
                    <span asp-validation-for="IssuedDate"></span>
                </div>

                <div>
                    <label asp-for="ExpiryDate" class="admin-label">Expiry date <span class="font-normal text-slate-600">(optional)</span></label>
                    <input asp-for="ExpiryDate" type="date" class="admin-input" />
                    <p class="admin-hint">Leave empty for credentials that do not expire.</p>
                    <span asp-validation-for="ExpiryDate"></span>
                </div>

                <div>
                    <label asp-for="SortOrder" class="admin-label">Sort order</label>
                    <input asp-for="SortOrder" type="number" class="admin-input" inputmode="numeric" />
                    <span asp-validation-for="SortOrder"></span>
                </div>

                <div>
                    <label asp-for="Status" class="admin-label">Visibility</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.VisibilityStatus>()" class="admin-select"></select>
                    <span asp-validation-for="Status"></span>
                </div>
            </div>
        </aside>
    </div>

    <div class="mt-6 flex flex-col-reverse gap-3 border-t border-line pt-5 sm:flex-row sm:justify-end">
        <a href="@Url.Action("Index", "Certificate", new { area = "Admin" })" class="focus-ring border border-line px-5 py-2.5 text-center text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Cancel</a>
        <button type="submit" class="focus-ring bg-signal px-6 py-2.5 text-sm font-semibold text-ink transition hover:bg-white">Create certificate</button>
    </div>
</form>
