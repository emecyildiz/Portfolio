@model Portfolio.Models.Page
@{
    ViewData["Title"] = "Edit Page";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var isPublic = Model.Status == Portfolio.Models.Enums.VisibilityStatus.Public;
}

@section Head {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css" />
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Document archive</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Edit page</h2>
        <p class="mt-2 font-mono text-[11px] text-slate-600">/pages/@Model.Slug</p>
    </div>
    <div class="flex flex-wrap gap-3">
        @if (isPublic)
        {
            <a href="/pages/@Model.Slug" target="_blank" rel="noopener noreferrer" class="focus-ring border border-cyan/20 px-4 py-2.5 text-sm text-cyan transition hover:bg-cyan/10">Preview</a>
        }
        <a href="@Url.Action("Index", "Page", new { area = "Admin" })" class="focus-ring border border-line px-4 py-2.5 text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Back to pages</a>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly"></div>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="space-y-6">
            <section class="admin-surface p-5 sm:p-6" aria-labelledby="page-content-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Page content</p>
                <h3 id="page-content-heading" class="mt-2 text-lg font-semibold text-white">Title and body</h3>

                <div class="mt-6 space-y-5">
                    <div>
                        <label asp-for="Title" class="admin-label">Title</label>
                        <input asp-for="Title" class="admin-input" autocomplete="off" />
                        <p class="admin-hint">Changing the title may also update the public slug.</p>
                        <span asp-validation-for="Title"></span>
                    </div>

                    <div>
                        <label asp-for="Content" class="admin-label">Content <span class="font-normal text-slate-600">(Markdown)</span></label>
                        <textarea asp-for="Content" id="content-editor"></textarea>
                        <span asp-validation-for="Content"></span>
                    </div>
                </div>
            </section>

            <section class="admin-surface p-5 sm:p-6" aria-labelledby="page-media-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Media</p>
                <h3 id="page-media-heading" class="mt-2 text-lg font-semibold text-white">Cover image</h3>
                <div class="mt-6">
                    <label asp-for="CoverImageUrl" class="admin-label">Image path <span class="font-normal text-slate-600">(optional)</span></label>
                    <input asp-for="CoverImageUrl" class="admin-input font-mono" autocomplete="off" aria-describedby="page-image-help" />
                    <p id="page-image-help" class="admin-hint">Use a trusted uploaded asset or an approved external image URL.</p>
                    <span asp-validation-for="CoverImageUrl"></span>
                </div>
            </section>
        </div>

        <aside class="h-fit space-y-4 xl:sticky xl:top-6" aria-labelledby="page-settings-heading">
            <section class="admin-surface p-5 sm:p-6">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Publishing</p>
                <h3 id="page-settings-heading" class="mt-2 text-lg font-semibold text-white">Page settings</h3>

                <div class="mt-6 space-y-5">
                    <div>
                        <label asp-for="Status" class="admin-label">Status</label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.VisibilityStatus>()" class="admin-select"></select>
                        <span asp-validation-for="Status"></span>
                    </div>

                    <label class="flex cursor-pointer items-start gap-3 border border-line bg-ink/50 p-4">
                        <input asp-for="ShowInNav" type="checkbox" class="admin-checkbox mt-0.5 shrink-0" />
                        <span>
                            <span class="block text-sm font-medium text-slate-300">Show in navigation</span>
                            <span class="mt-1 block text-xs leading-5 text-slate-600">Only effective while the page is public.</span>
                        </span>
                    </label>

                    <div>
                        <label asp-for="SortOrder" class="admin-label">Sort order</label>
                        <input asp-for="SortOrder" type="number" class="admin-input" inputmode="numeric" />
                        <span asp-validation-for="SortOrder"></span>
                    </div>

                    <div class="border-t border-line pt-4 font-mono text-[10px] uppercase tracking-[0.1em] text-slate-700">
                        <p>Created @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                        <p class="mt-1">Updated @Model.UpdatedAt.ToString("dd MMM yyyy HH:mm")</p>
                    </div>
                </div>
            </section>

            <div class="flex flex-col gap-2">
                <button type="submit" class="focus-ring w-full bg-signal px-6 py-3 text-sm font-semibold text-ink transition hover:bg-white">Save changes</button>
                <a href="@Url.Action("Index", "Page", new { area = "Admin" })" class="focus-ring w-full border border-line px-5 py-3 text-center text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Cancel</a>
            </div>
        </aside>
    </div>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
    <script>
        new EasyMDE({
            element: document.getElementById('content-editor'),
            spellChecker: false,
            toolbar: ['bold', 'italic', 'heading', '|', 'quote', 'unordered-list', 'ordered-list', '|', 'link', 'image', '|', 'preview', 'side-by-side', 'fullscreen']
        });
    </script>
}
