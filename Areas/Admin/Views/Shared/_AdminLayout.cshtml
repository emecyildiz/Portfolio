<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1E3A5F',
                        secondary: '#2D6A9F',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen flex">

    <!-- Sidebar -->
    <aside class="w-64 bg-gray-900 border-r border-gray-800 flex flex-col fixed h-full">
        <div class="p-6 border-b border-gray-800">
            <h1 class="text-lg font-bold text-white">Admin Panel</h1>
            <p class="text-xs text-gray-500 mt-1">Portfolio Management</p>
        </div>

        <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">
                Dashboard
            </a>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">
                Categories
            </a>

            <div class="pt-2 pb-1">
                <p class="text-xs text-gray-600 px-3 uppercase tracking-wider">Content</p>
            </div>

            @if (ViewBag.Categories != null)
            {
                foreach (var cat in (List<Portfolio.Models.Category>)ViewBag.Categories)
                {
                    var controllerName = cat.Slug switch
                    {
                        "security" => "Security",
                        "electronics" => "Electronics",
                        "webapps" => "WebApps",
                        "homelab" => "Homelab",
                        "blog" => "Blog",
                        "team" => "Team",
                        "notes" => "Note",
                        _ => "Category"
                    };

                    <a asp-area="Admin" asp-controller="@controllerName" asp-action="Index"
                       class="flex items-center justify-between px-3 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">
                        <span>@cat.Name</span>
                        @if (cat.Status != Portfolio.Models.Enums.VisibilityStatus.Public)
                        {
                            <span class="text-xs text-gray-600">hidden</span>
                        }
                    </a>
                }
            }
            <a asp-area="Admin" asp-controller="Page" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">
                Pages
            </a>

            <div class="pt-2 pb-1">
                <p class="text-xs text-gray-600 px-3 uppercase tracking-wider">Other</p>
            </div>

            <a asp-area="Admin" asp-controller="Service" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">
                Services
            </a>
            <a asp-area="Admin" asp-controller="Certificate" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">
                Certificates
            </a>
            <a asp-area="Admin" asp-controller="Message" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">
                Messages
            </a>
            <a asp-area="Admin" asp-controller="Settings" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">
                Settings
            </a>
        </nav>

        <div class="p-4 border-t border-gray-800">
            <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Logout">
                <button type="submit"
                        class="w-full px-3 py-2 text-sm text-gray-400 hover:text-red-400 hover:bg-gray-800 rounded-lg transition text-left">
                    Sign Out
                </button>
            </form>
        </div>
    </aside>

    <!-- Main content -->
    <main class="ml-64 flex-1 p-8">
        @RenderBody()
    </main>
    <!-- Toast notifications -->
    @if (TempData["Success"] != null)
    {
        <div id="toast"
             class="fixed top-4 right-4 bg-green-900/90 border border-green-700 text-green-300 text-sm px-5 py-3 rounded-xl shadow-lg z-50 flex items-center gap-2">
            <span>✓</span> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div id="toast"
             class="fixed top-4 right-4 bg-red-900/90 border border-red-700 text-red-300 text-sm px-5 py-3 rounded-xl shadow-lg z-50 flex items-center gap-2">
            <span>✕</span> @TempData["Error"]
        </div>
    }
    <script>
        const toast = document.getElementById('toast');
        if (toast) setTimeout(() => toast.style.opacity = '0', 3000);
    </script>

</body>
</html>
