<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ink: '#07090D', panel: '#0D1219', raised: '#121923', line: '#202C38',
                        signal: '#B8F36B', cyan: '#55D6FF', ember: '#FF8A4C'
                    },
                    fontFamily: {
                        sans: ['Space Grotesk', 'Inter', 'sans-serif'],
                        mono: ['IBM Plex Mono', 'JetBrains Mono', 'monospace']
                    },
                    boxShadow: { panel: '0 24px 80px rgba(0,0,0,.28)' }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root { color-scheme: dark; }
        body { font-family: 'Space Grotesk', 'Inter', sans-serif; }
        .font-mono { font-family: 'IBM Plex Mono', 'JetBrains Mono', monospace; }
        .admin-grid {
            background-image: linear-gradient(rgba(255,255,255,.022) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.022) 1px, transparent 1px);
            background-size: 48px 48px;
        }
        .admin-surface { background: linear-gradient(145deg, rgba(18,25,35,.94), rgba(10,14,20,.94)); border: 1px solid rgba(148,163,184,.14); }
        .focus-ring:focus-visible { outline: 2px solid #B8F36B; outline-offset: 3px; }
        .admin-label { display: block; margin-bottom: .5rem; color: #cbd5e1; font-size: .875rem; font-weight: 500; }
        .admin-hint { margin-top: .5rem; color: #64748b; font-size: .75rem; line-height: 1.25rem; }
        .admin-input, .admin-select, .admin-textarea {
            width: 100%; border: 1px solid #202C38; border-radius: 0; background: #07090D;
            padding: .75rem 1rem; color: #f8fafc; font-size: .875rem; transition: border-color .15s, box-shadow .15s;
        }
        .admin-textarea { resize: vertical; line-height: 1.6; }
        .admin-input::placeholder, .admin-textarea::placeholder { color: #475569; }
        .admin-input:hover, .admin-select:hover, .admin-textarea:hover { border-color: #475569; }
        .admin-input:focus, .admin-select:focus, .admin-textarea:focus {
            border-color: #B8F36B; outline: none; box-shadow: 0 0 0 3px rgba(184,243,107,.08);
        }
        .admin-checkbox { width: 1rem; height: 1rem; accent-color: #B8F36B; }
        .field-validation-error { display: block; margin-top: .4rem; color: #fda4af; font-size: .75rem; }
        .validation-summary-errors { margin-bottom: 1.5rem; border: 1px solid rgba(253,164,175,.22); background: rgba(253,164,175,.06); padding: 1rem; color: #fecdd3; font-size: .875rem; }
        .validation-summary-errors ul { list-style: none; margin: 0; padding: 0; }
        .validation-summary-valid { display: none; }
        .editor-toolbar { border-color: #202C38 !important; border-radius: 0 !important; background: #0D1219; }
        .editor-toolbar button { color: #94a3b8 !important; }
        .editor-toolbar button.active, .editor-toolbar button:hover { border-color: #334155 !important; background: #121923 !important; color: #B8F36B !important; }
        .editor-toolbar i.separator { border-color: #202C38 !important; }
        .CodeMirror { min-height: 28rem; border-color: #202C38 !important; border-radius: 0 !important; background: #07090D; color: #e2e8f0; }
        .CodeMirror-cursor { border-left-color: #B8F36B !important; }
        .editor-statusbar { color: #64748b; }
        .editor-preview, .editor-preview-side { background: #0D1219; color: #e2e8f0; }
        ::selection { color: #07090D; background: #B8F36B; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #07090D; }
        ::-webkit-scrollbar-thumb { background: #273543; border: 2px solid #07090D; border-radius: 999px; }
    </style>
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="min-h-screen overflow-x-hidden bg-ink text-slate-100 antialiased">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        Func<string, bool> isActive = controller => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
    }

    <div aria-hidden="true" class="admin-grid pointer-events-none fixed inset-0 -z-10 opacity-50"></div>

    <header class="fixed inset-x-0 top-0 z-40 flex h-16 items-center justify-between border-b border-white/[0.07] bg-ink/90 px-4 backdrop-blur-xl lg:hidden">
        <button id="adminMenuButton" type="button" aria-label="Open admin navigation" aria-controls="adminSidebar" aria-expanded="false" class="focus-ring grid h-10 w-10 place-items-center rounded-md border border-white/10 text-slate-300"><span aria-hidden="true" class="flex w-4 flex-col gap-1.5"><span class="h-px bg-current"></span><span class="h-px bg-current"></span></span></button>
        <div class="text-right"><p class="font-mono text-[9px] uppercase tracking-[0.18em] text-slate-600">Admin console</p><p class="text-sm font-medium text-white">@ViewData["Title"]</p></div>
    </header>

    <div id="adminSidebarOverlay" class="hidden fixed inset-0 z-40 bg-ink/80 backdrop-blur-sm lg:hidden"></div>

    <aside id="adminSidebar" class="fixed inset-y-0 left-0 z-50 flex w-72 -translate-x-full flex-col border-r border-white/[0.07] bg-panel/95 shadow-2xl backdrop-blur-xl transition-transform duration-200 lg:translate-x-0">
        <div class="flex h-20 items-center justify-between border-b border-white/[0.07] px-5">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="focus-ring group flex items-center gap-3 rounded-sm"><span class="grid h-10 w-10 place-items-center border border-signal/35 bg-signal/[0.06] font-mono text-sm font-semibold text-signal transition group-hover:bg-signal group-hover:text-ink">A/</span><span><strong class="block text-sm font-semibold text-white">Admin Console</strong><small class="mt-0.5 block font-mono text-[8px] uppercase tracking-[0.2em] text-slate-600">Portfolio operations</small></span></a>
            <button id="adminMenuClose" type="button" aria-label="Close admin navigation" class="focus-ring rounded-md border border-white/10 px-2.5 py-2 font-mono text-[9px] text-slate-500 lg:hidden">ESC</button>
        </div>

        <nav aria-label="Admin navigation" class="flex-1 overflow-y-auto p-4">
            <p class="mb-2 px-3 font-mono text-[8px] uppercase tracking-[0.22em] text-slate-700">Overview</p>
            <div class="space-y-1">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="focus-ring flex items-center justify-between rounded-lg px-3 py-2.5 text-sm transition @(isActive("Dashboard") ? "bg-signal/10 text-signal" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")"><span>Dashboard</span><span class="font-mono text-[9px] opacity-50">01</span></a>
                <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="focus-ring flex items-center justify-between rounded-lg px-3 py-2.5 text-sm transition @(isActive("Category") ? "bg-signal/10 text-signal" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")"><span>Categories</span><span class="font-mono text-[9px] opacity-50">02</span></a>
            </div>

            <p class="mb-2 mt-7 px-3 font-mono text-[8px] uppercase tracking-[0.22em] text-slate-700">Content archive</p>
            <div class="space-y-1">
                @if (ViewBag.Categories != null)
                {
                    foreach (var category in (List<Portfolio.Models.Category>)ViewBag.Categories)
                    {
                        var controllerName = category.Slug switch
                        {
                            "security" => "Security", "electronics" => "Electronics", "webapps" => "WebApps",
                            "homelab" => "Homelab", "blog" => "Blog", "team" => "Team", "notes" => "Note",
                            _ => "Category"
                        };
                        var categoryLabel = category.Slug switch
                        {
                            "security" => "Security", "electronics" => "Electronics", "webapps" => "Web Apps",
                            "homelab" => "Homelab", "blog" => "Blog", "team" => "Team", "notes" => "Notes",
                            _ => category.Name
                        };
                        <a asp-area="Admin" asp-controller="@controllerName" asp-action="Index" class="focus-ring flex items-center justify-between gap-3 rounded-lg px-3 py-2.5 text-sm transition @(isActive(controllerName) ? "bg-cyan/10 text-cyan" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")"><span class="truncate">@categoryLabel</span>@if (category.Status != Portfolio.Models.Enums.VisibilityStatus.Public){<span class="rounded-full border border-white/10 px-2 py-0.5 font-mono text-[8px] uppercase tracking-[0.1em] text-slate-600">Hidden</span>}</a>
                    }
                }
                <a asp-area="Admin" asp-controller="Page" asp-action="Index" class="focus-ring flex items-center justify-between rounded-lg px-3 py-2.5 text-sm transition @(isActive("Page") ? "bg-cyan/10 text-cyan" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")"><span>Pages</span><span class="font-mono text-[9px] opacity-50">DOC</span></a>
            </div>

            <p class="mb-2 mt-7 px-3 font-mono text-[8px] uppercase tracking-[0.22em] text-slate-700">Operations</p>
            <div class="space-y-1">
                <a asp-area="Admin" asp-controller="Service" asp-action="Index" class="focus-ring block rounded-lg px-3 py-2.5 text-sm transition @(isActive("Service") ? "bg-violet-300/10 text-violet-200" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")">Services</a>
                <a asp-area="Admin" asp-controller="Certificate" asp-action="Index" class="focus-ring block rounded-lg px-3 py-2.5 text-sm transition @(isActive("Certificate") ? "bg-violet-300/10 text-violet-200" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")">Certificates</a>
                <a asp-area="Admin" asp-controller="Message" asp-action="Index" class="focus-ring block rounded-lg px-3 py-2.5 text-sm transition @(isActive("Message") ? "bg-violet-300/10 text-violet-200" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")">Messages</a>
                <a asp-area="Admin" asp-controller="Settings" asp-action="Index" class="focus-ring block rounded-lg px-3 py-2.5 text-sm transition @(isActive("Settings") ? "bg-violet-300/10 text-violet-200" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")">Settings</a>
            </div>
        </nav>

        <div class="border-t border-white/[0.07] p-4">
            <a href="/" target="_blank" rel="noopener noreferrer" class="focus-ring mb-2 flex items-center justify-between rounded-lg px-3 py-2.5 text-sm text-slate-500 transition hover:bg-white/[0.04] hover:text-white"><span>View public site</span><span aria-hidden="true">↗</span></a>
            <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Logout"><button type="submit" class="focus-ring w-full rounded-lg px-3 py-2.5 text-left text-sm text-slate-500 transition hover:bg-rose-300/[0.06] hover:text-rose-300">Sign out</button></form>
        </div>
    </aside>

    <main class="min-h-screen px-4 pb-10 pt-24 sm:px-6 lg:ml-72 lg:px-8 lg:pt-10 xl:px-10">
        <div class="mx-auto max-w-[96rem]">@RenderBody()</div>
    </main>

    @if (TempData["Success"] != null)
    {
        <div class="admin-toast fixed bottom-4 right-4 z-[70] max-w-sm rounded-xl border border-signal/20 bg-panel/95 px-5 py-4 text-sm text-signal shadow-panel backdrop-blur" role="status">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="admin-toast fixed bottom-4 right-4 z-[70] max-w-sm rounded-xl border border-rose-300/20 bg-panel/95 px-5 py-4 text-sm text-rose-200 shadow-panel backdrop-blur" role="alert">@TempData["Error"]</div>
    }

    <script>
        const adminSidebar = document.getElementById('adminSidebar');
        const adminSidebarOverlay = document.getElementById('adminSidebarOverlay');
        const adminMenuButton = document.getElementById('adminMenuButton');
        let adminMenuPreviousFocus = null;

        function trapAdminMenuFocus(event) {
            const focusableElements = Array.from(adminSidebar.querySelectorAll(
                'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
            )).filter(element => element.offsetParent !== null);
            if (focusableElements.length === 0) return;

            const firstElement = focusableElements[0];
            const lastElement = focusableElements[focusableElements.length - 1];
            if (event.shiftKey && document.activeElement === firstElement) {
                event.preventDefault();
                lastElement.focus();
            } else if (!event.shiftKey && document.activeElement === lastElement) {
                event.preventDefault();
                firstElement.focus();
            }
        }

        function setAdminMenu(open) {
            const isMobile = window.innerWidth < 1024;
            if (open && isMobile) adminMenuPreviousFocus = document.activeElement;
            adminSidebar.classList.toggle('-translate-x-full', !open);
            adminSidebarOverlay.classList.toggle('hidden', !open);
            adminMenuButton.setAttribute('aria-expanded', String(open));
            document.body.classList.toggle('overflow-hidden', open && isMobile);

            if (open && isMobile) {
                window.setTimeout(() => document.getElementById('adminMenuClose').focus(), 0);
            } else if (!open && adminMenuPreviousFocus) {
                adminMenuPreviousFocus.focus();
                adminMenuPreviousFocus = null;
            }
        }

        adminMenuButton.addEventListener('click', () => setAdminMenu(true));
        document.getElementById('adminMenuClose').addEventListener('click', () => setAdminMenu(false));
        adminSidebarOverlay.addEventListener('click', () => setAdminMenu(false));
        document.addEventListener('keydown', event => {
            const menuIsOpen = window.innerWidth < 1024 && !adminSidebar.classList.contains('-translate-x-full');
            if (menuIsOpen && event.key === 'Escape') setAdminMenu(false);
            else if (menuIsOpen && event.key === 'Tab') trapAdminMenuFocus(event);
        });

        document.querySelectorAll('.admin-toast').forEach(toast => {
            window.setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translateY(8px)'; }, 3200);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
