<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Admin</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tailwind.min.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <style>
        :root { color-scheme: dark; }
        body { font-family: 'Space Grotesk Variable', 'Inter Variable', sans-serif; }
        .font-mono { font-family: 'IBM Plex Mono', 'JetBrains Mono', monospace; }
        .admin-grid {
            background-image: linear-gradient(rgba(255,255,255,.022) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.022) 1px, transparent 1px);
            background-size: 48px 48px;
        }
        .admin-surface { background: linear-gradient(145deg, rgba(18,25,35,.94), rgba(10,14,20,.94)); border: 1px solid rgba(148,163,184,.14); }
        .focus-ring:focus-visible { outline: 2px solid #B8F36B; outline-offset: 3px; }
        .admin-label { display: block; margin-bottom: .5rem; color: #cbd5e1; font-size: .875rem; font-weight: 500; }
        .admin-hint { margin-top: .5rem; color: #64748b; font-size: .75rem; line-height: 1.25rem; }
        .admin-input, .admin-select, .admin-textarea {
            width: 100%; border: 1px solid #202C38; border-radius: 0; background: #07090D;
            padding: .75rem 1rem; color: #f8fafc; font-size: .875rem; transition: border-color .15s, box-shadow .15s;
        }
        .admin-textarea { resize: vertical; line-height: 1.6; }
        .admin-input::placeholder, .admin-textarea::placeholder { color: #475569; }
        .admin-input:hover, .admin-select:hover, .admin-textarea:hover { border-color: #475569; }
        .admin-input:focus, .admin-select:focus, .admin-textarea:focus {
            border-color: #B8F36B; outline: none; box-shadow: 0 0 0 3px rgba(184,243,107,.08);
        }
        .admin-checkbox { width: 1rem; height: 1rem; accent-color: #B8F36B; }
        .field-validation-error { display: block; margin-top: .4rem; color: #fda4af; font-size: .75rem; }
        .admin-input.input-validation-error, .admin-select.input-validation-error, .admin-textarea.input-validation-error {
            border-color: #fb7185; box-shadow: 0 0 0 3px rgba(251,113,133,.08);
        }
        .validation-summary-errors { margin-bottom: 1.5rem; border: 1px solid rgba(253,164,175,.22); background: rgba(253,164,175,.06); padding: 1rem; color: #fecdd3; font-size: .875rem; }
        .validation-summary-errors ul { list-style: none; margin: 0; padding: 0; }
        .validation-summary-valid { display: none; }
        .EasyMDEContainer .editor-toolbar { border-color: #202C38 !important; border-radius: 0 !important; background: #0D1219 !important; opacity: 1; }
        .EasyMDEContainer .editor-toolbar button { color: #cbd5e1 !important; }
        .editor-toolbar button.active, .editor-toolbar button:hover { border-color: #334155 !important; background: #121923 !important; color: #B8F36B !important; }
        .editor-toolbar i.separator { border-color: #202C38 !important; }
        .EasyMDEContainer .editor-toolbar button.fa::before {
            display: inline-block; min-width: 1rem; font-family: 'IBM Plex Mono', monospace; font-size: .72rem;
            font-style: normal; font-weight: 600; line-height: 1; text-align: center;
        }
        .EasyMDEContainer .editor-toolbar .fa-bold::before { content: 'B'; font-weight: 700; }
        .EasyMDEContainer .editor-toolbar .fa-italic::before { content: 'I'; font-style: italic; }
        .EasyMDEContainer .editor-toolbar .fa-strikethrough::before { content: 'S'; text-decoration: line-through; }
        .EasyMDEContainer .editor-toolbar .fa-header::before { content: 'H'; }
        .EasyMDEContainer .editor-toolbar .fa-quote-left::before { content: '>'; }
        .EasyMDEContainer .editor-toolbar .fa-code::before { content: '</>'; font-size: .6rem; }
        .EasyMDEContainer .editor-toolbar .fa-list-ul::before { content: '•'; }
        .EasyMDEContainer .editor-toolbar .fa-list-ol::before { content: '1.'; font-size: .62rem; }
        .EasyMDEContainer .editor-toolbar .fa-link::before { content: '↗'; font-size: .9rem; }
        .EasyMDEContainer .editor-toolbar .fa-image::before { content: 'IMG'; font-size: .55rem; }
        .EasyMDEContainer .editor-toolbar .fa-table::before { content: '▦'; font-size: .9rem; }
        .EasyMDEContainer .editor-toolbar .fa-minus::before { content: '—'; }
        .EasyMDEContainer .editor-toolbar .fa-list-alt::before { content: 'TPL'; font-size: .55rem; }
        .EasyMDEContainer .editor-toolbar .fa-eye::before { content: '◉'; font-size: .85rem; }
        .EasyMDEContainer .editor-toolbar .fa-columns::before { content: '▥'; font-size: .88rem; }
        .EasyMDEContainer .editor-toolbar .fa-arrows-alt::before { content: '⛶'; font-size: .9rem; }
        .EasyMDEContainer .CodeMirror { min-height: 28rem; border-color: #202C38 !important; border-radius: 0 !important; background: #07090D !important; color: #e2e8f0 !important; }
        .EasyMDEContainer.markdown-validation-error .CodeMirror { border-color: #fb7185 !important; box-shadow: 0 0 0 3px rgba(251,113,133,.08); }
        .EasyMDEContainer .CodeMirror-gutters { border-color: #202C38 !important; background: #0A0E14 !important; }
        .EasyMDEContainer .CodeMirror-selected { background: #263545 !important; }
        .EasyMDEContainer .CodeMirror-placeholder { color: #475569 !important; }
        .CodeMirror-cursor { border-left-color: #B8F36B !important; }
        .cm-s-easymde .cm-header { color: #B8F36B; font-weight: 700; }
        .cm-s-easymde .cm-quote { color: #7dd3fc; }
        .cm-s-easymde .cm-link { color: #c4b5fd; }
        .cm-s-easymde .cm-url { color: #94a3b8; }
        .cm-s-easymde .cm-comment, .cm-s-easymde .cm-formatting { color: #64748b; }
        .EasyMDEContainer .editor-statusbar { color: #64748b; }
        .EasyMDEContainer .editor-preview, .EasyMDEContainer .editor-preview-side { border-color: #202C38; background: #0D1219 !important; color: #e2e8f0; }
        .EasyMDEContainer .editor-preview a, .EasyMDEContainer .editor-preview-side a { color: #7dd3fc; }
        .EasyMDEContainer .editor-preview code, .EasyMDEContainer .editor-preview-side code { color: #B8F36B; }
        ::selection { color: #07090D; background: #B8F36B; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #07090D; }
        ::-webkit-scrollbar-thumb { background: #273543; border: 2px solid #07090D; border-radius: 999px; }
    </style>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-site min-h-screen overflow-x-hidden bg-ink text-slate-100 antialiased">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        Func<string, bool> isActive = controller => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
    }

    <div aria-hidden="true" class="admin-grid pointer-events-none fixed inset-0 -z-10 opacity-50"></div>

    <header class="fixed inset-x-0 top-0 z-40 flex h-16 items-center justify-between border-b border-white/[0.07] bg-ink/90 px-4 backdrop-blur-xl lg:hidden">
        <button id="adminMenuButton" type="button" aria-label="Open admin navigation" aria-controls="adminSidebar" aria-expanded="false" class="focus-ring grid h-10 w-10 place-items-center rounded-md border border-white/10 text-slate-300"><span aria-hidden="true" class="flex w-4 flex-col gap-1.5"><span class="h-px bg-current"></span><span class="h-px bg-current"></span></span></button>
        <div class="text-right"><p class="font-mono text-[9px] uppercase tracking-[0.18em] text-slate-600">Admin console</p><p class="text-sm font-medium text-white">@ViewData["Title"]</p></div>
    </header>

    <div id="adminSidebarOverlay" class="hidden fixed inset-0 z-40 bg-ink/80 backdrop-blur-sm lg:hidden"></div>

    <aside id="adminSidebar" class="fixed inset-y-0 left-0 z-50 flex w-72 -translate-x-full flex-col border-r border-white/[0.07] bg-panel/95 shadow-2xl backdrop-blur-xl transition-transform duration-200 lg:translate-x-0">
        <div class="flex h-20 items-center justify-between border-b border-white/[0.07] px-5">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="focus-ring group flex items-center gap-3 rounded-sm"><span class="grid h-10 w-10 place-items-center border border-signal/35 bg-signal/[0.06] font-mono text-sm font-semibold text-signal transition group-hover:bg-signal group-hover:text-ink">A/</span><span><strong class="block text-sm font-semibold text-white">Admin Console</strong><small class="mt-0.5 block font-mono text-[8px] uppercase tracking-[0.2em] text-slate-600">Portfolio operations</small></span></a>
            <button id="adminMenuClose" type="button" aria-label="Close admin navigation" class="focus-ring rounded-md border border-white/10 px-2.5 py-2 font-mono text-[9px] text-slate-500 lg:hidden">ESC</button>
        </div>

        <nav aria-label="Admin navigation" class="flex-1 overflow-y-auto p-4">
            <p class="mb-2 px-3 font-mono text-[8px] uppercase tracking-[0.22em] text-slate-700">Overview</p>
            <div class="space-y-1">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="focus-ring flex items-center justify-between rounded-lg px-3 py-2.5 text-sm transition @(isActive("Dashboard") ? "bg-signal/10 text-signal" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")"><span>Dashboard</span><span class="font-mono text-[9px] opacity-50">01</span></a>
                <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="focus-ring flex items-center justify-between rounded-lg px-3 py-2.5 text-sm transition @(isActive("Category") ? "bg-signal/10 text-signal" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")"><span>Categories</span><span class="font-mono text-[9px] opacity-50">02</span></a>
            </div>

            <p class="mb-2 mt-7 px-3 font-mono text-[8px] uppercase tracking-[0.22em] text-slate-700">Content archive</p>
            <div class="space-y-1">
                @if (ViewBag.Categories != null)
                {
                    foreach (var category in (List<Portfolio.Models.Category>)ViewBag.Categories)
                    {
                        var controllerName = category.Slug switch
                        {
                            "security" => "Security", "electronics" => "Electronics", "webapps" => "WebApps",
                            "homelab" => "Homelab", "blog" => "Blog", "team" => "Team", "notes" => "Note",
                            _ => "Category"
                        };
                        var categoryLabel = category.Slug switch
                        {
                            "security" => "Security", "electronics" => "Electronics", "webapps" => "Web Apps",
                            "homelab" => "Homelab", "blog" => "Blog", "team" => "Team", "notes" => "Notes",
                            _ => category.Name
                        };
                        <a asp-area="Admin" asp-controller="@controllerName" asp-action="Index" class="focus-ring flex items-center justify-between gap-3 rounded-lg px-3 py-2.5 text-sm transition @(isActive(controllerName) ? "bg-cyan/10 text-cyan" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")"><span class="truncate">@categoryLabel</span>@if (category.Status != Portfolio.Models.Enums.VisibilityStatus.Public){<span class="rounded-full border border-white/10 px-2 py-0.5 font-mono text-[8px] uppercase tracking-[0.1em] text-slate-600">Hidden</span>}</a>
                    }
                }
                <a asp-area="Admin" asp-controller="Page" asp-action="Index" class="focus-ring flex items-center justify-between rounded-lg px-3 py-2.5 text-sm transition @(isActive("Page") ? "bg-cyan/10 text-cyan" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")"><span>Pages</span><span class="font-mono text-[9px] opacity-50">DOC</span></a>
            </div>

            <p class="mb-2 mt-7 px-3 font-mono text-[8px] uppercase tracking-[0.22em] text-slate-700">Operations</p>
            <div class="space-y-1">
                <a asp-area="Admin" asp-controller="Service" asp-action="Index" class="focus-ring block rounded-lg px-3 py-2.5 text-sm transition @(isActive("Service") ? "bg-violet-300/10 text-violet-200" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")">Services</a>
                <a asp-area="Admin" asp-controller="Certificate" asp-action="Index" class="focus-ring block rounded-lg px-3 py-2.5 text-sm transition @(isActive("Certificate") ? "bg-violet-300/10 text-violet-200" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")">Certificates</a>
                <a asp-area="Admin" asp-controller="Message" asp-action="Index" class="focus-ring block rounded-lg px-3 py-2.5 text-sm transition @(isActive("Message") ? "bg-violet-300/10 text-violet-200" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")">Messages</a>
                <a asp-area="Admin" asp-controller="Settings" asp-action="Index" class="focus-ring block rounded-lg px-3 py-2.5 text-sm transition @(isActive("Settings") ? "bg-violet-300/10 text-violet-200" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")">Settings</a>
                <a asp-area="Admin" asp-controller="AccountSecurity" asp-action="Index" class="focus-ring block rounded-lg px-3 py-2.5 text-sm transition @(isActive("AccountSecurity") ? "bg-violet-300/10 text-violet-200" : "text-slate-400 hover:bg-white/[0.04] hover:text-white")">Account security</a>
            </div>
        </nav>

        <div class="border-t border-white/[0.07] p-4">
            <a href="/" target="_blank" rel="noopener noreferrer" class="focus-ring mb-2 flex items-center justify-between rounded-lg px-3 py-2.5 text-sm text-slate-500 transition hover:bg-white/[0.04] hover:text-white"><span>View public site</span><span aria-hidden="true">↗</span></a>
            <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Logout"><button type="submit" class="focus-ring w-full rounded-lg px-3 py-2.5 text-left text-sm text-slate-500 transition hover:bg-rose-300/[0.06] hover:text-rose-300">Sign out</button></form>
        </div>
    </aside>

    <main class="min-h-screen px-4 pb-10 pt-24 sm:px-6 lg:ml-72 lg:px-8 lg:pt-10 xl:px-10">
        <div class="mx-auto max-w-[96rem]">@RenderBody()</div>
    </main>

    @if (TempData["Success"] != null)
    {
        <div class="admin-toast fixed bottom-4 right-4 z-[70] max-w-sm rounded-xl border border-signal/20 bg-panel/95 px-5 py-4 text-sm text-signal shadow-panel backdrop-blur" role="status">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="admin-toast fixed bottom-4 right-4 z-[70] max-w-sm rounded-xl border border-rose-300/20 bg-panel/95 px-5 py-4 text-sm text-rose-200 shadow-panel backdrop-blur" role="alert">@TempData["Error"]</div>
    }

    <script>
        window.portfolioEditorContext = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentController));
        window.portfolioContentTemplates = {
            Security: `## Overview

[Summarize the research question, result, and why the work matters.]

## Authorization and disclosure

[State that the target was owned, lab-based, a CTF, or otherwise explicitly authorized. Describe the disclosure status without exposing sensitive details.]

## Scope and environment

- Target:
- Environment:
- Constraints:
- Tools:

## Methodology

[Explain the reproducible analysis process and decision points.]

## Findings

### Finding 1

- Evidence:
- Impact:
- Remediation:

## Validation

[Describe how findings and fixes were verified safely.]

## Lessons learned

[Record technical insights, limitations, and what you would change next time.]`,

            Electronics: `## Overview

[Explain what was built, the intended use, and the final result.]

## Objective and constraints

- Objective:
- Power / size / cost constraints:
- Success criteria:

## Components and design

[Describe the main components, interfaces, and design decisions.]

## Build process

[Document the circuit, assembly, revisions, and important failures.]

## Firmware and software

[Explain the control logic, protocols, and supporting tools.]

## Validation

[Include measurements, test conditions, and observed behavior.]

## Result

[Compare the outcome with the success criteria.]

## Lessons learned

[Record tradeoffs, limitations, and the next revision.]`,

            WebApps: `## Overview

[Summarize the product, users, and delivered outcome.]

## Problem and requirements

- Problem:
- Core requirements:
- Constraints:

## Architecture

[Explain the main components, data flow, and important technology choices.]

## Implementation

[Describe the difficult parts and the decisions behind them.]

## Security and privacy

[Document authentication, validation, data handling, and abuse controls.]

## Testing and validation

[List automated checks, manual scenarios, and performance or reliability evidence.]

## Outcome

[State measurable results, current limitations, and production status.]

## Next steps

[List realistic improvements rather than generic future work.]`,

            Homelab: `## Overview

[Explain the infrastructure goal and the capability this lab provides.]

## Requirements and constraints

- Workloads:
- Availability target:
- Hardware / power / budget constraints:

## Architecture

[Describe services, trust boundaries, segmentation, and data flow using public-safe details.]

## Implementation

[Document provisioning, configuration management, storage, and deployment choices.]

## Security and privacy

[Explain hardening, access control, secret handling, and backup boundaries without publishing live operational details.]

## Monitoring and validation

[Describe health checks, logging, failure tests, and recovery verification.]

## Outcome

[Summarize reliability, learning value, and current limitations.]

## Lessons learned

[Record tradeoffs and the next planned improvement.]`,

            Team: `## Overview

[Summarize the challenge, event, team, and final outcome.]

## Problem and constraints

[Explain the brief, deadline, rules, and success criteria.]

## My role

[State your ownership and distinguish your work from the team's work.]

## Team approach

[Describe responsibilities, collaboration, and major decisions.]

## Implementation

[Explain the work you personally contributed and the evidence supporting it.]

## Outcome

[Include the delivered result, evaluation, award, or measurable impact.]

## Lessons learned

[Reflect on technical and collaboration lessons.]`,

            Blog: `## Context

[Introduce the question, event, or problem that motivated the article.]

## Key idea

[State the central argument or technical insight.]

## Walkthrough

[Explain the process in clear, reproducible steps.]

## Observations

[Discuss evidence, tradeoffs, failures, and limitations.]

## Takeaways

- [Practical conclusion]
- [Important limitation]
- [Next experiment or question]

## References

- [Primary documentation or source]`,

            Page: `## Purpose

[Explain what this page helps the visitor understand or do.]

## Main information

[Add the primary content in short, scannable sections.]

## Details

[Add supporting context, constraints, or frequently needed information.]

## Next step

[Provide one clear action or destination when appropriate.]`
        };

        window.insertPortfolioContentTemplate = editor => {
            const template = window.portfolioContentTemplates[window.portfolioEditorContext];
            if (!template) return;

            const currentContent = editor.value();
            if (currentContent.trim().length > 0 &&
                !window.confirm('Insert the structured template at the current cursor without replacing existing content?')) {
                return;
            }

            if (currentContent.trim().length === 0) {
                editor.value(template);
            } else {
                const document = editor.codemirror.getDoc();
                document.replaceRange(`\n\n${template}`, document.getCursor());
            }

            editor.codemirror.focus();
        };

        window.portfolioMarkdownToolbar = [
            'bold', 'italic', 'strikethrough', 'heading', '|',
            'quote', 'code', 'unordered-list', 'ordered-list', '|',
            'link', 'image', 'table', 'horizontal-rule', '|',
            {
                name: 'structured-template',
                action: window.insertPortfolioContentTemplate,
                className: 'fa fa-list-alt',
                title: 'Insert a structured content template'
            }, '|',
            'preview', 'side-by-side', 'fullscreen'
        ];

        window.createPortfolioMarkdownEditor = options => {
            const editor = new EasyMDE(options);
            const sourceElement = options.element;
            const form = sourceElement?.closest('form');
            if (!form) return editor;

            const requiredTextFields = [
                { name: 'Title', message: 'Title is required.' },
                { name: 'Summary', message: 'Summary is required.' }
            ];
            if (window.portfolioEditorContext === 'Team') {
                requiredTextFields.push({ name: 'MyRole', message: 'My role is required.' });
            }

            const setFieldError = (field, message) => {
                const validationMessage = form.querySelector(`[data-valmsg-for="${field.name}"]`);
                const isEmpty = field.value.trim().length === 0;
                if (isEmpty) {
                    field.dataset.requiredInvalid = 'true';
                    field.classList.add('input-validation-error');
                    field.setAttribute('aria-invalid', 'true');
                } else if (field.dataset.requiredInvalid === 'true') {
                    delete field.dataset.requiredInvalid;
                    field.classList.remove('input-validation-error');
                    field.setAttribute('aria-invalid', 'false');
                }
                if (validationMessage && isEmpty) {
                    validationMessage.textContent = isEmpty ? message : '';
                    validationMessage.classList.add('field-validation-error');
                    validationMessage.classList.remove('field-validation-valid');
                } else if (validationMessage?.textContent === message) {
                    validationMessage.textContent = '';
                    validationMessage.classList.remove('field-validation-error');
                    validationMessage.classList.add('field-validation-valid');
                }
                return isEmpty;
            };

            form.addEventListener('submit', event => {
                editor.codemirror.save();
                let firstInvalidField = null;

                requiredTextFields.forEach(requiredField => {
                    const field = form.elements.namedItem(requiredField.name);
                    if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement)) return;
                    if (setFieldError(field, requiredField.message) && !firstInvalidField) firstInvalidField = field;
                });

                const contentIsEmpty = editor.value().trim().length === 0;
                const editorContainer = sourceElement.nextElementSibling?.classList.contains('EasyMDEContainer')
                    ? sourceElement.nextElementSibling
                    : sourceElement.parentElement?.querySelector('.EasyMDEContainer');
                const contentValidationMessage = form.querySelector('[data-valmsg-for="Content"]');
                if (contentIsEmpty) {
                    editorContainer?.classList.add('markdown-validation-error');
                    sourceElement.dataset.requiredInvalid = 'true';
                    sourceElement.setAttribute('aria-invalid', 'true');
                    if (contentValidationMessage) {
                        contentValidationMessage.textContent = 'Content is required.';
                        contentValidationMessage.classList.add('field-validation-error');
                        contentValidationMessage.classList.remove('field-validation-valid');
                    }
                } else if (sourceElement.dataset.requiredInvalid === 'true') {
                    editorContainer?.classList.remove('markdown-validation-error');
                    delete sourceElement.dataset.requiredInvalid;
                    sourceElement.setAttribute('aria-invalid', 'false');
                    if (contentValidationMessage?.textContent === 'Content is required.') {
                        contentValidationMessage.textContent = '';
                        contentValidationMessage.classList.remove('field-validation-error');
                        contentValidationMessage.classList.add('field-validation-valid');
                    }
                }

                if (!firstInvalidField && contentIsEmpty) firstInvalidField = sourceElement;
                if (!firstInvalidField) return;

                event.preventDefault();
                if (firstInvalidField === sourceElement) editor.codemirror.focus();
                else firstInvalidField.focus();
                firstInvalidField.scrollIntoView({ behavior: 'smooth', block: 'center' });
            });

            editor.codemirror.on('change', () => {
                if (editor.value().trim().length === 0) return;
                const editorContainer = sourceElement.nextElementSibling?.classList.contains('EasyMDEContainer')
                    ? sourceElement.nextElementSibling
                    : sourceElement.parentElement?.querySelector('.EasyMDEContainer');
                const contentValidationMessage = form.querySelector('[data-valmsg-for="Content"]');
                editorContainer?.classList.remove('markdown-validation-error');
                sourceElement.setAttribute('aria-invalid', 'false');
                if (contentValidationMessage?.textContent === 'Content is required.') {
                    contentValidationMessage.textContent = '';
                    contentValidationMessage.classList.remove('field-validation-error');
                    contentValidationMessage.classList.add('field-validation-valid');
                }
            });

            return editor;
        };

        const adminSidebar = document.getElementById('adminSidebar');
        const adminSidebarOverlay = document.getElementById('adminSidebarOverlay');
        const adminMenuButton = document.getElementById('adminMenuButton');
        let adminMenuPreviousFocus = null;

        function trapAdminMenuFocus(event) {
            const focusableElements = Array.from(adminSidebar.querySelectorAll(
                'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
            )).filter(element => element.offsetParent !== null);
            if (focusableElements.length === 0) return;

            const firstElement = focusableElements[0];
            const lastElement = focusableElements[focusableElements.length - 1];
            if (event.shiftKey && document.activeElement === firstElement) {
                event.preventDefault();
                lastElement.focus();
            } else if (!event.shiftKey && document.activeElement === lastElement) {
                event.preventDefault();
                firstElement.focus();
            }
        }

        function setAdminMenu(open) {
            const isMobile = window.innerWidth < 1024;
            if (open && isMobile) adminMenuPreviousFocus = document.activeElement;
            adminSidebar.classList.toggle('-translate-x-full', !open);
            adminSidebarOverlay.classList.toggle('hidden', !open);
            adminMenuButton.setAttribute('aria-expanded', String(open));
            document.body.classList.toggle('overflow-hidden', open && isMobile);

            if (open && isMobile) {
                window.setTimeout(() => document.getElementById('adminMenuClose').focus(), 0);
            } else if (!open && adminMenuPreviousFocus) {
                adminMenuPreviousFocus.focus();
                adminMenuPreviousFocus = null;
            }
        }

        adminMenuButton.addEventListener('click', () => setAdminMenu(true));
        document.getElementById('adminMenuClose').addEventListener('click', () => setAdminMenu(false));
        adminSidebarOverlay.addEventListener('click', () => setAdminMenu(false));
        document.addEventListener('keydown', event => {
            const menuIsOpen = window.innerWidth < 1024 && !adminSidebar.classList.contains('-translate-x-full');
            if (menuIsOpen && event.key === 'Escape') setAdminMenu(false);
            else if (menuIsOpen && event.key === 'Tab') trapAdminMenuFocus(event);
        });

        document.querySelectorAll('.admin-toast').forEach(toast => {
            window.setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translateY(8px)'; }, 3200);
        });

        document.addEventListener('DOMContentLoaded', () => {
            const markdownEditor = document.getElementById('content-editor');
            const editorContainer = document.querySelector('.EasyMDEContainer');
            if (!markdownEditor || !editorContainer || document.getElementById('markdownSyntaxGuide')) return;

            editorContainer.insertAdjacentHTML('afterend', `
                <details id="markdownSyntaxGuide" class="mt-3 border border-line bg-ink/50 p-4 text-xs text-slate-400">
                    <summary class="focus-ring cursor-pointer select-none font-medium text-slate-300">Markdown formatting reference</summary>
                    <div class="mt-4 grid gap-2 font-mono text-[11px] sm:grid-cols-2 xl:grid-cols-3">
                        <code># Heading</code><code>## Subheading</code><code>**bold**</code>
                        <code>*italic*</code><code>~~strikethrough~~</code><code>&gt; quote</code>
                        <code>- list item</code><code>[label](https://...)</code><code>&#96;&#96;&#96; code block</code>
                    </div>
                    <p class="mt-4 leading-5 text-slate-600">The structured-template toolbar button inserts a category-specific case-study outline. The toolbar also supports images, tables, dividers, code, and live preview. Raw HTML is disabled for security. A line beginning with # creates a heading; hashtag metadata is not connected to these editors yet.</p>
                </details>
            `);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
