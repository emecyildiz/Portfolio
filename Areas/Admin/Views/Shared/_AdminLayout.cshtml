<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1E3A5F',
                        secondary: '#2D6A9F',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen flex">

    <!-- Sidebar -->
    <!-- Sidebar -->
    <aside class="w-64 bg-gray-900 border-r border-gray-800 flex flex-col fixed h-full">
        <div class="p-6 border-b border-gray-800">
            <h1 class="text-lg font-bold text-white">Admin Panel</h1>
            <p class="text-xs text-gray-500 mt-1">Portfolio Yönetimi</p>
        </div>

        <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
            <a href="/money/dashboard"
               class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">
                Dashboard
            </a>
            <a href="/money/category"
               class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">
                Kategoriler
            </a>

            <div class="pt-2 pb-1">
                <p class="text-xs text-gray-600 px-3 uppercase tracking-wider">İçerikler</p>
            </div>

            @if (ViewBag.Categories != null)
            {
                foreach (var cat in (List<Portfolio.Models.Category>)ViewBag.Categories)
                {
                    var url = cat.Slug switch
                    {
                        "security" => "/money/security",
                        "electronics" => "/money/electronics",
                        "webapps" => "/money/webapps",
                        "homelab" => "/money/homelab",
                        "blog" => "/money/blog",
                        "team" => "/money/team",
                        "notes" => "/money/note",
                        "map" => "/money/category",  // ← map için kategori sayfasına yönlendir
                        _ => "/money/category"   // ← bilinmeyenler kategori listesine gitsin
                    };

                    <a href="@url"
                       class="flex items-center justify-between px-3 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">
                        <span>@cat.Name</span>
                        @if (cat.Status != Portfolio.Models.Enums.VisibilityStatus.Public)
                        {
                            <span class="text-xs text-gray-600">gizli</span>
                        }
                    </a>
                }
            }

            <div class="pt-2 pb-1">
                <p class="text-xs text-gray-600 px-3 uppercase tracking-wider">Diğer</p>
            </div>

            <a href="/money/service"
               class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">
                Hizmetler
            </a>
            <a href="/money/message"
               class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition">
                Mesajlar
            </a>
        </nav>

        <div class="p-4 border-t border-gray-800">
            <form method="post" action="/money/account/logout">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="w-full px-3 py-2 text-sm text-gray-400 hover:text-red-400 hover:bg-gray-800 rounded-lg transition text-left">
                    Çıkış Yap
                </button>
            </form>
        </div>
    </aside>

    <!-- Ana içerik -->
    <main class="ml-64 flex-1 p-8">
        @RenderBody()
    </main>
    <!-- Toast bildirimleri -->
    @if (TempData["Success"] != null)
    {
        <div id="toast"
             class="fixed top-4 right-4 bg-green-900/90 border border-green-700 text-green-300 text-sm px-5 py-3 rounded-xl shadow-lg z-50 flex items-center gap-2">
            <span>✓</span> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div id="toast"
             class="fixed top-4 right-4 bg-red-900/90 border border-red-700 text-red-300 text-sm px-5 py-3 rounded-xl shadow-lg z-50 flex items-center gap-2">
            <span>✕</span> @TempData["Error"]
        </div>
    }
    <script>
        const toast = document.getElementById('toast');
        if (toast) setTimeout(() => toast.style.opacity = '0', 3000);
    </script>

</body>
</html>