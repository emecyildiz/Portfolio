@model Portfolio.Models.Category
@{
    ViewData["Title"] = "New Category";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Content structure</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">New category</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Create a section record. A new public category needs a matching controller and route before it can become a working public section.</p>
    </div>
    <a href="@Url.Action("Index", "Category", new { area = "Admin" })" class="focus-ring w-fit border border-line px-4 py-2.5 text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Back to categories</a>
</div>

<form method="post" class="max-w-5xl">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly"></div>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(18rem,.7fr)]">
        <section class="admin-surface p-5 sm:p-6" aria-labelledby="category-content-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Section identity</p>
            <h3 id="category-content-heading" class="mt-2 text-lg font-semibold text-white">Core information</h3>

            <div class="mt-6 space-y-5">
                <div>
                    <label asp-for="Name" class="admin-label">Name</label>
                    <input asp-for="Name" class="admin-input" autocomplete="off" placeholder="Electronics and microcontrollers" />
                    <span asp-validation-for="Name"></span>
                </div>

                <div>
                    <label asp-for="Slug" class="admin-label">Slug</label>
                    <input asp-for="Slug" class="admin-input font-mono" autocomplete="off" aria-describedby="category-slug-help" placeholder="electronics" />
                    <p id="category-slug-help" class="admin-hint">Use lowercase letters, numbers, and hyphens. Built-in section slugs are protected because public routes depend on them.</p>
                    <span asp-validation-for="Slug"></span>
                </div>

                <div>
                    <label asp-for="Description" class="admin-label">Description</label>
                    <textarea asp-for="Description" rows="5" class="admin-textarea" aria-describedby="category-description-help" placeholder="A concise description of the work collected in this section."></textarea>
                    <p id="category-description-help" class="admin-hint">Used as supporting copy where the section is introduced.</p>
                    <span asp-validation-for="Description"></span>
                </div>
            </div>
        </section>

        <aside class="admin-surface h-fit p-5 sm:p-6" aria-labelledby="category-settings-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Configuration</p>
            <h3 id="category-settings-heading" class="mt-2 text-lg font-semibold text-white">Display settings</h3>

            <div class="mt-6 space-y-5">
                <div>
                    <label asp-for="IconClass" class="admin-label">Icon class</label>
                    <input asp-for="IconClass" class="admin-input font-mono" autocomplete="off" placeholder="ti ti-cpu" />
                    <span asp-validation-for="IconClass"></span>
                </div>

                <div>
                    <label asp-for="SortOrder" class="admin-label">Sort order</label>
                    <input asp-for="SortOrder" type="number" class="admin-input" inputmode="numeric" />
                    <span asp-validation-for="SortOrder"></span>
                </div>

                <label class="flex cursor-pointer items-start gap-3 border border-line bg-ink/50 p-4">
                    <input asp-for="IsPrivate" type="checkbox" class="admin-checkbox mt-0.5 shrink-0" />
                    <span>
                        <span class="block text-sm font-medium text-slate-300">Private section</span>
                        <span class="mt-1 block text-xs leading-5 text-slate-600">Visible only in the admin console. Direct public requests return 404.</span>
                    </span>
                </label>
            </div>
        </aside>
    </div>

    <div class="mt-6 flex flex-col-reverse gap-3 border-t border-line pt-5 sm:flex-row sm:justify-end">
        <a href="@Url.Action("Index", "Category", new { area = "Admin" })" class="focus-ring border border-line px-5 py-2.5 text-center text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Cancel</a>
        <button type="submit" class="focus-ring bg-signal px-6 py-2.5 text-sm font-semibold text-ink transition hover:bg-white">Create category</button>
    </div>
</form>
