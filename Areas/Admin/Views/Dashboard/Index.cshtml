@model Portfolio.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-8">
    <h2 class="text-2xl font-bold text-white">Dashboard</h2>
    <p class="text-gray-500 mt-1">Welcome back.</p>
</div>

<div class="grid grid-cols-4 gap-4 mb-8">
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
        <p class="text-sm text-gray-500">Projects</p>
        <p class="text-3xl font-bold text-white mt-1">@Model.ProjectCount</p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
        <p class="text-sm text-gray-500">Security Research</p>
        <p class="text-3xl font-bold text-white mt-1">@Model.SecurityCount</p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
        <p class="text-sm text-gray-500">Blog Posts</p>
        <p class="text-3xl font-bold text-white mt-1">@Model.BlogCount</p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
        <p class="text-sm text-gray-500">Unread Messages</p>
        <p class="text-3xl font-bold text-white mt-1">@Model.UnreadMessages</p>
    </div>
</div>

@{
    var pageViews = ViewBag.PageViewsLast7Days as IEnumerable<dynamic>;
    var maxCount = pageViews != null && pageViews.Any() ? pageViews.Max(p => (int)p.Count) : 1;
}
@if (pageViews != null && pageViews.Any())
{
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-8">
        <h3 class="text-sm font-medium text-gray-400 mb-4">Visitors — Last 7 Days</h3>
        <div class="flex items-end gap-2 h-32">
            @foreach (var day in pageViews)
            {
                var heightPercent = maxCount > 0 ? (int)day.Count * 100 / maxCount : 0;
                <div class="flex-1 flex flex-col items-center gap-2">
                    <div class="w-full bg-blue-600 rounded-t" style="height: @(heightPercent)%; min-height: 4px;"></div>
                    <span class="text-xs text-gray-600">@(((DateTime)day.Date).ToString("dd/MM"))</span>
                    <span class="text-xs text-gray-500">@day.Count</span>
                </div>
            }
        </div>
    </div>
}

@{
    var topCountries = ViewBag.TopCountries as IEnumerable<dynamic>;
}
@if (topCountries != null && topCountries.Any())
{
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
        <h3 class="text-sm font-medium text-gray-400 mb-4">Countries — Last 30 Days</h3>
        <div class="space-y-2">
            @foreach (var c in topCountries)
            {
                <div class="flex items-center justify-between text-sm">
                    <span class="text-gray-300">@c.Country</span>
                    <span class="text-gray-500">@c.Count @(c.Count == 1 ? "visit" : "visits")</span>
                </div>
            }
        </div>
    </div>
}

<!-- Category statuses -->
<div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
    <h3 class="text-sm font-medium text-gray-400 mb-4">Section Statuses</h3>
    <div class="space-y-2">
        @foreach (var cat in Model.RecentCategories)
        {
            <div class="flex items-center justify-between">
                <span class="text-sm text-gray-300">@cat.Name</span>
                @if (cat.Status == Portfolio.Models.Enums.VisibilityStatus.Public)
                {
                    <span class="text-xs bg-green-900/40 text-green-400 px-2 py-0.5 rounded-full">Public</span>
                }
                else
                {
                    <span class="text-xs bg-gray-800 text-gray-500 px-2 py-0.5 rounded-full">Hidden</span>
                }
            </div>
        }
    </div>
</div>
