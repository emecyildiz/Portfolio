@model Portfolio.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var pageViews = ViewBag.PageViewsLast7Days as IEnumerable<dynamic>;
    var hasPageViews = pageViews != null && pageViews.Any();
    var maxCount = hasPageViews ? pageViews!.Max(p => (int)p.Count) : 1;
    var topCountries = ViewBag.TopCountries as IEnumerable<dynamic>;
    var hasCountries = topCountries != null && topCountries.Any();
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Control center</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Admin overview</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">A current snapshot of portfolio content, traffic and incoming communication.</p>
    </div>
    <div class="inline-flex w-fit items-center gap-2 border border-signal/20 bg-signal/5 px-3 py-2 font-mono text-[11px] uppercase tracking-[0.15em] text-signal">
        <span class="h-2 w-2 rounded-full bg-signal shadow-[0_0_12px_rgba(157,255,32,.65)]" aria-hidden="true"></span>
        System operational
    </div>
</div>

<section class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Portfolio statistics">
    <article class="admin-surface group relative overflow-hidden p-5">
        <span class="absolute inset-x-0 top-0 h-px bg-signal" aria-hidden="true"></span>
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-500">Projects</p>
                <p class="mt-3 text-4xl font-semibold tracking-[-0.04em] text-white">@Model.ProjectCount</p>
            </div>
            <span class="font-mono text-xs text-signal">PRJ</span>
        </div>
    </article>

    <article class="admin-surface group relative overflow-hidden p-5">
        <span class="absolute inset-x-0 top-0 h-px bg-cyan" aria-hidden="true"></span>
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-500">Security research</p>
                <p class="mt-3 text-4xl font-semibold tracking-[-0.04em] text-white">@Model.SecurityCount</p>
            </div>
            <span class="font-mono text-xs text-cyan">SEC</span>
        </div>
    </article>

    <article class="admin-surface group relative overflow-hidden p-5">
        <span class="absolute inset-x-0 top-0 h-px bg-ember" aria-hidden="true"></span>
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-500">Blog posts</p>
                <p class="mt-3 text-4xl font-semibold tracking-[-0.04em] text-white">@Model.BlogCount</p>
            </div>
            <span class="font-mono text-xs text-ember">LOG</span>
        </div>
    </article>

    <article class="admin-surface group relative overflow-hidden p-5">
        <span class="absolute inset-x-0 top-0 h-px bg-red-400" aria-hidden="true"></span>
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-500">Unread messages</p>
                <p class="mt-3 text-4xl font-semibold tracking-[-0.04em] text-white">@Model.UnreadMessages</p>
            </div>
            <span class="font-mono text-xs text-red-300">MSG</span>
        </div>
    </article>
</section>

<div class="mb-8 grid gap-6 xl:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)]">
    <section class="admin-surface p-5 sm:p-6" aria-labelledby="traffic-heading">
        <div class="mb-6 flex items-start justify-between gap-4">
            <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-slate-500">Traffic pulse</p>
                <h3 id="traffic-heading" class="mt-2 text-lg font-semibold text-white">Visitors · Last 7 days</h3>
            </div>
            <span class="border border-line bg-ink px-2 py-1 font-mono text-[10px] uppercase tracking-[0.14em] text-slate-500">Daily</span>
        </div>

        @if (hasPageViews)
        {
            <div class="flex h-52 items-end gap-2 sm:gap-4" role="img" aria-label="Daily visitor counts for the last seven days">
                @foreach (var day in pageViews!)
                {
                    var count = (int)day.Count;
                    var date = (DateTime)day.Date;
                    var heightPercent = maxCount > 0 ? count * 100 / maxCount : 0;
                    <div class="flex h-full min-w-0 flex-1 flex-col justify-end gap-2 text-center">
                        <span class="font-mono text-[10px] text-slate-400">@count</span>
                        <div class="group relative flex flex-1 items-end border-b border-line">
                            <div class="w-full bg-gradient-to-t from-signal/45 to-signal transition group-hover:from-cyan/50 group-hover:to-cyan"
                                 style="height: @(heightPercent)%; min-height: 4px;"
                                 title="@date.ToString("MMM dd"): @count @(count == 1 ? "visitor" : "visitors")"></div>
                        </div>
                        <span class="truncate font-mono text-[10px] text-slate-600 sm:text-[11px]">@date.ToString("dd/MM")</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex h-52 items-center justify-center border border-dashed border-line bg-ink/50 px-6 text-center">
                <div>
                    <p class="font-mono text-xs uppercase tracking-[0.16em] text-slate-500">No traffic data</p>
                    <p class="mt-2 text-sm text-slate-600">Visitor activity will appear here after it is recorded.</p>
                </div>
            </div>
        }
    </section>

    <section class="admin-surface p-5 sm:p-6" aria-labelledby="countries-heading">
        <div class="mb-6">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-slate-500">Geography</p>
            <h3 id="countries-heading" class="mt-2 text-lg font-semibold text-white">Countries · Last 30 days</h3>
        </div>

        @if (hasCountries)
        {
            <div class="divide-y divide-line">
                @foreach (var country in topCountries!)
                {
                    var count = (int)country.Count;
                    <div class="flex items-center justify-between gap-4 py-3 first:pt-0 last:pb-0">
                        <span class="min-w-0 truncate text-sm text-slate-300">@country.Country</span>
                        <span class="shrink-0 font-mono text-[11px] text-slate-500">@count @(count == 1 ? "visit" : "visits")</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex min-h-44 items-center justify-center border border-dashed border-line bg-ink/50 px-6 text-center">
                <div>
                    <p class="font-mono text-xs uppercase tracking-[0.16em] text-slate-500">No location data</p>
                    <p class="mt-2 text-sm text-slate-600">Resolved visitor countries will appear here.</p>
                </div>
            </div>
        }
    </section>
</div>

<section class="admin-surface p-5 sm:p-6" aria-labelledby="sections-heading">
    <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-slate-500">Content visibility</p>
            <h3 id="sections-heading" class="mt-2 text-lg font-semibold text-white">Section statuses</h3>
        </div>
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">Current configuration</span>
    </div>

    @if (Model.RecentCategories.Any())
    {
        <div class="grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 xl:grid-cols-3">
            @foreach (var category in Model.RecentCategories)
            {
                var isPublic = category.Status == Portfolio.Models.Enums.VisibilityStatus.Public;
                <div class="flex items-center justify-between gap-4 bg-panel px-4 py-3.5">
                    <span class="min-w-0 truncate text-sm text-slate-300">@category.Name</span>
                    @if (isPublic)
                    {
                        <span class="inline-flex shrink-0 items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.13em] text-signal">
                            <span class="h-1.5 w-1.5 rounded-full bg-signal" aria-hidden="true"></span>
                            Public
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex shrink-0 items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.13em] text-slate-600">
                            <span class="h-1.5 w-1.5 rounded-full bg-slate-600" aria-hidden="true"></span>
                            Hidden
                        </span>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="border border-dashed border-line bg-ink/50 px-6 py-10 text-center text-sm text-slate-600">No content sections are configured.</div>
    }
</section>
