@model Portfolio.Models.ContactMessage
@{
    ViewData["Title"] = "Mesaj Detayı";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-8 flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-bold text-white">Mesaj Detayı</h2>
        <p class="text-gray-500 mt-1">@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</p>
    </div>
    <a href="@Url.Action("Index", "Message", new { area = "Admin" })"
       class="border border-gray-700 text-gray-400 hover:bg-gray-800 text-sm px-4 py-2 rounded-lg transition">
        ← Geri
    </a>
</div>

<div class="max-w-2xl space-y-4">
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4">
        <div class="grid grid-cols-2 gap-4">
            <div>
                <p class="text-xs text-gray-500 mb-1">Gönderen</p>
                <p class="text-white font-medium">@Model.Name</p>
            </div>
            <div>
                <p class="text-xs text-gray-500 mb-1">E-posta</p>
                <a href="mailto:@Model.Email" class="text-blue-400 hover:text-blue-300 text-sm">@Model.Email</a>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Subject))
        {
            <div>
                <p class="text-xs text-gray-500 mb-1">Konu</p>
                <p class="text-white">@Model.Subject</p>
            </div>
        }

        @if (Model.Service != null)
        {
            <div>
                <p class="text-xs text-gray-500 mb-1">İlgilendiği Hizmet</p>
                <p class="text-white">@Model.Service.Title</p>
            </div>
        }

        <div>
            <p class="text-xs text-gray-500 mb-2">Mesaj</p>
            <div class="bg-gray-800 rounded-lg p-4 text-gray-300 text-sm leading-relaxed whitespace-pre-wrap">
                @Model.Message
            </div>
        </div>
    </div>

    <!-- Durum değiştir -->
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
        <p class="text-sm font-medium text-gray-400 mb-4">Durum Değiştir</p>
        <div class="flex flex-wrap gap-2">
            @foreach (var status in Enum.GetValues<Portfolio.Models.Enums.ContactStatus>())
            {
                <form method="post" action="@Url.Action("MarkStatus", "Message", new { area = "Admin" })">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="status" value="@status" />
                    <button type="submit"
                            class="text-xs px-3 py-1.5 rounded-lg border transition
                                @(Model.Status == status
                                                            ? "border-blue-600 text-blue-400 bg-blue-900/30"
                                                            : "border-gray-700 text-gray-400 hover:bg-gray-800")">
                    @status
                </button>
            </form>
                        }
        </div>
    </div>

    <form method="post" action="@Url.Action("Delete", "Message", new { area = "Admin", id = Model.Id })"
          onsubmit="return confirm('Bu mesajı silmek istediğine emin misin?')">
        @Html.AntiForgeryToken()
        <button type="submit"
                class="w-full border border-red-900 text-red-400 hover:bg-red-900/30 text-sm py-2.5 rounded-lg transition">
            Mesajı Sil
        </button>
    </form>
</div>