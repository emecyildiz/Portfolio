@model Portfolio.Models.ContactMessage
@{
    ViewData["Title"] = "Message Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var statusClass = Model.Status switch
    {
        Portfolio.Models.Enums.ContactStatus.New => "border-cyan/20 bg-cyan/[0.06] text-cyan",
        Portfolio.Models.Enums.ContactStatus.Read => "border-line text-slate-400",
        Portfolio.Models.Enums.ContactStatus.Replied => "border-signal/20 bg-signal/[0.05] text-signal",
        Portfolio.Models.Enums.ContactStatus.Archived => "border-line text-slate-600",
        Portfolio.Models.Enums.ContactStatus.Spam => "border-rose-300/20 bg-rose-300/[0.06] text-rose-300",
        _ => "border-line text-slate-400"
    };
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Request inbox</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Message details</h2>
        <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.1em] text-slate-600">Ticket @Model.TicketNumber</p>
    </div>
    <a href="@Url.Action("Index", "Message", new { area = "Admin" })" class="focus-ring w-fit border border-line px-4 py-2.5 text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Back to messages</a>
</div>

<aside class="mb-6 max-w-6xl border border-violet-300/15 bg-violet-300/[0.04] px-4 py-3 font-mono text-[10px] uppercase tracking-[0.11em] text-violet-200/70" aria-label="Data sensitivity notice">
    Sensitive data · Handle sender identity, message content and request metadata as private information
</aside>

<div class="grid max-w-6xl gap-6 xl:grid-cols-[minmax(0,1fr)_21rem]">
    <main class="space-y-6">
        <section class="admin-surface p-5 sm:p-6" aria-labelledby="sender-heading">
            <div class="flex flex-col gap-4 border-b border-line pb-5 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Sender</p>
                    <h3 id="sender-heading" class="mt-2 text-xl font-semibold text-white">@Model.Name</h3>
                    <a href="mailto:@Model.Email" class="focus-ring mt-1 inline-block text-sm text-cyan transition hover:text-white">@Model.Email</a>
                </div>
                <span class="inline-flex w-fit border px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.12em] @statusClass">@Model.Status</span>
            </div>

            <dl class="grid gap-5 py-5 sm:grid-cols-2">
                <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">Subject</dt>
                    <dd class="mt-2 text-sm text-slate-300">@(string.IsNullOrWhiteSpace(Model.Subject) ? "Not provided" : Model.Subject)</dd>
                </div>
                <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">Service of interest</dt>
                    <dd class="mt-2 text-sm text-slate-300">@(Model.Service?.Title ?? "Not selected")</dd>
                </div>
                <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">Received</dt>
                    <dd class="mt-2 font-mono text-[11px] text-slate-500">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</dd>
                </div>
                <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">Read state</dt>
                    <dd class="mt-2 text-sm text-slate-300">@(Model.IsRead ? "Read" : "Unread")</dd>
                </div>
            </dl>
        </section>

        <section class="admin-surface p-5 sm:p-6" aria-labelledby="message-content-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Submitted content</p>
            <h3 id="message-content-heading" class="mt-2 text-lg font-semibold text-white">Message</h3>
            <div class="mt-5 whitespace-pre-wrap break-words border border-line bg-ink/60 p-4 text-sm leading-7 text-slate-300 sm:p-5">@Model.Message</div>
        </section>
    </main>

    <aside class="h-fit space-y-6 xl:sticky xl:top-6">
        <section class="admin-surface p-5" aria-labelledby="message-status-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Workflow</p>
            <h3 id="message-status-heading" class="mt-2 text-lg font-semibold text-white">Change status</h3>
            <div class="mt-5 grid grid-cols-2 gap-2">
                @foreach (var status in Enum.GetValues<Portfolio.Models.Enums.ContactStatus>())
                {
                    var isCurrent = Model.Status == status;
                    <form method="post" action="@Url.Action("MarkStatus", "Message", new { area = "Admin" })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@status" />
                        <button type="submit"
                                disabled="@(isCurrent ? "disabled" : null)"
                                class="focus-ring w-full border px-3 py-2 text-xs transition @(isCurrent ? "cursor-default border-signal/25 bg-signal/[0.06] text-signal" : "border-line text-slate-400 hover:border-slate-500 hover:text-white")">
                            @status
                        </button>
                    </form>
                }
            </div>
        </section>

        <section class="admin-surface p-5" aria-labelledby="request-metadata-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Diagnostics</p>
            <h3 id="request-metadata-heading" class="mt-2 text-lg font-semibold text-white">Request metadata</h3>
            <dl class="mt-5 space-y-4">
                <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">IP address</dt>
                    <dd class="mt-1 break-all font-mono text-[11px] text-slate-400">@(Model.IpAddress ?? "Not recorded")</dd>
                </div>
                <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">User agent</dt>
                    <dd class="mt-1 break-all text-xs leading-5 text-slate-500">@(Model.UserAgent ?? "Not recorded")</dd>
                </div>
            </dl>
        </section>

        <form method="post" action="@Url.Action("Delete", "Message", new { area = "Admin", id = Model.Id })" onsubmit="return confirm('Delete this message permanently? This action cannot be undone.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="focus-ring w-full border border-rose-300/20 px-5 py-3 text-sm text-rose-300 transition hover:bg-rose-300/10">Delete message</button>
        </form>
    </aside>
</div>
