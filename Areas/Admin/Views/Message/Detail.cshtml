@model Portfolio.Models.ContactMessage
@{
    ViewData["Title"] = "Message Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var statusClass = Model.Status switch
    {
        Portfolio.Models.Enums.ContactStatus.New => "border-cyan/20 bg-cyan/[0.06] text-cyan",
        Portfolio.Models.Enums.ContactStatus.Read => "border-line text-slate-400",
        Portfolio.Models.Enums.ContactStatus.Replied => "border-signal/20 bg-signal/[0.05] text-signal",
        Portfolio.Models.Enums.ContactStatus.Archived => "border-line text-slate-600",
        Portfolio.Models.Enums.ContactStatus.Spam => "border-rose-300/20 bg-rose-300/[0.06] text-rose-300",
        _ => "border-line text-slate-400"
    };
    var confirmationEmail = Model.EmailOutboxItems
        .FirstOrDefault(item =>
            item.Kind == Portfolio.Models.TicketEmailKinds.TicketReceived);
    var confirmationEmailState = confirmationEmail switch
    {
        { SentAt: not null } => "Sent",
        { FailedAt: not null } => "Failed",
        not null => "Queued",
        _ => "Not queued"
    };
    var replyEmails = Model.EmailOutboxItems
        .Where(item => item.Kind == Portfolio.Models.TicketEmailKinds.TicketReply)
        .OrderByDescending(item => item.CreatedAt)
        .ToList();
    var replyBody = ViewData["ReplyBody"] as string ?? string.Empty;
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Request inbox</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Message details</h2>
        <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.1em] text-slate-600">Ticket @Model.TicketNumber</p>
    </div>
    <a href="@Url.Action("Index", "Message", new { area = "Admin" })" class="focus-ring w-fit border border-line px-4 py-2.5 text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Back to messages</a>
</div>

<aside class="mb-6 max-w-6xl border border-violet-300/15 bg-violet-300/[0.04] px-4 py-3 font-mono text-[10px] uppercase tracking-[0.11em] text-violet-200/70" aria-label="Data sensitivity notice">
    Sensitive data · Handle sender identity, message content and request metadata as private information
</aside>

<div class="grid max-w-6xl gap-6 xl:grid-cols-[minmax(0,1fr)_21rem]">
    <main class="space-y-6">
        <section class="admin-surface p-5 sm:p-6" aria-labelledby="sender-heading">
            <div class="flex flex-col gap-4 border-b border-line pb-5 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Sender</p>
                    <h3 id="sender-heading" class="mt-2 text-xl font-semibold text-white">@Model.Name</h3>
                    <a href="mailto:@Model.Email" class="focus-ring mt-1 inline-block text-sm text-cyan transition hover:text-white">@Model.Email</a>
                </div>
                <span class="inline-flex w-fit border px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.12em] @statusClass">@Model.Status</span>
            </div>

            <dl class="grid gap-5 py-5 sm:grid-cols-2">
                <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">Subject</dt>
                    <dd class="mt-2 text-sm text-slate-300">@(string.IsNullOrWhiteSpace(Model.Subject) ? "Not provided" : Model.Subject)</dd>
                </div>
                <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">Service of interest</dt>
                    <dd class="mt-2 text-sm text-slate-300">@(Model.Service?.Title ?? "Not selected")</dd>
                </div>
                <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">Received</dt>
                    <dd class="mt-2 font-mono text-[11px] text-slate-500">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</dd>
                </div>
                <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">Read state</dt>
                    <dd class="mt-2 text-sm text-slate-300">@(Model.IsRead ? "Read" : "Unread")</dd>
                </div>
            </dl>
        </section>

        <section class="admin-surface p-5 sm:p-6" aria-labelledby="message-content-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Submitted content</p>
            <h3 id="message-content-heading" class="mt-2 text-lg font-semibold text-white">Message</h3>
            <div class="mt-5 whitespace-pre-wrap break-words border border-line bg-ink/60 p-4 text-sm leading-7 text-slate-300 sm:p-5">@Model.Message</div>
        </section>

        <section class="admin-surface p-5 sm:p-6" aria-labelledby="reply-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-cyan">Reply channel</p>
            <h3 id="reply-heading" class="mt-2 text-lg font-semibold text-white">Send an email reply</h3>
            <p class="mt-2 text-sm leading-6 text-slate-500">
                The reply is queued for delivery from <span class="font-mono text-slate-300">tickets@notify.emecworks.com</span>.
                The request changes to Replied only after Resend accepts the email.
            </p>

            <form method="post" action="@Url.Action("SendReply", "Message", new { area = "Admin" })" class="mt-5">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-4 border border-rose-300/20 bg-rose-300/[0.06] px-4 py-3 text-sm text-rose-200" role="alert">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }

                <label for="replyBody" class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-500">Reply</label>
                <textarea id="replyBody"
                          name="replyBody"
                          rows="9"
                          maxlength="5000"
                          required
                          disabled="@(Model.Status == Portfolio.Models.Enums.ContactStatus.Spam ? "disabled" : null)"
                          class="focus-ring mt-2 w-full resize-y border border-line bg-ink/60 px-4 py-3 text-sm leading-7 text-slate-200 placeholder:text-slate-700 disabled:cursor-not-allowed disabled:opacity-50"
                          placeholder="Write the response that the requester should receive.">@replyBody</textarea>
                <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-xs leading-5 text-slate-600">
                        Do not include passwords, private keys, API tokens, or other secrets.
                    </p>
                    <button type="submit"
                            disabled="@(Model.Status == Portfolio.Models.Enums.ContactStatus.Spam ? "disabled" : null)"
                            class="focus-ring shrink-0 border border-cyan/20 bg-cyan/[0.05] px-5 py-2.5 text-sm font-medium text-cyan transition hover:bg-cyan/[0.1] disabled:cursor-not-allowed disabled:opacity-50">
                        Queue reply
                    </button>
                </div>
            </form>
        </section>

        @if (replyEmails.Count > 0)
        {
            <section class="admin-surface p-5 sm:p-6" aria-labelledby="reply-history-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Delivery history</p>
                <h3 id="reply-history-heading" class="mt-2 text-lg font-semibold text-white">Replies</h3>
                <div class="mt-5 space-y-4">
                    @foreach (var reply in replyEmails)
                    {
                        var replyState = reply.SentAt != null
                            ? "Sent"
                            : reply.FailedAt != null
                                ? "Failed"
                                : "Queued";
                        var replyStateClass = reply.SentAt != null
                            ? "border-signal/20 text-signal"
                            : reply.FailedAt != null
                                ? "border-rose-300/20 text-rose-300"
                                : "border-cyan/20 text-cyan";

                        <article class="border border-line bg-ink/40 p-4 sm:p-5">
                            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                <div>
                                    <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">
                                        Queued @reply.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC
                                    </p>
                                    @if (reply.SentAt != null)
                                    {
                                        <p class="mt-1 font-mono text-[10px] text-slate-500">
                                            Sent @reply.SentAt.Value.ToString("dd MMM yyyy HH:mm") UTC
                                        </p>
                                    }
                                </div>
                                <span class="inline-flex w-fit border px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.12em] @replyStateClass">@replyState</span>
                            </div>
                            <div class="mt-4 whitespace-pre-wrap break-words text-sm leading-7 text-slate-300">@reply.Body</div>
                            <p class="mt-4 font-mono text-[10px] text-slate-600">
                                Attempts: @reply.AttemptCount
                                @if (reply.FailedAt != null)
                                {
                                    <span> · Error: @(reply.LastErrorCode ?? "unknown_error")</span>
                                }
                            </p>
                            @if (reply is { SentAt: null, FailedAt: not null })
                            {
                                <form method="post" action="@Url.Action("RetryReplyEmail", "Message", new { area = "Admin" })" class="mt-4">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="outboxId" value="@reply.Id" />
                                    <button type="submit" class="focus-ring border border-cyan/20 px-4 py-2 text-xs text-cyan transition hover:bg-cyan/[0.06]">
                                        Retry reply
                                    </button>
                                </form>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    </main>

    <aside class="h-fit space-y-6 xl:sticky xl:top-6">
        <section class="admin-surface p-5" aria-labelledby="message-status-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Workflow</p>
            <h3 id="message-status-heading" class="mt-2 text-lg font-semibold text-white">Change status</h3>
            <div class="mt-5 grid grid-cols-2 gap-2">
                @foreach (var status in Enum.GetValues<Portfolio.Models.Enums.ContactStatus>())
                {
                    if (status == Portfolio.Models.Enums.ContactStatus.Replied)
                    {
                        continue;
                    }
                    var isCurrent = Model.Status == status;
                    <form method="post" action="@Url.Action("MarkStatus", "Message", new { area = "Admin" })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@status" />
                        <button type="submit"
                                disabled="@(isCurrent ? "disabled" : null)"
                                class="focus-ring w-full border px-3 py-2 text-xs transition @(isCurrent ? "cursor-default border-signal/25 bg-signal/[0.06] text-signal" : "border-line text-slate-400 hover:border-slate-500 hover:text-white")">
                            @status
                        </button>
                    </form>
                }
            </div>
        </section>

        <section class="admin-surface p-5" aria-labelledby="request-metadata-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Diagnostics</p>
            <h3 id="request-metadata-heading" class="mt-2 text-lg font-semibold text-white">Request metadata</h3>
            <dl class="mt-5 space-y-4">
                <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">IP address</dt>
                    <dd class="mt-1 break-all font-mono text-[11px] text-slate-400">@(Model.IpAddress ?? "Not recorded")</dd>
                </div>
                <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">User agent</dt>
                    <dd class="mt-1 break-all text-xs leading-5 text-slate-500">@(Model.UserAgent ?? "Not recorded")</dd>
                </div>
            </dl>
        </section>

        <section class="admin-surface p-5" aria-labelledby="confirmation-email-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Delivery</p>
            <h3 id="confirmation-email-heading" class="mt-2 text-lg font-semibold text-white">Confirmation email</h3>
            <dl class="mt-5 space-y-4">
                <div>
                    <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">State</dt>
                    <dd class="mt-1 text-sm text-slate-300">@confirmationEmailState</dd>
                </div>
                @if (confirmationEmail != null)
                {
                    <div>
                        <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">Attempts</dt>
                        <dd class="mt-1 font-mono text-[11px] text-slate-400">@confirmationEmail.AttemptCount</dd>
                    </div>
                    @if (confirmationEmail.SentAt != null)
                    {
                        <div>
                            <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">Sent</dt>
                            <dd class="mt-1 font-mono text-[11px] text-slate-400">@confirmationEmail.SentAt.Value.ToString("dd MMM yyyy HH:mm") UTC</dd>
                        </div>
                    }
                    @if (confirmationEmail.FailedAt != null)
                    {
                        <div>
                            <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">Last error</dt>
                            <dd class="mt-1 font-mono text-[11px] text-rose-300">@(confirmationEmail.LastErrorCode ?? "unknown_error")</dd>
                        </div>
                    }
                }
            </dl>
            @if (confirmationEmail is { SentAt: null, FailedAt: not null })
            {
                <form method="post" action="@Url.Action("RetryConfirmationEmail", "Message", new { area = "Admin" })" class="mt-5">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="focus-ring w-full border border-cyan/20 px-4 py-2.5 text-sm text-cyan transition hover:bg-cyan/[0.06]">Retry confirmation email</button>
                </form>
            }
        </section>

        <form method="post" action="@Url.Action("Delete", "Message", new { area = "Admin", id = Model.Id })" onsubmit="return confirm('Delete this message permanently? This action cannot be undone.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="focus-ring w-full border border-rose-300/20 px-5 py-3 text-sm text-rose-300 transition hover:bg-rose-300/10">Delete message</button>
        </form>
    </aside>
</div>
