@model List<Portfolio.Models.ContactMessage>
@{
    ViewData["Title"] = "Messages";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var unreadCount = Model.Count(message => !message.IsRead);
}

<div class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Request inbox</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Messages</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Review incoming project requests and manage their processing status.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
        <span class="border border-cyan/20 bg-cyan/[0.05] px-3 py-2 font-mono text-[10px] uppercase tracking-[0.15em] text-cyan">@unreadCount unread</span>
        <span class="border border-line bg-panel px-3 py-2 font-mono text-[10px] uppercase tracking-[0.15em] text-slate-500">@Model.Count total</span>
    </div>
</div>

<aside class="mb-6 border border-violet-300/15 bg-violet-300/[0.04] px-4 py-3 font-mono text-[10px] uppercase tracking-[0.11em] text-violet-200/70" aria-label="Data sensitivity notice">
    Sensitive data · Messages may contain personal and project information
</aside>

<section class="admin-surface overflow-hidden" aria-labelledby="messages-table-heading">
    <h3 id="messages-table-heading" class="sr-only">Incoming message records</h3>
    @if (Model.Any())
    {
        <div class="overflow-x-auto">
            <table class="w-full min-w-[1100px] text-left text-sm">
                <thead class="border-b border-line bg-ink/55">
                    <tr>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Sender</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Subject</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Service</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Status</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Received</th>
                        <th scope="col" class="px-5 py-3.5 text-right font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                    @foreach (var message in Model)
                    {
                        var statusClass = message.Status switch
                        {
                            Portfolio.Models.Enums.ContactStatus.New => "border-cyan/20 bg-cyan/[0.06] text-cyan",
                            Portfolio.Models.Enums.ContactStatus.Read => "border-line text-slate-500",
                            Portfolio.Models.Enums.ContactStatus.Replied => "border-signal/20 bg-signal/[0.05] text-signal",
                            Portfolio.Models.Enums.ContactStatus.Archived => "border-line text-slate-600",
                            Portfolio.Models.Enums.ContactStatus.Spam => "border-rose-300/20 bg-rose-300/[0.06] text-rose-300",
                            _ => "border-line text-slate-500"
                        };
                        <tr class="transition hover:bg-white/[0.025] @(!message.IsRead ? "bg-cyan/[0.025]" : string.Empty)">
                            <td class="px-5 py-4">
                                <div class="flex items-start gap-2">
                                    @if (!message.IsRead)
                                    {
                                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan shadow-[0_0_8px_rgba(85,214,255,.7)]" aria-label="Unread"></span>
                                    }
                                    <div>
                                        <p class="font-medium text-white">@message.Name</p>
                                        <p class="mt-1 text-xs text-slate-500">@message.Email</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-5 py-4 text-xs text-slate-400">@(string.IsNullOrWhiteSpace(message.Subject) ? "Not provided" : message.Subject)</td>
                            <td class="px-5 py-4 text-xs text-slate-500">@(message.Service?.Title ?? "Not selected")</td>
                            <td class="px-5 py-4">
                                <span class="inline-flex border px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.11em] @statusClass">@message.Status</span>
                            </td>
                            <td class="px-5 py-4 font-mono text-[10px] uppercase tracking-[0.08em] text-slate-500">@message.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="px-5 py-4">
                                <div class="flex flex-wrap items-center justify-end gap-2">
                                    <a href="@Url.Action("Detail", "Message", new { area = "Admin", id = message.Id })" class="focus-ring border border-cyan/20 px-3 py-1.5 text-xs text-cyan transition hover:bg-cyan/10">Open</a>
                                    <form method="post" action="@Url.Action("Delete", "Message", new { area = "Admin", id = message.Id })" onsubmit="return confirm('Delete this message? This action cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="focus-ring border border-rose-300/20 px-3 py-1.5 text-xs text-rose-300 transition hover:bg-rose-300/10">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-16 text-center">
            <p class="font-mono text-xs uppercase tracking-[0.16em] text-slate-500">Inbox empty</p>
            <p class="mt-2 text-sm text-slate-600">New project requests will appear here.</p>
        </div>
    }
</section>
