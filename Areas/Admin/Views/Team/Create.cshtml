@model Portfolio.Models.TeamProject
@{
    ViewData["Title"] = "New Team Project";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-8">
    <h2 class="text-2xl font-bold text-white">New Team Project</h2>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css">
<script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>

<form method="post" enctype="multipart/form-data" id="mainForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="TeamMembersJson" id="teamMembersJson" />

    <div class="grid grid-cols-3 gap-6">
        <div class="col-span-2 space-y-4">
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4">
                <h3 class="text-sm font-medium text-gray-400">Content</h3>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Title</label>
                    <input asp-for="Title"
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500" />
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Summary</label>
                    <textarea asp-for="Summary" rows="2"
                              class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500"></textarea>
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Content (Markdown)</label>
                    <textarea asp-for="Content" id="content-editor"></textarea>
                </div>
            </div>

            <!-- Event information -->
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4">
                <h3 class="text-sm font-medium text-gray-400">Event Information</h3>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm text-gray-400 mb-1">Event Name</label>
                        <input asp-for="EventName"
                               class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500"
                               placeholder="Teknofest 2024" />
                    </div>
                    <div>
                        <label class="block text-sm text-gray-400 mb-1">Event Date</label>
                        <input asp-for="EventDate" type="date"
                               class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm text-gray-400 mb-1">My Role</label>
                        <input asp-for="MyRole"
                               class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500"
                               placeholder="Backend Dev & Security" />
                    </div>
                    <div>
                        <label class="block text-sm text-gray-400 mb-1">Outcome / Award</label>
                        <input asp-for="Outcome"
                               class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500"
                               placeholder="Second Place, Completed..." />
                    </div>
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Event URL</label>
                    <input asp-for="EventUrl"
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500"
                           placeholder="https://teknofest.org" />
                </div>
            </div>

            <!-- Team members -->
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-medium text-gray-400">Team Members</h3>
                    <button type="button" onclick="addMember()"
                            class="text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 px-3 py-1.5 rounded-lg transition">
                        + Add Member
                    </button>
                </div>

                <div id="members-container" class="space-y-3"></div>
            </div>

            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
                <h3 class="text-sm font-medium text-gray-400 mb-4">Images</h3>
                <input name="Images" type="file" multiple accept="image/*"
                       class="w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-gray-800 file:text-gray-300 hover:file:bg-gray-700" />
            </div>
        </div>

        <div class="space-y-4">
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4">
                <h3 class="text-sm font-medium text-gray-400">Settings</h3>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Status</label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.VisibilityStatus>()"
                            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500">
                    </select>
                </div>

                <label class="flex items-center gap-2 text-sm text-gray-400 cursor-pointer">
                    <input asp-for="IsFeatured" type="checkbox" class="w-4 h-4 rounded" />
                    Feature on the homepage
                </label>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">GitHub</label>
                    <input asp-for="GithubUrl"
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500" />
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Live Demo</label>
                    <input asp-for="LiveDemoUrl"
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500" />
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <button type="submit"
                        class="w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2.5 rounded-lg transition">
                    Save
                </button>
                <a href="@Url.Action("Index", "Team", new { area = "Admin" })"
                   class="w-full text-center border border-gray-700 text-gray-400 hover:bg-gray-800 text-sm py-2.5 rounded-lg transition">
                    Cancel
                </a>
            </div>
        </div>
    </div>
</form>

<script>
    let members = [];
    const htmlEscapeMap = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };

    function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, character => htmlEscapeMap[character]);
    }

    function addMember() {
        members.push({ Name: '', Role: '', GithubUrl: '', LinkedinUrl: '' });
        renderMembers();
    }

    function removeMember(index) {
        members.splice(index, 1);
        renderMembers();
    }

        function renderMembers() {
        const container = document.getElementById('members-container');
        container.innerHTML = members.map((m, i) => `
            <div class="bg-gray-800 rounded-lg p-4 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-gray-500">Member ${i + 1}</span>
                    <button type="button" onclick="removeMember(${i})"
                            class="text-xs text-red-400 hover:text-red-300">Remove</button>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <input placeholder="Full Name" value="${escapeHtml(m.Name || '')}"
                           oninput="members[${i}].Name = this.value"
                           class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500" />
                    <input placeholder="Role" value="${escapeHtml(m.Role || '')}"
                           oninput="members[${i}].Role = this.value"
                           class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500" />
                    <input placeholder="GitHub URL" value="${escapeHtml(m.GithubUrl || '')}"
                           oninput="members[${i}].GithubUrl = this.value"
                           class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500" />
                    <input placeholder="LinkedIn URL" value="${escapeHtml(m.LinkedinUrl || '')}"
                           oninput="members[${i}].LinkedinUrl = this.value"
                           class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-blue-500" />
                </div>
            </div>
        `).join('');
    }

    document.getElementById('mainForm').addEventListener('submit', function() {
        document.getElementById('teamMembersJson').value = JSON.stringify(members);
    });

    new EasyMDE({
        element: document.getElementById('content-editor'),
        spellChecker: false,
        autosave: { enabled: true, uniqueId: 'team-create' },
        toolbar: ['bold', 'italic', 'heading', '|', 'quote', 'unordered-list', 'ordered-list', '|', 'link', 'image', '|', 'preview', 'side-by-side', 'fullscreen']
    });
</script>
