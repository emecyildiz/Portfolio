@model Portfolio.Models.Note
@{
    ViewData["Title"] = "New Note";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/vendor/easymde/easymde.min.css" asp-append-version="true" />
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Private workspace</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">New note</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Capture a private reference or add an operational task.</p>
    </div>
    <a href="@Url.Action("Index", "Note", new { area = "Admin" })" class="focus-ring w-fit border border-line px-4 py-2.5 text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Back to notes</a>
</div>

<form method="post" class="max-w-6xl">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly"></div>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1.45fr)_minmax(19rem,.75fr)]">
        <section class="admin-surface p-5 sm:p-6" aria-labelledby="note-content-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Private material</p>
            <h3 id="note-content-heading" class="mt-2 text-lg font-semibold text-white">Note content</h3>

            <div class="mt-6 space-y-5">
                <div>
                    <label asp-for="Title" class="admin-label">Title</label>
                    <input asp-for="Title" class="admin-input" autocomplete="off" placeholder="Review firmware analysis notes" />
                    <span asp-validation-for="Title"></span>
                </div>

                <div>
                    <label asp-for="Content" class="admin-label">Content <span class="font-normal text-slate-600">(Markdown)</span></label>
                    <textarea asp-for="Content" id="content-editor" rows="16" placeholder="Private notes, commands, findings or next steps..."></textarea>
                    <p class="admin-hint">Local draft recovery and live Markdown preview are enabled.</p>
                    <span asp-validation-for="Content"></span>
                </div>
            </div>
        </section>

        <aside class="admin-surface h-fit p-5 sm:p-6" aria-labelledby="note-settings-heading">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Classification</p>
            <h3 id="note-settings-heading" class="mt-2 text-lg font-semibold text-white">Note settings</h3>

            <div class="mt-6 space-y-5">
                <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
                    <div>
                        <label asp-for="NoteType" class="admin-label">Note type</label>
                        <select asp-for="NoteType" asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.NoteType>()" class="admin-select"></select>
                        <span asp-validation-for="NoteType"></span>
                    </div>
                    <div>
                        <label asp-for="Priority" class="admin-label">Priority</label>
                        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.NotePriority>()" class="admin-select"></select>
                        <span asp-validation-for="Priority"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="RelatedUrl" class="admin-label">Related link <span class="font-normal text-slate-600">(optional)</span></label>
                    <input asp-for="RelatedUrl" class="admin-input font-mono" autocomplete="off" inputmode="url" pattern="(?:/(?!/).+|https://.+)" title="Use a root-relative path or an HTTPS URL." aria-describedby="related-url-help" placeholder="/electronics/project-slug or https://..." />
                    <p id="related-url-help" class="admin-hint">Optional private reference for this note. Use a root-relative path or trusted HTTPS URL.</p>
                    <span asp-validation-for="RelatedUrl"></span>
                </div>

                <label class="flex cursor-pointer items-start gap-3 border border-line bg-ink/50 p-4">
                    <input asp-for="IsTodo" type="checkbox" class="admin-checkbox mt-0.5 shrink-0" id="isTodoCheck" />
                    <span>
                        <span class="block text-sm font-medium text-slate-300">Add to task list</span>
                        <span class="mt-1 block text-xs leading-5 text-slate-600">Enables due-date tracking.</span>
                    </span>
                </label>

                <div id="todoFields" class="@(Model.IsTodo ? "" : "hidden") border-l border-cyan/25 pl-4">
                    <label asp-for="DueDate" class="admin-label">Due date <span class="font-normal text-slate-600">(optional)</span></label>
                    <input asp-for="DueDate" type="date" class="admin-input" />
                    <span asp-validation-for="DueDate"></span>
                </div>
            </div>
        </aside>
    </div>

    <div class="mt-6 flex flex-col-reverse gap-3 border-t border-line pt-5 sm:flex-row sm:justify-end">
        <a href="@Url.Action("Index", "Note", new { area = "Admin" })" class="focus-ring border border-line px-5 py-2.5 text-center text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Cancel</a>
        <button type="submit" class="focus-ring bg-signal px-6 py-2.5 text-sm font-semibold text-ink transition hover:bg-white">Create note</button>
    </div>
</form>

@section Scripts {
    <script src="~/vendor/easymde/easymde.min.js" asp-append-version="true"></script>
    <script>
        window.createPortfolioMarkdownEditor({
            element: document.getElementById('content-editor'),
            spellChecker: false,
            autoDownloadFontAwesome: false,
            autosave: { enabled: true, uniqueId: 'note-create' },
            toolbar: [
                'bold', 'italic', 'strikethrough', 'heading', '|',
                'quote', 'code', 'unordered-list', 'ordered-list', '|',
                'link', 'table', 'horizontal-rule', '|',
                'preview', 'side-by-side', 'fullscreen'
            ]
        });

        const isTodoCheck = document.getElementById('isTodoCheck');
        const todoFields = document.getElementById('todoFields');

        function syncTodoFields() {
            const enabled = isTodoCheck.checked;
            todoFields.classList.toggle('hidden', !enabled);
            todoFields.querySelectorAll('input, select, textarea').forEach(field => field.disabled = !enabled);
        }

        isTodoCheck.addEventListener('change', syncTodoFields);
        syncTodoFields();
    </script>
}
