@model Portfolio.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>Sign In — Admin Console</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tailwind.min.css" asp-append-version="true" />
    <style>
        body {
            background-color: #070b0f;
            background-image:
                linear-gradient(rgba(33, 48, 61, .16) 1px, transparent 1px),
                linear-gradient(90deg, rgba(33, 48, 61, .16) 1px, transparent 1px),
                radial-gradient(circle at 15% 20%, rgba(56, 217, 255, .08), transparent 30%),
                radial-gradient(circle at 85% 75%, rgba(157, 255, 32, .07), transparent 28%);
            background-size: 32px 32px, 32px 32px, auto, auto;
        }

        .focus-ring:focus-visible {
            outline: 2px solid #9dff20;
            outline-offset: 3px;
        }
    </style>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-auth admin-login min-h-screen font-sans text-slate-100 antialiased">
    <main class="mx-auto grid min-h-screen w-full max-w-7xl items-center gap-10 px-5 py-10 sm:px-8 lg:grid-cols-[1.1fr_.9fr] lg:px-12">
        <section class="max-w-2xl" aria-labelledby="access-heading">
            <a href="/" class="focus-ring inline-flex items-center gap-3 rounded-sm text-sm text-slate-400 transition hover:text-white">
                <span class="flex h-9 w-9 items-center justify-center border border-line bg-panel font-mono text-xs font-semibold text-signal">P/</span>
                <span class="font-mono uppercase tracking-[0.2em]">Portfolio system</span>
            </a>

            <div class="mt-12 hidden lg:block">
                <p class="font-mono text-xs uppercase tracking-[0.24em] text-cyan">Restricted interface</p>
                <h1 id="access-heading" class="mt-4 max-w-xl text-5xl font-semibold leading-tight tracking-[-0.04em] text-white">
                    Secure operator access.
                </h1>
                <p class="mt-5 max-w-lg text-lg leading-8 text-slate-400">
                    Manage published work, research notes, incoming requests and portfolio operations from one private console.
                </p>
            </div>
        </section>

        <section class="w-full max-w-lg justify-self-end border border-line bg-panel/95 p-6 shadow-2xl shadow-black/30 backdrop-blur sm:p-9" aria-labelledby="sign-in-heading">
            <div class="mb-8 flex items-start justify-between gap-5">
                <div>
                    <p class="font-mono text-xs uppercase tracking-[0.22em] text-signal">Admin console</p>
                    <h2 id="sign-in-heading" class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-white">Sign in</h2>
                    <p class="mt-2 text-sm leading-6 text-slate-400">Use your authorized administrator account.</p>
                </div>
                <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-signal shadow-[0_0_18px_rgba(157,255,32,.8)]" aria-hidden="true"></span>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 border border-red-400/30 bg-red-400/10 px-4 py-3 text-sm text-red-200" role="alert" aria-live="polite">
                    <p class="mb-1 font-medium text-red-100">Sign-in failed</p>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p>@error.ErrorMessage</p>
                    }
                </div>
            }

            <form method="post" class="space-y-5">
                @Html.AntiForgeryToken()

                <div>
                    <label asp-for="Email" class="mb-2 block text-sm font-medium text-slate-300"></label>
                    <input asp-for="Email"
                           type="email"
                           autocomplete="username"
                           inputmode="email"
                           autofocus
                           class="focus-ring w-full border border-line bg-ink px-4 py-3 text-sm text-white placeholder:text-slate-600 transition hover:border-slate-600 focus:border-signal focus:outline-none"
                           placeholder="name@example.com" />
                </div>

                <div>
                    <label asp-for="Password" class="mb-2 block text-sm font-medium text-slate-300"></label>
                    <input asp-for="Password"
                           type="password"
                           autocomplete="current-password"
                           class="focus-ring w-full border border-line bg-ink px-4 py-3 text-sm text-white transition hover:border-slate-600 focus:border-signal focus:outline-none" />
                </div>

                <div class="flex items-center gap-3">
                    <input asp-for="RememberMe"
                           type="checkbox"
                           class="focus-ring h-4 w-4 rounded-sm border-line bg-ink text-signal accent-[#9dff20]" />
                    <label asp-for="RememberMe" class="cursor-pointer text-sm text-slate-400">Remember this device</label>
                </div>

                <button type="submit"
                        class="focus-ring flex w-full items-center justify-center gap-3 bg-signal px-5 py-3 text-sm font-semibold text-ink transition hover:bg-white">
                    <span>Sign in</span>
                    <span aria-hidden="true">→</span>
                </button>
            </form>

            <p class="mt-7 border-t border-line pt-5 font-mono text-[11px] uppercase tracking-[0.16em] text-slate-600">
                Authorized access only · Activity may be logged
            </p>
        </section>
    </main>
</body>
</html>
