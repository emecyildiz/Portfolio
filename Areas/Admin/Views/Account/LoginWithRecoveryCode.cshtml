@model Portfolio.Models.ViewModels.RecoveryCodeLoginViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AuthChallengeLayout.cshtml";
    ViewData["Title"] = "Recovery-Code Sign In";
}

<div class="mb-8">
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-amber-300">Account recovery</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-white">Use a recovery code</h1>
    <p class="mt-2 text-sm leading-6 text-slate-400">Each recovery code works once. Generate a new set after regaining access if only a few remain.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="mb-6 border border-red-400/30 bg-red-400/10 px-4 py-3 text-sm text-red-200" role="alert">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

<form method="post" asp-action="LoginWithRecoveryCode" class="space-y-5">
    @Html.AntiForgeryToken()
    <div>
        <label asp-for="RecoveryCode" class="mb-2 block text-sm font-medium text-slate-300"></label>
        <input asp-for="RecoveryCode" autocomplete="one-time-code" autofocus maxlength="64"
               class="focus-ring w-full border border-line bg-ink px-4 py-3 font-mono text-sm text-white transition hover:border-slate-600 focus:border-signal focus:outline-none" />
        <span asp-validation-for="RecoveryCode"></span>
    </div>
    <button type="submit" class="focus-ring flex w-full items-center justify-center bg-signal px-5 py-3 text-sm font-semibold text-ink transition hover:bg-white">Use recovery code</button>
</form>

<a asp-action="LoginWithTwoFactor" class="focus-ring mt-7 inline-flex w-fit border-t border-line pt-5 text-sm text-slate-500 transition hover:text-white">Return to authenticator code</a>
