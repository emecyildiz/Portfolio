@model List<Portfolio.Models.HomelabPost>
@{
    ViewData["Title"] = "Homelab";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Infrastructure archive</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Homelab</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Manage network architecture, systems administration and lab security documentation.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
        <span class="border border-line bg-panel px-3 py-2 font-mono text-[10px] uppercase tracking-[0.15em] text-slate-500">@Model.Count posts</span>
        <a href="@Url.Action("Create", "Homelab", new { area = "Admin" })" class="focus-ring inline-flex items-center gap-2 bg-signal px-4 py-2.5 text-sm font-semibold text-ink transition hover:bg-white">
            <span aria-hidden="true">+</span>
            New post
        </a>
    </div>
</div>

<section class="admin-surface overflow-hidden" aria-labelledby="homelab-table-heading">
    <h3 id="homelab-table-heading" class="sr-only">Homelab post records</h3>
    @if (Model.Any())
    {
        <div class="overflow-x-auto">
            <table class="w-full min-w-[980px] text-left text-sm">
                <thead class="border-b border-line bg-ink/55">
                    <tr>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Entry</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Topic</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Publication</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Created</th>
                        <th scope="col" class="px-5 py-3.5 text-right font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                    @foreach (var post in Model)
                    {
                        var isPublic = post.Status == Portfolio.Models.Enums.VisibilityStatus.Public;
                        <tr class="transition hover:bg-white/[0.025] @(post.IsMainLab ? "bg-cyan/[0.025]" : string.Empty)">
                            <td class="px-5 py-4">
                                <div class="flex max-w-md flex-wrap items-center gap-2">
                                    <p class="font-medium text-white">@post.Title</p>
                                    @if (post.IsMainLab)
                                    {
                                        <span class="inline-flex border border-cyan/25 bg-cyan/[0.06] px-2 py-0.5 font-mono text-[9px] uppercase tracking-[0.13em] text-cyan">Main lab</span>
                                    }
                                </div>
                                <p class="mt-1 font-mono text-[11px] text-slate-600">@post.ReadingTimeMinutes min read · /@post.Slug</p>
                            </td>
                            <td class="px-5 py-4 text-xs text-slate-400">@post.Topic</td>
                            <td class="px-5 py-4">
                                <span class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.13em] @(isPublic ? "text-signal" : "text-slate-500")">
                                    <span class="h-1.5 w-1.5 rounded-full @(isPublic ? "bg-signal" : "bg-slate-600")" aria-hidden="true"></span>
                                    @(isPublic ? "Public" : "Draft")
                                </span>
                            </td>
                            <td class="px-5 py-4 font-mono text-[11px] text-slate-500">@post.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="px-5 py-4">
                                <div class="flex flex-wrap items-center justify-end gap-2">
                                    @if (isPublic)
                                    {
                                        <a href="/homelab/@post.Slug" target="_blank" rel="noopener noreferrer" class="focus-ring border border-cyan/20 px-3 py-1.5 text-xs text-cyan transition hover:bg-cyan/10">Preview</a>
                                    }
                                    <form method="post" action="@Url.Action("Toggle", "Homelab", new { area = "Admin", id = post.Id })">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="focus-ring border px-3 py-1.5 text-xs transition @(isPublic ? "border-signal/25 text-signal hover:bg-signal/10" : "border-line text-slate-400 hover:border-slate-500 hover:text-white")">@(isPublic ? "Hide" : "Publish")</button>
                                    </form>
                                    <a href="@Url.Action("Edit", "Homelab", new { area = "Admin", id = post.Id })" class="focus-ring border border-line px-3 py-1.5 text-xs text-slate-400 transition hover:border-slate-500 hover:text-white">Edit</a>
                                    <form method="post" action="@Url.Action("Delete", "Homelab", new { area = "Admin", id = post.Id })" onsubmit="return confirm('Delete this homelab post? This action cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="focus-ring border border-rose-300/20 px-3 py-1.5 text-xs text-rose-300 transition hover:bg-rose-300/10">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-16 text-center">
            <p class="font-mono text-xs uppercase tracking-[0.16em] text-slate-500">No homelab posts yet</p>
            <p class="mt-2 text-sm text-slate-600">Create the first lab entry to begin documenting the infrastructure.</p>
        </div>
    }
</section>
