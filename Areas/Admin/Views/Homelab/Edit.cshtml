@model Portfolio.Models.HomelabPost
@{
    ViewData["Title"] = "Edit Homelab Post";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var hardwareString = ViewBag.HardwareString as string ?? "";
    var softwareString = ViewBag.SoftwareString as string ?? "";
    var images = ViewBag.Images as List<Portfolio.Models.Media> ?? new List<Portfolio.Models.Media>();
    var isPublic = Model.Status == Portfolio.Models.Enums.VisibilityStatus.Public;
}

@section Head {
    <link rel="stylesheet" href="~/vendor/easymde/easymde.min.css" asp-append-version="true" />
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-teal-300">Infrastructure archive</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Edit homelab post</h2>
        <p class="mt-2 font-mono text-[11px] text-slate-600">/homelab/@Model.Slug</p>
    </div>
    <div class="flex flex-wrap gap-3">
        @if (isPublic)
        {
            <a href="/homelab/@Model.Slug" target="_blank" rel="noopener noreferrer" class="focus-ring border border-teal-300/20 px-4 py-2.5 text-sm text-teal-200 transition hover:bg-teal-300/10">Preview</a>
        }
        <a href="@Url.Action("Index", "Homelab", new { area = "Admin" })" class="focus-ring border border-line px-4 py-2.5 text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Back to homelab</a>
    </div>
</div>

<form method="post" id="mainForm" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly"></div>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_21rem]">
        <div class="space-y-6">
            <section class="admin-surface p-5 sm:p-6">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Lab narrative</p>
                <h3 class="mt-2 text-lg font-semibold text-white">Title, summary and documentation</h3>

                <div class="mt-6 space-y-5">
                    <div>
                        <label asp-for="Title" class="admin-label">Title</label>
                        <input asp-for="Title" class="admin-input" autocomplete="off" />
                        <p class="admin-hint">Changing the title also updates the public slug.</p>
                        <span asp-validation-for="Title"></span>
                    </div>

                    <div>
                        <label asp-for="Summary" class="admin-label">Summary</label>
                        <textarea asp-for="Summary" rows="3" class="admin-textarea"></textarea>
                        <span asp-validation-for="Summary"></span>
                    </div>

                    <div>
                        <label asp-for="Content" class="admin-label">Content <span class="font-normal text-slate-600">(Markdown)</span></label>
                        <textarea asp-for="Content" id="content-editor"></textarea>
                        <span asp-validation-for="Content"></span>
                    </div>
                </div>
            </section>

            <section class="admin-surface p-5 sm:p-6">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">System specification</p>
                <h3 class="mt-2 text-lg font-semibold text-white">Technical details</h3>

                <div class="mt-6 grid gap-5 sm:grid-cols-2">
                <div class="sm:col-span-2">
                    <label asp-for="Topic" class="admin-label">Topic</label>
                    <select asp-for="Topic"
                            asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.HomelabTopic>()"
                            class="admin-select">
                    </select>
                    <span asp-validation-for="Topic"></span>
                </div>

                <div>
                    <label for="HardwareUsed" class="admin-label">Hardware <span class="font-normal text-slate-600">(optional)</span></label>
                    <input name="HardwareUsed" id="HardwareUsed" value="@hardwareString" class="admin-input" autocomplete="off" />
                    <p class="admin-hint">Separate items with commas.</p>
                </div>

                <div>
                    <label for="SoftwareUsed" class="admin-label">Software <span class="font-normal text-slate-600">(optional)</span></label>
                    <input name="SoftwareUsed" id="SoftwareUsed" value="@softwareString" class="admin-input" autocomplete="off" />
                    <p class="admin-hint">Separate items with commas.</p>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="NetworkDiagramUrl" class="admin-label">Network diagram path <span class="font-normal text-slate-600">(optional)</span></label>
                    <input asp-for="NetworkDiagramUrl" class="admin-input font-mono" autocomplete="off" inputmode="url" pattern="(?:/(?!/).+|https://.+)" title="Use a root-relative path or an HTTPS URL." />
                    <span asp-validation-for="NetworkDiagramUrl"></span>
                </div>
                <div class="border border-line bg-ink/40 p-4 sm:col-span-2 sm:p-5">
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                        <div>
                            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-teal-300">Topology builder</p>
                            <h4 class="mt-2 text-base font-semibold text-white">Interactive network map</h4>
                            <p class="admin-hint">Add devices and connections, then drag nodes to save their public positions.</p>
                        </div>
                        <button type="button" onclick="addDevice()"
                                class="focus-ring w-fit border border-teal-300/20 px-3 py-2 text-xs text-teal-200 transition hover:bg-teal-300/10">
                            Add device
                        </button>
                    </div>

                    <aside class="mt-5 border border-amber-300/20 bg-amber-300/[0.05] px-4 py-3.5 text-xs leading-6 text-amber-100/80" aria-label="Public topology safety reminder">
                        <span class="font-medium text-amber-100">Everything in this topology is public.</span>
                        Use redacted network labels only. Never enter real IP addresses, subnets, MAC addresses, hostnames, credentials, exposed ports, remote-access details, serial numbers, or security-rule details.
                    </aside>

                    <input type="hidden" name="NetworkTopologyJson" id="networkTopologyJson" />

                    <div id="devices-container" class="mb-6 mt-5 space-y-3"></div>

                    <div class="border-t border-line pt-5">
                        <div class="mb-4 flex items-center justify-between gap-4">
                            <h4 class="font-mono text-[10px] uppercase tracking-[0.16em] text-slate-500">Connections</h4>
                            <button type="button" onclick="addConnection()"
                                    class="focus-ring border border-line px-3 py-2 text-xs text-slate-300 transition hover:border-slate-500 hover:text-white">
                                Add connection
                            </button>
                        </div>
                        <div id="connections-container" class="space-y-2"></div>
                    </div>

                    <div class="mt-6 border-t border-line pt-5">
                        <div class="mb-3 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                            <div>
                                <h4 class="font-mono text-[10px] uppercase tracking-[0.16em] text-slate-500">Map layout</h4>
                                <p class="admin-hint">Drag devices to set their positions on the public map.</p>
                            </div>
                            <button type="button" onclick="resetTopologyLayout()"
                                    class="focus-ring w-fit border border-line px-3 py-2 text-xs text-slate-300 transition hover:border-slate-500 hover:text-white">
                                Reset to grid
                            </button>
                        </div>
                        <div id="network-layout-editor"
                             class="h-96 overflow-hidden border border-slate-400/30" style="background-color: #e8eef2; background-image: linear-gradient(rgba(15, 23, 42, .08) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, .08) 1px, transparent 1px); background-size: 32px 32px;"></div>
                        <p id="network-layout-status" class="admin-hint"></p>
                    </div>
                </div>
                </div>
            </section>

            @if (images.Any())
            {
                <section class="admin-surface p-5 sm:p-6" aria-labelledby="homelab-existing-media-heading">
                    <div class="flex items-end justify-between gap-4">
                        <div><p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Lab gallery</p><h3 id="homelab-existing-media-heading" class="mt-2 text-lg font-semibold text-white">Existing images</h3></div>
                        <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">@images.Count files</span>
                    </div>
                    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        @foreach (var image in images)
                        {
                            <article class="overflow-hidden border @(image.IsCover ? "border-signal/35" : "border-line") bg-ink/50">
                                <div class="relative"><img src="@image.Url" alt="@image.AltText" class="h-40 w-full object-cover" />@if (image.IsCover){<span class="absolute left-2 top-2 bg-signal px-2 py-1 font-mono text-[9px] uppercase tracking-[0.12em] text-ink">Cover</span>}</div>
                                <div class="flex items-center justify-end gap-2 p-3">@if (!image.IsCover){<button type="submit" form="homelab-cover-@image.Id" class="focus-ring border border-cyan/20 px-2.5 py-1.5 text-[10px] text-cyan transition hover:bg-cyan/10">Set cover</button>}<button type="submit" form="homelab-delete-@image.Id" class="focus-ring border border-rose-300/20 px-2.5 py-1.5 text-[10px] text-rose-300 transition hover:bg-rose-300/10">Delete</button></div>
                            </article>
                        }
                    </div>
                </section>
            }

            <section class="admin-surface p-5 sm:p-6" aria-labelledby="homelab-media-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Lab media</p><h3 id="homelab-media-heading" class="mt-2 text-lg font-semibold text-white">Add images</h3>
                <label for="homelabImages" class="admin-label mt-5">Image files <span class="font-normal text-slate-600">(optional)</span></label>
                <input name="Images" id="homelabImages" type="file" multiple accept="image/jpeg,image/png,image/webp,image/gif" aria-describedby="homelab-images-help" class="focus-ring w-full border border-line bg-ink p-3 text-sm text-slate-400 file:mr-3 file:border-0 file:bg-raised file:px-3 file:py-2 file:text-xs file:font-medium file:text-slate-300 hover:file:bg-line" />
                <p id="homelab-images-help" class="admin-hint">JPEG, PNG, WebP or GIF; maximum 10 MB per file.</p>
            </section>
        </div>

        <aside class="h-fit space-y-4 xl:sticky xl:top-6" aria-labelledby="homelab-settings-heading">
            <section class="admin-surface p-5 sm:p-6">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Publishing</p>
                <h3 id="homelab-settings-heading" class="mt-2 text-lg font-semibold text-white">Post settings</h3>

                <div class="mt-6 space-y-5">
                <div>
                    <label asp-for="Status" class="admin-label">Status</label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.VisibilityStatus>()"
                            class="admin-select">
                    </select>
                    <span asp-validation-for="Status"></span>
                </div>

                <label class="flex cursor-pointer items-start gap-3 border border-line bg-ink/50 p-4">
                    <input asp-for="IsFeatured" type="checkbox" class="admin-checkbox mt-0.5 shrink-0" />
                    <span><span class="block text-sm font-medium text-slate-300">Feature on homepage</span><span class="mt-1 block text-xs leading-5 text-slate-600">Give this post additional visibility.</span></span>
                </label>
                <label class="flex cursor-pointer items-start gap-3 border border-teal-300/20 bg-teal-300/[0.04] p-4">
                    <input asp-for="IsMainLab" type="checkbox" class="admin-checkbox mt-0.5 shrink-0" />
                    <span><span class="block text-sm font-medium text-teal-200">Main lab map</span><span class="mt-1 block text-xs leading-5 text-slate-600">Use this entry as the primary public homelab topology.</span></span>
                </label>

                <div class="border-t border-line pt-4 font-mono text-[10px] uppercase tracking-[0.1em] text-slate-700">
                    <p>Created @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                    <p class="mt-1">@Model.ViewCount views</p>
                    <p class="mt-1">@Model.ReadingTimeMinutes min read</p>
                </div>
                </div>
            </section>

            <div class="flex flex-col gap-2">
                <button type="submit" class="focus-ring w-full bg-signal px-6 py-3 text-sm font-semibold text-ink transition hover:bg-white">Save changes</button>
                <a href="@Url.Action("Index", "Homelab", new { area = "Admin" })" class="focus-ring w-full border border-line px-5 py-3 text-center text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Cancel</a>
            </div>
        </aside>
    </div>
</form>

@foreach (var image in images)
{
    <form id="homelab-cover-@image.Id" method="post" action="@Url.Action("SetCover", "Homelab", new { area = "Admin" })" class="hidden">@Html.AntiForgeryToken()<input type="hidden" name="mediaId" value="@image.Id" /><input type="hidden" name="postId" value="@Model.Id" /></form>
    <form id="homelab-delete-@image.Id" method="post" action="@Url.Action("DeleteImage", "Homelab", new { area = "Admin" })" onsubmit="return confirm('Delete this image permanently?');" class="hidden">@Html.AntiForgeryToken()<input type="hidden" name="mediaId" value="@image.Id" /><input type="hidden" name="postId" value="@Model.Id" /></form>
}

@section Scripts {
<script src="~/vendor/easymde/easymde.min.js" asp-append-version="true"></script>
<script src="~/vendor/vis-network/vis-network.min.js" asp-append-version="true"></script>
<script>
    new EasyMDE({
        element: document.getElementById('content-editor'),
        spellChecker: false,
        toolbar: window.portfolioMarkdownToolbar
    });
</script>
<script>
    // ============ DATA MODEL ============
    let devices = [];
    let connections = [];
    let electronicsProjects = [];
    let iconLibrary = [];
    let layoutNetwork = null;
    let layoutNodes = null;
    let layoutEdges = null;
    const layoutTypeColors = {
        router: '#3B82F6', switch: '#8B5CF6', firewall: '#EF4444',
        server: '#10B981', pc: '#6B7280', laptop: '#6B7280',
        microcontroller: '#F59E0B', mobile: '#6B7280', custom: '#EC4899',
        sensor: '#F59E0B', audio: '#14B8A6', antenna: '#06B6D4'
    };
    const endpoints = {
        electronicsProjects: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("GetElectronicsProjects", "Homelab", new { area = "Admin" }))),
        iconLibrary: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("GetIconLibrary", "Homelab", new { area = "Admin" }))),
        uploadIcon: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("UploadIcon", "Homelab", new { area = "Admin" })))
    };

    const htmlEscapeMap = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
    function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, character => htmlEscapeMap[character]);
    }

    function safeWebUrl(value) {
        if (!value) return '';

        try {
            const rawValue = String(value).trim();
            const url = new URL(rawValue, window.location.origin);
            const isRootRelative = rawValue.startsWith('/') && !rawValue.startsWith('//') && url.origin === window.location.origin;
            return isRootRelative || url.protocol === 'https:' ? url.href : '';
        } catch {
            return '';
        }
    }

    function selectLibraryIcon(deviceId, url) {
        if (url) {
            updateDevice(deviceId, 'iconUrl', url);
            renderDevices();
        }
    }

        document.addEventListener('DOMContentLoaded', async function() {
        try {
            const res = await fetch(endpoints.electronicsProjects);
            electronicsProjects = await res.json();
        } catch (e) {
            console.error('Electronics projects could not be loaded', e);
        }

        // Load the icon library.
        try {
            const iconRes = await fetch(endpoints.iconLibrary);
            iconLibrary = await iconRes.json();
        } catch (e) {
            console.error('The icon library could not be loaded', e);
        }

        const existingJson = @Html.Raw(ViewBag.NetworkTopologyJson ?? "null");
        if (existingJson) {
            devices = existingJson.nodes || [];
            connections = existingJson.edges || [];
        }

        renderDevices();
        renderConnections();
        renderTopologyLayout();
    });

    function ensureDevicePositions() {
        devices.forEach((device, index) => {
            if (!Number.isFinite(device.x)) device.x = (index % 4) * 170;
            if (!Number.isFinite(device.y)) device.y = Math.floor(index / 4) * 150;
        });
    }

    function captureLayoutPositions(nodeIds = devices.map(device => device.id)) {
        if (!layoutNetwork || !layoutNodes || nodeIds.length === 0) return;

        const existingNodeIds = new Set(layoutNodes.getIds());
        const capturedNodeIds = nodeIds.filter(nodeId => existingNodeIds.has(nodeId));
        if (capturedNodeIds.length === 0) return;

        const positions = layoutNetwork.getPositions(capturedNodeIds);
        devices.forEach(device => {
            const position = positions[device.id];
            if (position && Number.isFinite(position.x) && Number.isFinite(position.y)) {
                device.x = position.x;
                device.y = position.y;
            }
        });
    }

    function layoutNodeData(device) {
        const imageUrl = safeWebUrl(device.iconUrl);
        return {
            id: device.id,
            label: device.label || `Device ${device.id}`,
            shape: imageUrl ? 'image' : 'dot',
            image: imageUrl || undefined,
            color: imageUrl ? undefined : (layoutTypeColors[device.deviceType] || '#6B7280'),
            size: 24,
            font: { color: '#0F172A', size: 13, face: 'Inter', strokeWidth: 3, strokeColor: '#E8EEF2' },
            borderWidth: 2,
            shapeProperties: { useImageSize: false, interpolation: false },
            x: device.x,
            y: device.y
        };
    }

    function renderTopologyLayout() {
        const container = document.getElementById('network-layout-editor');
        const status = document.getElementById('network-layout-status');
        if (!container || !status) return;

        captureLayoutPositions();
        ensureDevicePositions();

        if (layoutNetwork) {
            layoutNetwork.destroy();
            layoutNetwork = null;
        }

        if (typeof vis === 'undefined') {
            status.textContent = 'The map library could not be loaded. You can still save the other fields.';
            return;
        }

        layoutNodes = new vis.DataSet(devices.map(layoutNodeData));
        layoutEdges = new vis.DataSet(connections.map((connection, index) => ({
            id: index,
            from: connection.from,
            to: connection.to,
            label: connection.label || '',
            color: { color: '#475569' },
            font: { color: '#334155', size: 10, strokeWidth: 3, strokeColor: '#E8EEF2' },
            smooth: false
        })));

        layoutNetwork = new vis.Network(container, { nodes: layoutNodes, edges: layoutEdges }, {
            physics: { enabled: false },
            interaction: {
                hover: true,
                dragNodes: true,
                dragView: true,
                zoomView: true
            },
            edges: { smooth: false }
        });

        layoutNetwork.on('dragEnd', params => {
            captureLayoutPositions(params.nodes || []);
            status.textContent = 'The layout changed. Select Update to save the new positions.';
        });

        status.textContent = devices.length === 0
            ? 'Add at least one device first.'
            : 'Device positions are saved with the topology when the form is submitted.';
    }

    function resetTopologyLayout() {
        devices.forEach((device, index) => {
            device.x = (index % 4) * 170;
            device.y = Math.floor(index / 4) * 150;
        });
        renderTopologyLayout();
        document.getElementById('network-layout-status').textContent =
            'The layout was reset to the grid. Select Update to save the new positions.';
    }

    // ============ DEVICE MANAGEMENT ============
    function addDevice() {
        const newId = devices.length > 0 ? Math.max(...devices.map(d => d.id)) + 1 : 1;
        devices.push({
            id: newId,
            label: '',
            iconUrl: '',
            deviceType: 'custom',
            linkedProjectSlug: '',
            standaloneImageUrl: '',
            standaloneHardware: '',
            shortInfo: '',
            ipAddress: '',
            homelabRole: '',
            homelabNotes: '',
            x: (devices.length % 4) * 170,
            y: Math.floor(devices.length / 4) * 150,
            _expanded: true
        });
        renderDevices();
        renderTopologyLayout();
    }

    function removeDevice(id) {
        devices = devices.filter(d => d.id !== id);
        // Remove connections attached to this device as well.
        connections = connections.filter(c => c.from !== id && c.to !== id);
        renderDevices();
        renderConnections();
        renderTopologyLayout();
    }

    function updateDevice(id, field, value) {
        const device = devices.find(d => d.id === id);
        if (device) {
            device[field] = value;
            if (layoutNodes && ['label', 'iconUrl', 'deviceType'].includes(field)) {
                layoutNodes.update(layoutNodeData(device));
            }
        }
    }

    async function uploadDeviceIcon(id, inputEl) {
        const file = inputEl.files[0];
        if (!file) return;

        const formData = new FormData();
        formData.append('icon', file);

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        try {
            const res = await fetch(endpoints.uploadIcon, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body: formData
            });
            const data = await res.json();

            if (data.success) {
                updateDevice(id, 'iconUrl', data.url);
                renderDevices();
            } else {
                alert('Error: ' + data.message);
            }
        } catch (e) {
            alert('An error occurred while uploading the icon.');
            console.error(e);
        }
    }

        function renderDevices() {
        const container = document.getElementById('devices-container');
        container.innerHTML = devices.map(d => {
            const isExpanded = d._expanded === true; // Expanded by default.
            const iconUrl = safeWebUrl(d.iconUrl);
            return `
            <article class="space-y-4 border border-line bg-raised/50 p-4">
                <div class="flex items-center justify-between gap-4">
                    <button type="button" class="focus-ring flex min-w-0 flex-1 items-center gap-3 text-left" onclick="toggleDeviceExpand(${d.id})" aria-expanded="${isExpanded}">
                        ${iconUrl
                            ? `<img src="${escapeHtml(iconUrl)}" alt="" class="h-9 w-9 border border-line bg-ink object-contain p-1" />`
                            : `<div class="grid h-9 w-9 place-items-center border border-line bg-ink font-mono text-xs text-slate-600">?</div>`
                        }
                        <span class="min-w-0"><span class="block truncate text-sm font-medium text-slate-200">${escapeHtml(d.label || 'Unnamed Device')}</span><span class="block font-mono text-[9px] uppercase tracking-[0.12em] text-slate-600">${escapeHtml(d.deviceType)}</span></span>
                        <svg class="h-4 w-4 text-slate-500 transition ${isExpanded ? 'rotate-180' : ''}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <button type="button" onclick="removeDevice(${d.id})" class="focus-ring shrink-0 text-xs text-rose-300 transition hover:text-white">Remove</button>
                </div>

                ${isExpanded ? `
                <div class="grid gap-3 sm:grid-cols-2">
                    <div>
                        <label class="admin-label">Device name</label>
                        <input value="${escapeHtml(d.label)}" oninput="updateDevice(${d.id}, 'label', this.value)"
                               class="admin-input" />
                    </div>
                    <div>
                        <label class="admin-label">Device type</label>
                        <select onchange="updateDevice(${d.id}, 'deviceType', this.value)"
                                class="admin-select">
                            ${['router','switch','firewall','server','pc','laptop','microcontroller','mobile','custom','sensor','audio','antenna'].map(t =>
                                `<option value="${t}" ${d.deviceType === t ? 'selected' : ''}>${t}</option>`
                            ).join('')}
                        </select>
                    </div>
                </div>

                    <div class="grid gap-3 sm:grid-cols-2">
                        <div>
                            <label class="admin-label">Choose from icon library</label>
                            <select onchange="selectLibraryIcon(${d.id}, this.value)"
                                class="admin-select">
                                <option value="">-- Select --</option>
                                ${iconLibrary.map(icon =>
                    `               <option value="${escapeHtml(safeWebUrl(icon.url))}" ${d.iconUrl === icon.url ? 'selected' : ''}>${escapeHtml(icon.name)}</option>`
                                ).join('')}
                            </select>
                        </div>
                        <div>
                            <label class="admin-label">Or upload a file</label>
                            <input type="file" accept="image/png,image/webp"
                                onchange="uploadDeviceIcon(${d.id}, this)"
                                class="focus-ring w-full border border-line bg-ink p-2 text-xs text-slate-400 file:mr-3 file:border-0 file:bg-raised file:px-3 file:py-1.5 file:text-slate-300 hover:file:bg-line" />
                        </div>
                    </div>

                <div>
                    <label class="admin-label">Link to an electronics project <span class="font-normal text-slate-600">(optional)</span></label>
                    <select onchange="updateDevice(${d.id}, 'linkedProjectSlug', this.value)"
                            class="admin-select">
                        <option value="">Not linked — enter details manually</option>
                        ${electronicsProjects.map(p =>
                            `<option value="${escapeHtml(p.slug)}" ${d.linkedProjectSlug === p.slug ? 'selected' : ''}>${escapeHtml(p.title)}</option>`
                        ).join('')}
                    </select>
                </div>

                ${!d.linkedProjectSlug ? `
                <div class="grid gap-3 sm:grid-cols-2">
                    <div>
                        <label class="admin-label">Image URL <span class="font-normal text-slate-600">(manual)</span></label>
                        <input value="${escapeHtml(d.standaloneImageUrl || '')}" oninput="updateDevice(${d.id}, 'standaloneImageUrl', this.value)"
                               class="admin-input" />
                    </div>
                    <div>
                        <label class="admin-label">Public hardware summary <span class="font-normal text-slate-600">(manual)</span></label>
                        <input value="${escapeHtml(d.standaloneHardware || '')}" oninput="updateDevice(${d.id}, 'standaloneHardware', this.value)"
                               placeholder="Model or component summary; omit serial numbers"
                               class="admin-input" />
                    </div>
                </div>
                ` : ''}

                <div class="grid gap-3 sm:grid-cols-2">
                    <div>
                        <label class="admin-label">Short description <span class="font-normal text-slate-600">(shown on hover)</span></label>
                        <input value="${escapeHtml(d.shortInfo || '')}" oninput="updateDevice(${d.id}, 'shortInfo', this.value)"
                               class="admin-input" />
                    </div>
                    <div>
                        <label class="admin-label">Public network label <span class="font-normal text-slate-600">(optional)</span></label>
                        <input value="${escapeHtml(d.ipAddress || '')}" oninput="updateDevice(${d.id}, 'ipAddress', this.value)"
                               placeholder="Management VLAN or 10.20.x.x"
                               class="admin-input font-mono" />
                        <p class="admin-hint">Raw IP, IPv6, CIDR and MAC values are rejected by the server.</p>
                    </div>
                </div>

                <div>
                    <label class="admin-label">Role in the homelab</label>
                    <input value="${escapeHtml(d.homelabRole || '')}" oninput="updateDevice(${d.id}, 'homelabRole', this.value)"
                           placeholder="What does it do on this network?"
                           class="admin-input" />
                </div>

                <div>
                    <label class="admin-label">Public notes</label>
                    <textarea oninput="updateDevice(${d.id}, 'homelabNotes', this.value)" rows="2"
                              class="admin-textarea">${escapeHtml(d.homelabNotes || '')}</textarea>
                    <p class="admin-hint">Describe purpose and design decisions, not operational access details.</p>
                </div>
                ` : ''}
            </article>
        `}).join('');
    }

    function toggleDeviceExpand(id) {
        const device = devices.find(d => d.id === id);
        if (device) device._expanded = device._expanded === false ? true : false;
        renderDevices();
    }

    // ============ CONNECTION MANAGEMENT ============
    function addConnection() {
        if (devices.length < 2) {
            alert('At least two devices are required to add a connection.');
            return;
        }
        connections.push({
            from: devices[0].id,
            to: devices[1].id,
            connectionType: 'ethernet',
            label: ''
        });
        renderConnections();
        renderTopologyLayout();
    }

    function removeConnection(index) {
        connections.splice(index, 1);
        renderConnections();
        renderTopologyLayout();
    }

    function updateConnection(index, field, value) {
        connections[index][field] = field === 'from' || field === 'to' ? parseInt(value) : value;
        renderTopologyLayout();
    }

    function renderConnections() {
        const container = document.getElementById('connections-container');

        if (devices.length < 2) {
            container.innerHTML = '<p class="text-xs text-slate-600">Add at least two devices before creating a connection.</p>';
            return;
        }

        container.innerHTML = connections.map((c, i) => `
            <div class="grid gap-2 border border-line bg-raised/50 p-3 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)_minmax(0,8rem)_minmax(0,8rem)_auto] sm:items-center">
                <select onchange="updateConnection(${i}, 'from', this.value)"
                        class="admin-select text-xs">
                    ${devices.map(d => `<option value="${d.id}" ${c.from === d.id ? 'selected' : ''}>${escapeHtml(d.label || 'Unnamed')}</option>`).join('')}
                </select>
                <span class="hidden text-xs text-slate-600 sm:inline">→</span>
                <select onchange="updateConnection(${i}, 'to', this.value)"
                        class="admin-select text-xs">
                    ${devices.map(d => `<option value="${d.id}" ${c.to === d.id ? 'selected' : ''}>${escapeHtml(d.label || 'Unnamed')}</option>`).join('')}
                </select>
                <select onchange="updateConnection(${i}, 'connectionType', this.value)"
                        class="admin-select text-xs">
                    ${['ethernet','wifi','usb','power','other'].map(t =>
                        `<option value="${t}" ${c.connectionType === t ? 'selected' : ''}>${t}</option>`
                    ).join('')}
                </select>
                <input value="${escapeHtml(c.label || '')}" oninput="updateConnection(${i}, 'label', this.value)"
                       placeholder="Label (optional)"
                       class="admin-input text-xs" />
                <button type="button" onclick="removeConnection(${i})"
                        class="focus-ring px-2 text-xs text-rose-300 transition hover:text-white" aria-label="Remove connection">Remove</button>
            </div>
        `).join('');
    }

        // ============ SAVE ============
    function containsRawNetworkIdentifier(value) {
        if (!value) return false;
        const label = String(value).trim();
        const ipv4Pattern = /(^|[^0-9])(?:(?:25[0-5]|2[0-4]\d|1?\d?\d)\.){3}(?:25[0-5]|2[0-4]\d|1?\d?\d)(?![0-9])/;
        const macPattern = /(^|[^0-9a-f])(?:[0-9a-f]{2}[:-]){5}[0-9a-f]{2}(?![0-9a-f])/i;
        const ipv6Pattern = /^\[?(?:[0-9a-f]{0,4}:){2,}[0-9a-f]{0,4}\]?(?:\/\d{1,3})?$/i;
        return ipv4Pattern.test(label) || macPattern.test(label) || ipv6Pattern.test(label);
    }

    document.getElementById('mainForm')?.addEventListener('submit', function(event) {
        const unsafeDevice = devices.find(device => containsRawNetworkIdentifier(device.ipAddress));
        if (unsafeDevice) {
            event.preventDefault();
            unsafeDevice._expanded = true;
            renderDevices();
            alert(`Use a redacted public network label for "${unsafeDevice.label || 'Unnamed Device'}". Raw IP, CIDR and MAC values cannot be published.`);
            return;
        }

        captureLayoutPositions();
        const cleanDevices = devices.map(({ _expanded, ...rest }) => rest);
        const topology = { nodes: cleanDevices, edges: connections };
        document.getElementById('networkTopologyJson').value = JSON.stringify(topology);
    });
</script>
}
