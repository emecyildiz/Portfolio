@model Portfolio.Models.HomelabPost
@{
    ViewData["Title"] = "New Homelab Post";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css" />
}

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-teal-300">Infrastructure archive</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">New homelab post</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Document infrastructure experiments, network architecture and self-hosted systems.</p>
    </div>
    <a href="@Url.Action("Index", "Homelab", new { area = "Admin" })" class="focus-ring w-fit border border-line px-4 py-2.5 text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Back to homelab</a>
</div>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly"></div>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_21rem]">
        <div class="space-y-6">
            <section class="admin-surface p-5 sm:p-6" aria-labelledby="homelab-content-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Lab narrative</p>
                <h3 id="homelab-content-heading" class="mt-2 text-lg font-semibold text-white">Title, summary and documentation</h3>
                <div class="mt-6 space-y-5">
                    <div><label asp-for="Title" class="admin-label">Title</label><input asp-for="Title" class="admin-input" autocomplete="off" /><p class="admin-hint">The public slug is generated from this title.</p><span asp-validation-for="Title"></span></div>
                    <div><label asp-for="Summary" class="admin-label">Summary</label><textarea asp-for="Summary" rows="3" class="admin-textarea"></textarea><span asp-validation-for="Summary"></span></div>
                    <div><label asp-for="Content" class="admin-label">Content <span class="font-normal text-slate-600">(Markdown)</span></label><textarea asp-for="Content" id="content-editor"></textarea><p class="admin-hint">Local draft recovery is enabled in this browser while creating the post.</p><span asp-validation-for="Content"></span></div>
                </div>
            </section>

            <section class="admin-surface p-5 sm:p-6" aria-labelledby="homelab-technical-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">System specification</p>
                <h3 id="homelab-technical-heading" class="mt-2 text-lg font-semibold text-white">Technical details</h3>
                <div class="mt-6 grid gap-5 sm:grid-cols-2">
                    <div class="sm:col-span-2"><label asp-for="Topic" class="admin-label">Topic</label><select asp-for="Topic" asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.HomelabTopic>()" class="admin-select"></select><span asp-validation-for="Topic"></span></div>
                    <div><label for="HardwareUsed" class="admin-label">Hardware <span class="font-normal text-slate-600">(optional)</span></label><input name="HardwareUsed" id="HardwareUsed" class="admin-input" autocomplete="off" placeholder="Raspberry Pi 4, firewall appliance" aria-describedby="homelab-hardware-help" /><p id="homelab-hardware-help" class="admin-hint">Separate items with commas.</p></div>
                    <div><label for="SoftwareUsed" class="admin-label">Software <span class="font-normal text-slate-600">(optional)</span></label><input name="SoftwareUsed" id="SoftwareUsed" class="admin-input" autocomplete="off" placeholder="Proxmox, Grafana, pfSense" aria-describedby="homelab-software-help" /><p id="homelab-software-help" class="admin-hint">Separate items with commas.</p></div>
                    <div class="sm:col-span-2"><label asp-for="NetworkDiagramUrl" class="admin-label">Network diagram path <span class="font-normal text-slate-600">(optional)</span></label><input asp-for="NetworkDiagramUrl" class="admin-input font-mono" autocomplete="off" inputmode="url" pattern="(?:/(?!/).+|https://.+)" title="Use a root-relative path or an HTTPS URL." placeholder="/uploads/diagrams/network.png" /><span asp-validation-for="NetworkDiagramUrl"></span><p class="admin-hint">The interactive map can be configured after the post is created.</p></div>
                </div>
            </section>

            <section class="admin-surface p-5 sm:p-6" aria-labelledby="homelab-media-heading">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Lab media</p><h3 id="homelab-media-heading" class="mt-2 text-lg font-semibold text-white">Add images</h3>
                <label for="homelabImages" class="admin-label mt-5">Image files <span class="font-normal text-slate-600">(optional)</span></label>
                <input name="Images" id="homelabImages" type="file" multiple accept="image/jpeg,image/png,image/webp,image/gif" aria-describedby="homelab-images-help" class="focus-ring w-full border border-line bg-ink p-3 text-sm text-slate-400 file:mr-3 file:border-0 file:bg-raised file:px-3 file:py-2 file:text-xs file:font-medium file:text-slate-300 hover:file:bg-line" />
                <p id="homelab-images-help" class="admin-hint">JPEG, PNG, WebP or GIF; maximum 10 MB per file. The first image becomes the cover.</p>
            </section>
        </div>

        <aside class="h-fit space-y-4 xl:sticky xl:top-6" aria-labelledby="homelab-settings-heading">
            <section class="admin-surface p-5 sm:p-6">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Publishing</p><h3 id="homelab-settings-heading" class="mt-2 text-lg font-semibold text-white">Post settings</h3>
                <div class="mt-6 space-y-5">
                    <div><label asp-for="Status" class="admin-label">Status</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<Portfolio.Models.Enums.VisibilityStatus>()" class="admin-select"></select><span asp-validation-for="Status"></span></div>
                    <label class="flex cursor-pointer items-start gap-3 border border-line bg-ink/50 p-4"><input asp-for="IsFeatured" type="checkbox" class="admin-checkbox mt-0.5 shrink-0" /><span><span class="block text-sm font-medium text-slate-300">Feature on homepage</span><span class="mt-1 block text-xs leading-5 text-slate-600">Give this post additional visibility.</span></span></label>
                    <label class="flex cursor-pointer items-start gap-3 border border-teal-300/20 bg-teal-300/[0.04] p-4"><input asp-for="IsMainLab" type="checkbox" class="admin-checkbox mt-0.5 shrink-0" /><span><span class="block text-sm font-medium text-teal-200">Main lab map</span><span class="mt-1 block text-xs leading-5 text-slate-600">Use this entry as the primary public homelab topology.</span></span></label>
                </div>
            </section>
            <div class="flex flex-col gap-2"><button type="submit" class="focus-ring w-full bg-signal px-6 py-3 text-sm font-semibold text-ink transition hover:bg-white">Create post</button><a href="@Url.Action("Index", "Homelab", new { area = "Admin" })" class="focus-ring w-full border border-line px-5 py-3 text-center text-sm text-slate-400 transition hover:border-slate-500 hover:text-white">Cancel</a></div>
        </aside>
    </div>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
    <script>
        new EasyMDE({
            element: document.getElementById('content-editor'),
            spellChecker: false,
            autosave: { enabled: true, uniqueId: 'homelab-create' },
            toolbar: window.portfolioMarkdownToolbar
        });
    </script>
}
