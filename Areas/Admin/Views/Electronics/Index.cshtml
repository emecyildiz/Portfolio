@model List<Portfolio.Models.Project>
@{
    ViewData["Title"] = "Electronics Projects";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-cyan">Hardware archive</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Electronics projects</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">Manage microcontroller builds, circuits and hardware experiments.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
        <span class="border border-line bg-panel px-3 py-2 font-mono text-[10px] uppercase tracking-[0.15em] text-slate-500">@Model.Count projects</span>
        <a href="@Url.Action("Create", "Electronics", new { area = "Admin" })" class="focus-ring inline-flex items-center gap-2 bg-signal px-4 py-2.5 text-sm font-semibold text-ink transition hover:bg-white">
            <span aria-hidden="true">+</span>
            New project
        </a>
    </div>
</div>

<section class="admin-surface overflow-hidden" aria-labelledby="electronics-table-heading">
    <h3 id="electronics-table-heading" class="sr-only">Electronics project records</h3>
    @if (Model.Any())
    {
        <div class="overflow-x-auto">
            <table class="w-full min-w-[920px] text-left text-sm">
                <thead class="border-b border-line bg-ink/55">
                    <tr>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Project</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Publication</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Placement</th>
                        <th scope="col" class="px-5 py-3.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Created</th>
                        <th scope="col" class="px-5 py-3.5 text-right font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-slate-500">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                    @foreach (var project in Model)
                    {
                        var isPublic = project.Status == Portfolio.Models.Enums.VisibilityStatus.Public;
                        <tr class="transition hover:bg-white/[0.025]">
                            <td class="px-5 py-4">
                                <p class="max-w-md font-medium text-white">@project.Title</p>
                                <p class="mt-1 font-mono text-[11px] text-slate-600">/@project.Slug</p>
                            </td>
                            <td class="px-5 py-4">
                                <span class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.13em] @(isPublic ? "text-signal" : "text-slate-500")">
                                    <span class="h-1.5 w-1.5 rounded-full @(isPublic ? "bg-signal" : "bg-slate-600")" aria-hidden="true"></span>
                                    @(isPublic ? "Public" : "Draft")
                                </span>
                            </td>
                            <td class="px-5 py-4">
                                @if (project.IsFeatured)
                                {
                                    <span class="inline-flex border border-amber-300/20 bg-amber-300/[0.06] px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.12em] text-amber-200">Featured</span>
                                }
                                else
                                {
                                    <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-600">Standard</span>
                                }
                            </td>
                            <td class="px-5 py-4 font-mono text-[11px] text-slate-500">@project.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="px-5 py-4">
                                <div class="flex flex-wrap items-center justify-end gap-2">
                                    @if (isPublic)
                                    {
                                        <a href="/electronics/@project.Slug" target="_blank" rel="noopener noreferrer" class="focus-ring border border-cyan/20 px-3 py-1.5 text-xs text-cyan transition hover:bg-cyan/10">Preview</a>
                                    }
                                    <form method="post" action="@Url.Action("Toggle", "Electronics", new { area = "Admin", id = project.Id })">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="focus-ring border px-3 py-1.5 text-xs transition @(isPublic ? "border-signal/25 text-signal hover:bg-signal/10" : "border-line text-slate-400 hover:border-slate-500 hover:text-white")">@(isPublic ? "Hide" : "Publish")</button>
                                    </form>
                                    <a href="@Url.Action("Edit", "Electronics", new { area = "Admin", id = project.Id })" class="focus-ring border border-line px-3 py-1.5 text-xs text-slate-400 transition hover:border-slate-500 hover:text-white">Edit</a>
                                    <form method="post" action="@Url.Action("Delete", "Electronics", new { area = "Admin", id = project.Id })" onsubmit="return confirm('Delete this project? This action cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="focus-ring border border-rose-300/20 px-3 py-1.5 text-xs text-rose-300 transition hover:bg-rose-300/10">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-16 text-center">
            <p class="font-mono text-xs uppercase tracking-[0.16em] text-slate-500">No electronics projects yet</p>
            <p class="mt-2 text-sm text-slate-600">Create the first hardware project to start this archive.</p>
        </div>
    }
</section>
