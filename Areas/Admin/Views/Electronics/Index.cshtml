@model List<Portfolio.Models.Project>
@{
    ViewData["Title"] = "Electronics Projects";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex items-center justify-between mb-8">
    <div>
        <h2 class="text-2xl font-bold text-white">Electronics Projects</h2>
        <p class="text-gray-500 mt-1">Microcontroller and circuit projects</p>
    </div>
    <a href="@Url.Action("Create", "Electronics", new { area = "Admin" })"
       class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
        + New Project
    </a>
</div>

<div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="border-b border-gray-800">
                <th class="text-left px-6 py-3 text-gray-400 font-medium">Title</th>
                <th class="text-left px-6 py-3 text-gray-400 font-medium">Status</th>
                <th class="text-left px-6 py-3 text-gray-400 font-medium">Featured</th>
                <th class="text-left px-6 py-3 text-gray-400 font-medium">Date</th>
                <th class="text-right px-6 py-3 text-gray-400 font-medium">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr class="border-b border-gray-800/50 hover:bg-gray-800/30 transition">
                    <td class="px-6 py-4">
                        <p class="text-white font-medium">@p.Title</p>
                        <p class="text-gray-500 text-xs mt-0.5">/@p.Slug</p>
                    </td>
                    <td class="px-6 py-4">
                        @if (p.Status == Portfolio.Models.Enums.VisibilityStatus.Public)
                        {
                            <span class="bg-green-900/40 text-green-400 text-xs px-2 py-1 rounded-full">Public</span>
                        }
                        else
                        {
                            <span class="bg-gray-800 text-gray-500 text-xs px-2 py-1 rounded-full">Draft</span>
                        }
                    </td>
                    <td class="px-6 py-4">
                        @if (p.IsFeatured)
                        {
                            <span class="bg-amber-900/40 text-amber-400 text-xs px-2 py-1 rounded-full">⭐ Featured</span>
                        }
                </td>
                <td class="px-6 py-4 text-gray-500 text-xs">
                    @p.CreatedAt.ToString("dd MMM yyyy")
                </td>
                <td class="px-6 py-4">
                    <div class="flex items-center justify-end gap-2">
                            @if (p.Status == Portfolio.Models.Enums.VisibilityStatus.Public)
                            {
                                <a href="/electronics/@p.Slug" target="_blank" rel="noopener noreferrer"
                                   class="text-xs px-3 py-1.5 rounded-lg border border-gray-700 text-gray-400 hover:bg-gray-800 transition">
                                    👁 Preview
                                </a>
                            }
                        <form method="post" action="@Url.Action("Toggle", "Electronics", new { area = "Admin", id = p.Id })">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="text-xs px-3 py-1.5 rounded-lg border transition
                                        @(p.Status == Portfolio.Models.Enums.VisibilityStatus.Public
                                                                                ? "border-green-800 text-green-400 hover:bg-green-900/30"
                                                                                : "border-gray-700 text-gray-400 hover:bg-gray-800")">
                                @(p.Status == Portfolio.Models.Enums.VisibilityStatus.Public ? "Hide" : "Publish")
                            </button>
                        </form>
                        <a href="@Url.Action("Edit", "Electronics", new { area = "Admin", id = p.Id })"
                           class="text-xs px-3 py-1.5 rounded-lg border border-gray-700 text-gray-400 hover:bg-gray-800 transition">
                            Edit
                        </a>
                        <form method="post"
                              action="@Url.Action("Delete", "Electronics", new { area = "Admin", id = p.Id })"
                              onsubmit="return confirm('Are you sure you want to delete this project?')">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="text-xs px-3 py-1.5 rounded-lg border border-red-900 text-red-400 hover:bg-red-900/30 transition">
                                Delete
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
                        }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="text-center py-16 text-gray-600">
            No electronics projects yet.
        </div>
    }
</div>
