@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Something Went Wrong";
}

<div class="max-w-2xl mx-auto px-6 py-32 text-center">
    <p class="font-mono text-red-400 text-6xl font-bold mb-4">500</p>
    <h1 class="text-3xl font-bold text-white mb-4">The request could not be completed</h1>
    <p class="text-gray-500 mb-10">
        An unexpected problem occurred. Please try again later.
    </p>
    <a href="/"
       class="inline-flex bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition">
        Return Home
    </a>
</div>
