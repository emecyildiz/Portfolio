<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        const string siteName = "Emecworks";
        var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
        var isHomePage = currentPath == "/";
        var pageTitle = (ViewData["Title"] as string)?.Trim();
        var documentTitle = string.IsNullOrWhiteSpace(pageTitle)
            ? siteName
            : isHomePage
                ? pageTitle
                : $"{pageTitle} — {siteName}";
        var pageDescription = (ViewData["Description"] as string)?.Trim();
        if (string.IsNullOrWhiteSpace(pageDescription))
            pageDescription = "Emecworks engineering and cybersecurity portfolio.";

        var requestOrigin = $"{Context.Request.Scheme}://{Context.Request.Host}";
        var canonicalUrl = $"{requestOrigin}{Context.Request.Path}";
        var ogImage = (ViewBag.OgImage as string)?.Trim();
        var fullOgImage = $"{requestOrigin}/og-default.png";
        if (!string.IsNullOrWhiteSpace(ogImage))
        {
            var isSafeInternalImage = ogImage.StartsWith('/') &&
                                      !ogImage.StartsWith("//") &&
                                      Uri.TryCreate(ogImage, UriKind.Relative, out _);
            var isSafeExternalImage = Uri.TryCreate(ogImage, UriKind.Absolute, out var absoluteOgImage) &&
                                      absoluteOgImage.Scheme == Uri.UriSchemeHttps;
            if (isSafeInternalImage)
                fullOgImage = $"{requestOrigin}{ogImage}";
            else if (isSafeExternalImage)
                fullOgImage = ogImage;
        }
    }
    <title>@documentTitle</title>
    <meta name="description" content="@pageDescription" />
    <meta name="application-name" content="@siteName" />

    <meta property="og:title" content="@documentTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@fullOgImage" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="@siteName" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@documentTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:image" content="@fullOgImage" />

    <link rel="canonical" href="@canonicalUrl" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    @if (isHomePage)
    {
        <script type="application/ld+json">
            {
                "@@context": "https://schema.org",
                "@@graph": [
                    {
                        "@@type": "WebSite",
                        "@@id": "https://emecworks.com/#website",
                        "url": "https://emecworks.com/",
                        "name": "Emecworks",
                        "alternateName": "Emec Works",
                        "inLanguage": "en"
                    },
                    {
                        "@@type": "Person",
                        "@@id": "https://emecworks.com/#person",
                        "name": "Emeç Yıldız",
                        "url": "https://emecworks.com/",
                        "description": "Independent engineering and cybersecurity portfolio author."
                    }
                ]
            }
        </script>
    }

    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tailwind.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
</head>

<body class="public-site min-h-screen overflow-x-hidden antialiased">
    @{
        var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
    }

    <a href="#main-content" class="skip-link">Skip to content</a>
    <div id="pageLoadBar" class="page-load-bar" style="width: 0%;"></div>

    <header class="public-header">
        <nav aria-label="Primary navigation" class="public-nav">
            <a href="/" class="site-identity focus-ring" aria-label="Emecworks home">
                <span class="site-identity__name">Emecworks</span>
                <span class="site-identity__scope">Engineering · security · systems</span>
            </a>

            <div class="public-nav__desktop">
                <a href="/" class="public-nav__link @(currentPath == "/" ? "is-active" : "")">Index</a>

                <div class="public-nav__group">
                    <button type="button" class="public-nav__link public-nav__trigger">
                        Work <span aria-hidden="true">↓</span>
                    </button>
                    <div class="public-nav__dropdown">
                        <p class="public-nav__caption">Browse by discipline</p>
                        @if (ViewBag.NavCategories != null)
                        {
                            @foreach (var cat in (List<Portfolio.Models.Category>)ViewBag.NavCategories)
                            {
                                var url = cat.Slug switch
                                {
                                    "security" => "/security",
                                    "electronics" => "/electronics",
                                    "webapps" => "/webapps",
                                    "homelab" => "/homelab",
                                    "blog" => "/blog",
                                    "team" => "/team",
                                    _ => $"/{cat.Slug}"
                                };
                                var label = cat.Slug switch
                                {
                                    "security" => "Security research",
                                    "electronics" => "Electronics",
                                    "webapps" => "Software systems",
                                    "homelab" => "Homelab",
                                    "blog" => "Writing",
                                    "team" => "Collaborations",
                                    _ => cat.Name
                                };
                                var isActive = currentPath == url || currentPath.StartsWith($"{url}/");
                                <a href="@url" class="public-nav__dropdown-link @(isActive ? "is-active" : "")"><span>@label</span><span aria-hidden="true">↗</span></a>
                            }
                        }
                        @if (ViewBag.NavPages != null && ((List<Portfolio.Models.Page>)ViewBag.NavPages).Any())
                        {
                            <div class="public-nav__divider"></div>
                            @foreach (var navPage in (List<Portfolio.Models.Page>)ViewBag.NavPages)
                            {
                                <a href="/pages/@navPage.Slug" class="public-nav__dropdown-link"><span>@navPage.Title</span><span aria-hidden="true">→</span></a>
                            }
                        }
                    </div>
                </div>

                <a href="/blog" class="public-nav__link @(currentPath.StartsWith("/blog") ? "is-active" : "")">Notes</a>
                <a href="/activity" class="public-nav__link @(currentPath.StartsWith("/activity") ? "is-active" : "")">Activity</a>
                <button type="button" onclick="toggleSearch(true)" class="public-nav__link public-search-button" aria-label="Open search">Search <span aria-hidden="true">⌕</span></button>
                <a href="/hire" class="public-contact-link @(currentPath.StartsWith("/hire") ? "is-active" : "")">Contact</a>
            </div>

            <button id="mobileMenuBtn" type="button" aria-label="Toggle navigation" aria-controls="mobileMenu" aria-expanded="false" class="mobile-menu-button focus-ring">
                <span>Menu</span><span aria-hidden="true">＋</span>
            </button>
        </nav>

        <div id="mobileMenu" class="public-mobile-menu hidden">
            <div class="public-mobile-menu__inner">
                <a href="/" class="public-mobile-link @(currentPath == "/" ? "is-active" : "")">Index</a>
                @if (ViewBag.NavCategories != null)
                {
                    @foreach (var cat in (List<Portfolio.Models.Category>)ViewBag.NavCategories)
                    {
                        var url = cat.Slug switch
                        {
                            "security" => "/security",
                            "electronics" => "/electronics",
                            "webapps" => "/webapps",
                            "homelab" => "/homelab",
                            "blog" => "/blog",
                            "team" => "/team",
                            _ => $"/{cat.Slug}"
                        };
                        var label = cat.Slug switch
                        {
                            "security" => "Security research",
                            "electronics" => "Electronics",
                            "webapps" => "Software systems",
                            "homelab" => "Homelab",
                            "blog" => "Writing",
                            "team" => "Collaborations",
                            _ => cat.Name
                        };
                        var isActive = currentPath == url || currentPath.StartsWith($"{url}/");
                        <a href="@url" class="public-mobile-link @(isActive ? "is-active" : "")">@label <span aria-hidden="true">↗</span></a>
                    }
                }
                @if (ViewBag.NavPages != null)
                {
                    @foreach (var navPage in (List<Portfolio.Models.Page>)ViewBag.NavPages)
                    {
                        <a href="/pages/@navPage.Slug" class="public-mobile-link">@navPage.Title <span aria-hidden="true">→</span></a>
                    }
                }
                <a href="/activity" class="public-mobile-link @(currentPath.StartsWith("/activity") ? "is-active" : "")">Activity</a>
                <button type="button" onclick="toggleSearch(true)" class="public-mobile-link text-left">Search</button>
                <a href="/hire" class="public-mobile-contact">Contact / work request</a>
            </div>
        </div>
    </header>

    <div id="searchOverlay" role="dialog" aria-modal="true" aria-labelledby="searchOverlayTitle" aria-hidden="true" class="public-search-overlay hidden">
        <div class="public-search-panel">
            <div class="public-search-heading">
                <div>
                    <p class="archive-label">Archive search</p>
                    <h2 id="searchOverlayTitle">Find projects, research, and notes.</h2>
                </div>
                <button type="button" onclick="toggleSearch(false)" aria-label="Close search" class="public-search-close focus-ring">Close / Esc</button>
            </div>
            <form method="get" action="/search" class="public-search-form">
                <label for="searchInput" class="sr-only">Search the portfolio</label>
                <input type="search" name="q" id="searchInput" maxlength="100" autocomplete="off" placeholder="Malware analysis, ESP32, homelab..." />
                <button type="submit">Search</button>
            </form>
            <p class="public-search-help">Press Enter to search. Escape closes this window.</p>
        </div>
    </div>

    <main id="main-content" class="page-enter min-h-[70vh]">
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="public-footer__inner">
            <div class="public-footer__intro">
                <p class="archive-label">Independent technical archive</p>
                <p>Security research, electronics, software, and self-hosted infrastructure—documented as the work develops.</p>
            </div>
            @await Component.InvokeAsync("FooterLinks")
            <div class="public-footer__base">
                <p>Emecworks / independent work index</p>
                <nav aria-label="Privacy controls" class="public-footer__privacy">
                    <a href="/privacy">Privacy notice</a>
                    <button id="cookiePreferencesButton" type="button" aria-controls="analyticsConsent">
                        Cookie preferences
                    </button>
                </nav>
                <p>© @DateTime.UtcNow.Year Emeç Yıldız · Built and documented independently</p>
            </div>
        </div>
    </footer>

    <partial name="_AnalyticsConsent" />

    <script>
        let searchPreviousFocus = null;

        function trapFocusWithin(container, event) {
            const focusableElements = Array.from(container.querySelectorAll(
                'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
            )).filter(element => element.offsetParent !== null);
            if (focusableElements.length === 0) return;

            const firstElement = focusableElements[0];
            const lastElement = focusableElements[focusableElements.length - 1];
            if (event.shiftKey && document.activeElement === firstElement) {
                event.preventDefault();
                lastElement.focus();
            } else if (!event.shiftKey && document.activeElement === lastElement) {
                event.preventDefault();
                firstElement.focus();
            }
        }

        function toggleSearch(forceOpen) {
            const overlay = document.getElementById('searchOverlay');
            const shouldOpen = typeof forceOpen === 'boolean' ? forceOpen : overlay.classList.contains('hidden');

            overlay.classList.toggle('hidden', !shouldOpen);
            overlay.classList.toggle('flex', shouldOpen);
            overlay.setAttribute('aria-hidden', String(!shouldOpen));
            document.body.classList.toggle('overflow-hidden', shouldOpen);

            if (shouldOpen) {
                const mobileMenu = document.getElementById('mobileMenu');
                const mobileMenuButton = document.getElementById('mobileMenuBtn');
                mobileMenu.classList.add('hidden');
                mobileMenuButton.setAttribute('aria-expanded', 'false');
                searchPreviousFocus = document.activeElement;
                window.setTimeout(() => document.getElementById('searchInput').focus(), 0);
            } else if (searchPreviousFocus) {
                searchPreviousFocus.focus();
                searchPreviousFocus = null;
            }
        }

        document.addEventListener('keydown', function (event) {
            const searchOverlay = document.getElementById('searchOverlay');
            const searchIsOpen = !searchOverlay.classList.contains('hidden');
            if (searchIsOpen && event.key === 'Escape') {
                toggleSearch(false);
            } else if (searchIsOpen && event.key === 'Tab') {
                trapFocusWithin(searchOverlay, event);
            } else if (event.key === 'Escape') {
                const mobileMenu = document.getElementById('mobileMenu');
                const mobileMenuButton = document.getElementById('mobileMenuBtn');
                if (!mobileMenu.classList.contains('hidden')) {
                    mobileMenu.classList.add('hidden');
                    mobileMenuButton.setAttribute('aria-expanded', 'false');
                    mobileMenuButton.focus();
                }
            }
        });

        document.getElementById('searchOverlay').addEventListener('click', function (event) {
            if (event.target === this) toggleSearch(false);
        });

        document.getElementById('mobileMenuBtn').addEventListener('click', function () {
            const mobileMenu = document.getElementById('mobileMenu');
            const isOpen = mobileMenu.classList.toggle('hidden') === false;
            this.setAttribute('aria-expanded', String(isOpen));
            this.querySelector('[aria-hidden="true"]').textContent = isOpen ? '−' : '＋';
        });

        (function () {
            const bar = document.getElementById('pageLoadBar');
            document.addEventListener('click', function (event) {
                const link = event.target.closest('a');
                if (link && link.href && link.target !== '_blank' && link.href.startsWith(window.location.origin) && !link.href.includes('#')) {
                    bar.style.width = '34%';
                    window.setTimeout(() => bar.style.width = '72%', 150);
                }
            });
            window.addEventListener('load', function () {
                bar.style.width = '100%';
                window.setTimeout(() => bar.style.width = '0%', 300);
            });
        })();

        (function () {
            const preferencesButton = document.getElementById('cookiePreferencesButton');
            const consentPanel = document.getElementById('analyticsConsent');
            if (!preferencesButton || !consentPanel) return;

            preferencesButton.addEventListener('click', function () {
                consentPanel.classList.remove('cookie-consent--hidden');
                consentPanel.setAttribute('aria-hidden', 'false');
                const firstAction = consentPanel.querySelector('button');
                if (firstAction) firstAction.focus();
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
