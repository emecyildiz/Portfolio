<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@ViewData["Description"]" />
    <title>@ViewData["Title"] — Portfolyo</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        accent: {
                            blue:   '#3B82F6',
                            purple: '#8B5CF6',
                            teal:   '#14B8A6',
                            red:    '#EF4444',
                            amber:  '#F59E0B',
                        }
                    },
                    fontFamily: {
                        mono: ['JetBrains Mono', 'Fira Code', 'monospace'],
                    }
                }
            }
        }
    </script>

    <!-- JetBrains Mono — kod hissi için -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Inter', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0a0a0a; }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 3px; }

        /* Gradient text */
        .gradient-text {
            background: linear-gradient(135deg, #3B82F6, #8B5CF6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Glow effect */
        .glow-blue { box-shadow: 0 0 20px rgba(59,130,246,0.15); }
        .glow-purple { box-shadow: 0 0 20px rgba(139,92,246,0.15); }

        /* Nav link hover */
        .nav-link { position: relative; }
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0;
            height: 1px;
            background: linear-gradient(90deg, #3B82F6, #8B5CF6);
            transition: width 0.3s ease;
        }
        .nav-link:hover::after { width: 100%; }

        /* Fade in */
        .fade-in { animation: fadeIn 0.5s ease-in; }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>

<body class="bg-gray-950 text-gray-100 min-h-screen flex flex-col">

    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-gray-950/80 backdrop-blur-md border-b border-gray-800/50">
        <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">

            <!-- Logo -->
            <a href="/" class="font-mono text-lg font-bold gradient-text">
                ~/portfolyo
            </a>

            <!-- Desktop Nav -->
            <div class="hidden md:flex items-center gap-6">
                <a href="/" class="nav-link text-sm text-gray-400 hover:text-white transition">Ana Sayfa</a>

                <!-- İçerik dropdown -->
                <div class="relative group">
                    <button class="nav-link text-sm text-gray-400 hover:text-white transition flex items-center gap-1">
                        İçerikler
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    <div class="absolute top-full left-0 mt-2 w-48 bg-gray-900 border border-gray-800 rounded-xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all shadow-xl">
                        @if (ViewBag.NavCategories != null)
                        {
                            @foreach (var cat in (List<Portfolio.Models.Category>)ViewBag.NavCategories)
                            {
                                var url = cat.Slug switch
                                {
                                    "security" => "/security",
                                    "electronics" => "/electronics",
                                    "webapps" => "/webapps",
                                    "homelab" => "/homelab",
                                    "blog" => "/blog",
                                    "team" => "/team",
                                    _ => $"/{cat.Slug}"
                                };
                                var label = cat.Slug switch
                                {
                                    "security" => "Güvenlik",
                                    "electronics" => "Elektronik",
                                    "webapps" => "Web Apps",
                                    "homelab" => "Homelab",
                                    "blog" => "Blog",
                                    "team" => "Ekip",
                                    _ => cat.Name
                                };
                                <a href="@url" class="block px-4 py-2 text-sm text-gray-400 hover:bg-gray-800 hover:text-white transition">@label</a>
                            }
                        }
                        @if (ViewBag.NavPages != null && ((List<Portfolio.Models.Page>)ViewBag.NavPages).Any())
                        {
                            <div class="border-t border-gray-800 my-2"></div>
                            @foreach (var navPage in (List<Portfolio.Models.Page>)ViewBag.NavPages)
                            {
                                <a href="/pages/@navPage.Slug" class="block px-4 py-2 text-sm text-gray-400 hover:bg-gray-800 hover:text-white transition">@navPage.Title</a>
                            }
                        }
                    </div>
                </div>

                <a href="/activity" class="nav-link text-sm text-gray-400 hover:text-white transition">Aktivite</a>

                <!-- Arama ikonu -->
                <button onclick="toggleSearch()" class="text-gray-400 hover:text-white transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </button>

                <a href="/hire" class="text-sm bg-blue-600 hover:bg-blue-700 text-white px-4 py-1.5 rounded-lg transition font-medium">
                    İşe Al
                </a>
            </div>

            <!-- Mobile menu button -->
            <button id="mobileMenuBtn" class="md:hidden text-gray-400 hover:text-white">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </div>

        <!-- Mobile Nav -->
        <div id="mobileMenu" class="hidden md:hidden border-t border-gray-800 px-6 py-4 space-y-3">
            <a href="/" class="block text-sm text-gray-400 hover:text-white transition">Ana Sayfa</a>

            @if (ViewBag.NavCategories != null)
            {
                @foreach (var cat in (List<Portfolio.Models.Category>)ViewBag.NavCategories)
                {
                    var url = cat.Slug switch
                    {
                        "security" => "/security",
                        "electronics" => "/electronics",
                        "webapps" => "/webapps",
                        "homelab" => "/homelab",
                        "blog" => "/blog",
                        "team" => "/team",
                        _ => $"/{cat.Slug}"
                    };
                    <a href="@url" class="block text-sm text-gray-400 hover:text-white transition">@cat.Name</a>
                }
            }

            @if (ViewBag.NavPages != null)
            {
                @foreach (var navPage in (List<Portfolio.Models.Page>)ViewBag.NavPages)
                {
                    <a href="/pages/@navPage.Slug" class="block text-sm text-gray-400 hover:text-white transition">@navPage.Title</a>
                }
            }

            <a href="/activity" class="block text-sm text-gray-400 hover:text-white transition">Aktivite</a>
            <a href="/search" class="block text-sm text-gray-400 hover:text-white transition">Ara</a>
            <a href="/hire" class="block text-sm text-blue-400 hover:text-blue-300 transition">İşe Al</a>
        </div>
    </nav>

    <!-- Arama overlay -->
    <div id="searchOverlay" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-[60] flex items-start justify-center pt-32 px-4">
        <div class="w-full max-w-xl">
            <form method="get" action="/search" class="flex gap-2">
                <input type="text" name="q" id="searchInput"
                       placeholder="Ne arıyorsun? (Enter'a bas)"
                       class="flex-1 bg-gray-900 border border-gray-700 rounded-lg px-5 py-4 text-white text-lg focus:outline-none focus:border-blue-500 transition" />
                <button type="button" onclick="toggleSearch()"
                        class="bg-gray-800 hover:bg-gray-700 text-white px-5 py-4 rounded-lg transition">
                    ✕
                </button>
            </form>
        </div>
    </div>

    <script>
        function toggleSearch() {
            const overlay = document.getElementById('searchOverlay');
            overlay.classList.toggle('hidden');
            if (!overlay.classList.contains('hidden')) {
                document.getElementById('searchInput').focus();
            }
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.getElementById('searchOverlay').classList.add('hidden');
            }
        });

        document.getElementById('searchOverlay').addEventListener('click', function(e) {
            if (e.target === this) toggleSearch();
        });

        document.getElementById('mobileMenuBtn').addEventListener('click', function() {
            document.getElementById('mobileMenu').classList.toggle('hidden');
        });
    </script>

    <!-- İçerik -->
    <main class="flex-1 pt-16 fade-in">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-800/50 mt-20">
        <div class="max-w-6xl mx-auto px-6 py-10">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                <p class="font-mono text-sm text-gray-600">~/portfolyo</p>
                <div class="flex items-center gap-6">
                    <a href="https://github.com" target="_blank"
                       class="text-gray-600 hover:text-white transition text-sm">GitHub</a>
                    <a href="https://linkedin.com" target="_blank"
                       class="text-gray-600 hover:text-white transition text-sm">LinkedIn</a>
                    <a href="mailto:email@email.com"
                       class="text-gray-600 hover:text-white transition text-sm">E-posta</a>
                </div>
                <p class="text-gray-700 text-xs font-mono">© 2026</p>
            </div>
        </div>
    </footer>

    <script>
        // Mobile menu toggle
        document.getElementById('mobileMenuBtn').addEventListener('click', function() {
            document.getElementById('mobileMenu').classList.toggle('hidden');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>