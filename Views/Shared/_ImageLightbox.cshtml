<div id="imageLightbox"
     class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 p-3 backdrop-blur-sm sm:p-6"
     role="dialog"
     aria-modal="true"
     aria-labelledby="imageLightboxCaption"
     aria-hidden="true">
    <button type="button"
            data-lightbox-close
            class="focus-ring absolute right-4 top-4 z-10 rounded-md border border-white/15 bg-black/60 px-3 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-white transition hover:border-white/35"
            aria-label="Close image viewer">
        Close / Esc
    </button>

    <button type="button"
            data-lightbox-previous
            class="focus-ring absolute left-3 top-1/2 z-10 -translate-y-1/2 rounded-full border border-white/15 bg-black/60 p-3 text-xl text-white transition hover:border-cyan/50 hover:text-cyan sm:left-6"
            aria-label="Show previous image">
        <span aria-hidden="true">&#8592;</span>
    </button>

    <figure class="flex max-h-full max-w-full flex-col items-center justify-center gap-3">
        <img id="imageLightboxImage"
             src=""
             alt=""
             class="max-h-[calc(100vh-8rem)] max-w-[min(94vw,90rem)] rounded-lg object-contain shadow-2xl" />
        <figcaption id="imageLightboxCaption" class="max-w-3xl text-center text-sm leading-6 text-slate-300"></figcaption>
        <p data-lightbox-counter class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-500" aria-live="polite"></p>
    </figure>

    <button type="button"
            data-lightbox-next
            class="focus-ring absolute right-3 top-1/2 z-10 -translate-y-1/2 rounded-full border border-white/15 bg-black/60 p-3 text-xl text-white transition hover:border-cyan/50 hover:text-cyan sm:right-6"
            aria-label="Show next image">
        <span aria-hidden="true">&#8594;</span>
    </button>
</div>
