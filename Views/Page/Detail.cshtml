@model Portfolio.Models.Page
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Title;
    var coverImageUrl = Model.CoverImageUrl?.Trim();
    var hasSafeCoverImageUrl = !string.IsNullOrEmpty(coverImageUrl)
        && ((coverImageUrl.StartsWith('/') && !coverImageUrl.StartsWith("//") && Uri.TryCreate(coverImageUrl, UriKind.Relative, out _))
            || (Uri.TryCreate(coverImageUrl, UriKind.Absolute, out var coverImageUri) && coverImageUri.Scheme == Uri.UriSchemeHttps));
}

<article class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <nav aria-label="Breadcrumb" class="flex min-w-0 items-center gap-2 overflow-hidden font-mono text-[9px] uppercase tracking-[0.15em] text-slate-700"><a href="/" class="focus-ring rounded-sm transition hover:text-white">Home</a><span>/</span><span class="truncate text-slate-500">@Model.Slug</span></nav>

    <header class="mt-10 border-b border-white/[0.07] pb-10">
        <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-cyan">Portfolio document</p>
        <h1 class="mt-5 text-4xl font-semibold tracking-[-0.045em] text-white sm:text-6xl">@Model.Title</h1>
        <p class="mt-6 font-mono text-[9px] uppercase tracking-[0.14em] text-slate-700">Last updated @Model.UpdatedAt.ToString("dd MMMM yyyy")</p>
    </header>

    @if (hasSafeCoverImageUrl)
    {
        <figure class="mt-10 overflow-hidden rounded-2xl border border-white/[0.08] bg-panel"><img src="@coverImageUrl" alt="@Model.Title" class="max-h-[34rem] w-full object-cover" /></figure>
    }

    <div class="mx-auto mt-12 max-w-3xl prose prose-lg prose-invert prose-headings:font-semibold prose-headings:tracking-[-0.025em] prose-headings:text-white prose-p:leading-8 prose-p:text-slate-400 prose-a:text-cyan prose-a:no-underline hover:prose-a:text-white prose-code:rounded prose-code:bg-raised prose-code:px-1.5 prose-code:py-0.5 prose-code:text-signal prose-pre:border prose-pre:border-white/[0.08] prose-pre:bg-panel prose-blockquote:border-cyan prose-blockquote:text-slate-400 prose-strong:text-white prose-li:text-slate-400">@Html.Raw(ViewBag.ContentHtml)</div>

    <footer class="mt-14 border-t border-white/[0.07] pt-8"><a href="/" class="focus-ring inline-flex items-center gap-2 rounded-sm font-mono text-[10px] uppercase tracking-[0.14em] text-slate-500 transition hover:text-cyan"><span aria-hidden="true">←</span> Return home</a></footer>
</article>
