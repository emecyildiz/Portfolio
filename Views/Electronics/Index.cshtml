@model List<Portfolio.Models.Project>
@{
    ViewData["Title"] = "Electronics Projects";
    ViewData["Description"] = "Microcontroller projects, circuit designs, and electronics experiments.";
}

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
    <header class="grid gap-8 border-b border-white/[0.07] pb-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-amber-300">Archive / Hardware / 02</p>
            <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-[-0.045em] text-white sm:text-6xl">Electronics built from the component level up.</h1>
            <p class="mt-5 max-w-2xl text-base leading-7 text-slate-400">Embedded systems, circuit design, device analysis, and experiments built around ESP32, Arduino, sensors, and custom hardware.</p>
        </div>
        <div class="flex items-center gap-4 lg:flex-col lg:items-end"><span class="font-mono text-4xl font-semibold text-amber-300">@Model.Count.ToString("D2")</span><span class="font-mono text-[9px] uppercase tracking-[0.2em] text-slate-600">Documented builds</span></div>
    </header>

    @if (!Model.Any())
    {
        <div class="technical-frame surface mt-8 grid min-h-72 place-items-center rounded-2xl px-6 text-center"><div><p class="font-mono text-[10px] uppercase tracking-[0.22em] text-amber-300">Workbench clear</p><p class="mt-3 text-sm text-slate-500">Published electronics projects will appear here.</p></div></div>
    }
    else
    {
        <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var project in Model)
            {
                var extra = new Portfolio.Models.ExtraData.ElectronicsExtraData();
                if (!string.IsNullOrEmpty(project.ExtraData))
                    extra = System.Text.Json.JsonSerializer.Deserialize<Portfolio.Models.ExtraData.ElectronicsExtraData>(project.ExtraData) ?? extra;

                <a href="/electronics/@project.Slug" class="focus-ring card-lift surface group flex flex-col overflow-hidden rounded-2xl hover:border-amber-300/30">
                    <div class="relative h-52 overflow-hidden border-b border-white/[0.07] bg-raised">
                        @if (!string.IsNullOrEmpty(project.CoverImageUrl))
                        {
                            <img src="@project.CoverImageUrl" alt="@project.Title" loading="lazy" class="h-full w-full object-cover opacity-80 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-100" />
                        }
                        else
                        {
                            <div class="site-grid grid h-full place-items-center"><span class="font-mono text-[10px] uppercase tracking-[0.2em] text-slate-700">Hardware image pending</span></div>
                        }
                        <span class="absolute left-4 top-4 rounded-full border border-amber-300/20 bg-ink/80 px-2.5 py-1 font-mono text-[9px] uppercase tracking-[0.14em] text-amber-200 backdrop-blur">Build log</span>
                    </div>
                    <div class="flex flex-1 flex-col p-5 sm:p-6">
                        @if (!string.IsNullOrEmpty(extra.Microcontroller))
                        {
                            <span class="mb-4 w-fit rounded-md border border-amber-300/20 bg-amber-300/[0.06] px-2.5 py-1 font-mono text-[9px] uppercase tracking-[0.12em] text-amber-200">@extra.Microcontroller</span>
                        }
                        <h2 class="text-xl font-semibold tracking-[-0.02em] text-white transition group-hover:text-amber-200">@project.Title</h2>
                        <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-500">@project.Summary</p>
                        <div class="mt-auto flex items-center justify-between gap-4 border-t border-white/[0.07] pt-5 font-mono text-[9px] uppercase tracking-[0.12em] text-slate-600">
                            <span>@(project.PublishedAt?.ToString("dd MMM yyyy") ?? "Undated")</span>
                            @if (project.IsFeatured)
                            {
                                <span class="text-amber-300">Featured</span>
                            }
                            else
                            {
                                <span class="text-slate-700">Open record ↗</span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</section>
