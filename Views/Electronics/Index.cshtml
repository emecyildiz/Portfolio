@model List<Portfolio.Models.Project>
@{
    ViewData["Title"] = "Electronics Projects";
    ViewData["Description"] = "Microcontroller projects, circuit designs, and electronics experiments";
}

<div class="max-w-6xl mx-auto px-6 py-16">
    <div class="mb-12">
        <p class="font-mono text-blue-400 text-sm mb-2">// electronics</p>
        <h1 class="text-4xl font-bold text-white mb-4">Electronics Projects</h1>
        <p class="text-gray-400 max-w-2xl">
            Projects built with ESP32, Arduino, and other microcontrollers.
            Device analysis, circuit design, and embedded systems work.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-20 text-gray-600">
            <p class="font-mono">// no projects published yet</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var p in Model)
            {
                <a href="/electronics/@p.Slug"
                   class="bg-gray-900 border border-gray-800 hover:border-blue-900/50 rounded-xl overflow-hidden transition group">
                    @if (!string.IsNullOrEmpty(p.CoverImageUrl))
                    {
                        <img src="@p.CoverImageUrl" alt="@p.Title"
                             class="w-full h-48 object-cover group-hover:opacity-80 transition" />
                    }
                    else
                    {
                        <div class="w-full h-48 bg-gray-800 flex items-center justify-center">
                            <span class="font-mono text-gray-600 text-sm">// no image</span>
                        </div>
                    }
                    <div class="p-5">
                        <h2 class="text-white font-semibold mb-2 group-hover:text-blue-300 transition">
                            @p.Title
                        </h2>
                        <p class="text-gray-500 text-sm line-clamp-2 mb-4">@p.Summary</p>

                        @{
                            var extra = new Portfolio.Models.ExtraData.ElectronicsExtraData();
                            if (!string.IsNullOrEmpty(p.ExtraData))
                                extra = System.Text.Json.JsonSerializer.Deserialize<Portfolio.Models.ExtraData.ElectronicsExtraData>(p.ExtraData) ?? extra;
                        }

                        @if (!string.IsNullOrEmpty(extra.Microcontroller))
                        {
                            <span class="font-mono text-xs bg-gray-800 text-blue-300 px-2 py-1 rounded">
                                @extra.Microcontroller
                            </span>
                        }

                        <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-800">
                            <span class="text-xs text-gray-600">
                                @(p.PublishedAt?.ToString("dd MMM yyyy") ?? "")
                            </span>
                            @if (p.IsFeatured)
                            {
                                <span class="text-xs text-amber-400">⭐ Featured</span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>
