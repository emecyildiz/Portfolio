@model Portfolio.Models.Project
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;
    var extra = ViewBag.Extra as Portfolio.Models.ExtraData.ElectronicsExtraData
                ?? new Portfolio.Models.ExtraData.ElectronicsExtraData();
    var images = ViewBag.Images as List<Portfolio.Models.Media> ?? new();
    var related = ViewBag.Related as List<Portfolio.Models.Project> ?? new();
}

<div class="max-w-4xl mx-auto px-6 py-16">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-sm text-gray-600 mb-8 font-mono">
        <a href="/" class="hover:text-white transition">~</a>
        <span>/</span>
        <a href="/electronics" class="hover:text-white transition">electronics</a>
        <span>/</span>
        <span class="text-gray-400">@Model.Slug</span>
    </div>

    <!-- Header -->
    <div class="mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">@Model.Title</h1>
        <p class="text-gray-400 text-lg">@Model.Summary</p>

        <div class="flex flex-wrap items-center gap-4 mt-6 text-sm text-gray-600">
            <span>@(Model.PublishedAt?.ToString("dd MMMM yyyy") ?? "")</span>
            <span>@Model.ReadingTimeMinutes min read</span>
            <span>@Model.ViewCount @(Model.ViewCount == 1 ? "view" : "views")</span>
            @if (!string.IsNullOrEmpty(Model.GithubUrl))
            {
                <a href="@Model.GithubUrl" target="_blank" rel="noopener noreferrer"
                   class="text-blue-400 hover:text-blue-300 transition">GitHub →</a>
            }
            @if (!string.IsNullOrEmpty(Model.LiveDemoUrl))
            {
                <a href="@Model.LiveDemoUrl" target="_blank" rel="noopener noreferrer"
                   class="text-green-400 hover:text-green-300 transition">Demo →</a>
            }
        </div>
    </div>

    <!-- Cover image -->
    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <img src="@Model.CoverImageUrl" alt="@Model.Title"
             class="w-full rounded-xl mb-10 border border-gray-800" />
    }

    <!-- Technical details card -->
    @if (!string.IsNullOrEmpty(extra.Microcontroller) || (extra.Components?.Any() ?? false))
    {
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-10">
            <p class="text-xs text-gray-600 font-mono mb-4">// technical details</p>
            <div class="grid grid-cols-2 gap-6">
                @if (!string.IsNullOrEmpty(extra.Microcontroller))
                {
                    <div>
                        <p class="text-xs text-gray-600 mb-2">Microcontroller</p>
                        <p class="font-mono text-blue-300 text-sm">@extra.Microcontroller</p>
                    </div>
                }
                @if (!string.IsNullOrEmpty(extra.ProgrammingLanguage))
                {
                    <div>
                        <p class="text-xs text-gray-600 mb-2">Programming Language</p>
                        <p class="font-mono text-blue-300 text-sm">@extra.ProgrammingLanguage</p>
                    </div>
                }
                @if (extra.Components?.Any() ?? false)
                {
                    <div class="col-span-2">
                        <p class="text-xs text-gray-600 mb-2">Components</p>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var component in extra.Components!)
                            {
                                <span class="font-mono text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">
                                    @component
                                </span>
                            }
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(extra.SchematicUrl))
                {
                    <div>
                        <p class="text-xs text-gray-600 mb-2">Circuit Schematic</p>
                        <a href="@extra.SchematicUrl" target="_blank"
                           rel="noopener noreferrer"
                           class="text-blue-400 hover:text-blue-300 text-sm transition">Download →</a>
                    </div>
                }
                @if (extra.IsOpenSource == true)
                {
                    <div>
                        <p class="text-xs text-gray-600 mb-2">License</p>
                        <span class="text-green-400 text-sm">Open Source</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Markdown content -->
    <div class="prose prose-invert prose-lg max-w-none
                prose-headings:text-white prose-headings:font-bold
                prose-p:text-gray-400 prose-p:leading-relaxed
                prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline
                prose-code:text-green-400 prose-code:bg-gray-800 prose-code:px-1 prose-code:rounded prose-code:text-sm
                prose-pre:bg-gray-900 prose-pre:border prose-pre:border-gray-800
                prose-blockquote:border-blue-600 prose-blockquote:text-gray-400
                prose-strong:text-white prose-li:text-gray-400">
        @Html.Raw(ViewBag.ContentHtml)
    </div>

    <!-- Image gallery -->
    @if (images.Any())
    {
        <div class="mt-12">
            <h3 class="text-sm font-mono text-gray-600 mb-4">// images</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                @foreach (var img in images)
                {
                    <div>
                        <img src="@img.Url" alt="@img.AltText"
                             class="w-full rounded-lg border border-gray-800 hover:border-gray-600 transition" />
                        @if (!string.IsNullOrEmpty(img.Caption))
                        {
                            <p class="text-xs text-gray-600 mt-1 text-center">@img.Caption</p>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Related projects -->
    @if (related.Any())
    {
        <div class="mt-16 pt-8 border-t border-gray-800">
            <h3 class="text-sm font-mono text-gray-600 mb-6">// related projects</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                @foreach (var r in related)
                {
                    <a href="/electronics/@r.Slug"
                       class="bg-gray-900 border border-gray-800 hover:border-blue-900/50 rounded-xl p-4 transition group">
                        <h4 class="text-white text-sm font-medium group-hover:text-blue-300 transition mb-1">
                            @r.Title
                        </h4>
                        <p class="text-gray-600 text-xs line-clamp-2">@r.Summary</p>
                    </a>
                }
            </div>
        </div>
    }

    <div class="mt-12 pt-8 border-t border-gray-800">
        <a href="/electronics" class="text-sm text-gray-500 hover:text-white transition font-mono">
            ← /electronics
        </a>
    </div>
</div>
