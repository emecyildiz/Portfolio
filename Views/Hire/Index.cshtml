@{
    ViewData["Title"] = "İşe Al";
    ViewData["Description"] = "Siber güvenlik, ağ yapılandırması ve elektronik proje danışmanlığı";
    var services = ViewBag.Services as List<Portfolio.Models.Service> ?? new();
}

<div class="max-w-5xl mx-auto px-6 py-16">

    <!-- Header -->
    <div class="text-center mb-16">
        <p class="font-mono text-blue-400 text-sm mb-3">// hire me</p>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">
            Birlikte çalışalım
        </h1>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto">
            Siber güvenlik danışmanlığı, ağ güvenliği ve elektronik proje geliştirme konularında
            profesyonel destek sunuyorum.
        </p>
    </div>

    <!-- Hizmetler -->
    @if (services.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-20">
            @foreach (var service in services)
            {
                <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-blue-900/50 transition">
                    @if (!string.IsNullOrEmpty(service.IconClass))
                    {
                        <div class="w-10 h-10 bg-blue-900/30 rounded-lg flex items-center justify-center mb-4">
                            <i class="@service.IconClass text-blue-400"></i>
                        </div>
                    }
                    <h3 class="text-white font-semibold text-lg mb-2">@service.Title</h3>
                    <p class="text-gray-500 text-sm leading-relaxed mb-4">@service.Description</p>
                    <button onclick="selectService(@service.Id, '@service.Title')"
                            class="text-sm text-blue-400 hover:text-blue-300 transition">
                        Bu hizmet için başvur →
                    </button>
                </div>
            }
        </div>
    }

    <!-- İletişim formu -->
    <div class="max-w-2xl mx-auto">
        <div class="text-center mb-8">
            <p class="font-mono text-gray-600 text-sm mb-2">// contact</p>
            <h2 class="text-2xl font-bold text-white">İletişime Geç</h2>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="bg-green-900/30 border border-green-800 text-green-400 rounded-xl p-4 mb-6 text-sm">
                ✓ @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="bg-red-900/30 border border-red-800 text-red-400 rounded-xl p-4 mb-6 text-sm">
                ✕ @TempData["Error"]
            </div>
        }

        <form method="post" asp-controller="Hire" asp-action="Contact" asp-route-area="" class="bg-gray-900 border border-gray-800 rounded-xl p-8 space-y-4">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm text-gray-400 mb-1">Ad Soyad</label>
                    <input name="Name" type="text" required
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500 transition"
                           placeholder="Adın Soyadın" />
                </div>
                <div>
                    <label class="block text-sm text-gray-400 mb-1">E-posta</label>
                    <input name="Email" type="email" required
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500 transition"
                           placeholder="ornek@email.com" />
                </div>
            </div>

            <div>
                <label class="block text-sm text-gray-400 mb-1">Konu</label>
                <input name="Subject" type="text"
                       class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500 transition"
                       placeholder="Ne hakkında konuşmak istiyorsun?" />
            </div>

            @if (services.Any())
            {
                <div>
                    <label class="block text-sm text-gray-400 mb-1">İlgilendiğin Hizmet</label>
                    <select name="serviceId" id="serviceSelect"
                            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500 transition">
                        <option value="">Seçiniz (opsiyonel)</option>
                        @foreach (var s in services)
                        {
                            <option value="@s.Id">@s.Title</option>
                        }
                    </select>
                </div>
            }

            <div>
                <label class="block text-sm text-gray-400 mb-1">Mesaj</label>
                <textarea name="Message" rows="5" required
                          class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500 transition resize-none"
                          placeholder="Projen veya ihtiyacın hakkında kısaca anlat..."></textarea>
            </div>

            <button type="submit"
                    class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 rounded-lg transition">
                Gönder
            </button>
        </form>
    </div>
</div>
<script>
    function selectService(id, title) {
        document.getElementById('serviceSelect').value = id;
        document.querySelector('input[name="Subject"]').value = title + ' hakkında';
        document.querySelector('form[action*="contact"]').scrollIntoView({ behavior: 'smooth' });
    }
</script>