@{
    ViewData["Title"] = "İşe Al";
    ViewData["Description"] = "Siber güvenlik, ağ yapılandırması ve elektronik proje danışmanlığı";
    var services = ViewBag.Services as List<Portfolio.Models.Service> ?? new();
}

<div class="max-w-5xl mx-auto px-6 py-16">

    <!-- Header -->
    <div class="text-center mb-16">
        <div class="flex items-center justify-center gap-3 mb-3">
            <p class="font-mono text-blue-400 text-sm">// hire me</p>
            <button onclick="openTrackModal()"
                    class="text-xs border border-gray-700 hover:border-gray-500 text-gray-400 hover:text-white px-3 py-1 rounded-full transition">
                Talep Sorgula
            </button>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">
            Birlikte çalışalım
        </h1>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto mb-6">
            Siber güvenlik danışmanlığı, ağ güvenliği ve elektronik proje geliştirme konularında
            profesyonel destek sunuyorum.
        </p>

        @if (ViewBag.CvUrl != null)
        {
            <a href="@ViewBag.CvUrl" download
               class="inline-flex items-center gap-2 bg-gray-800 hover:bg-gray-700 text-white text-sm px-5 py-2.5 rounded-lg transition">
                📄 CV İndir
            </a>
        }
    </div>


    <!-- Hizmetler -->
    @if (services.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-20">
            @foreach (var service in services)
            {
                <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-blue-900/50 transition">
                    @if (!string.IsNullOrEmpty(service.IconClass))
                    {
                        <div class="w-10 h-10 bg-blue-900/30 rounded-lg flex items-center justify-center mb-4">
                            <i class="@service.IconClass text-blue-400"></i>
                        </div>
                    }
                    <h3 class="text-white font-semibold text-lg mb-2">@service.Title</h3>
                    <p class="text-gray-500 text-sm leading-relaxed mb-4">@service.Description</p>
                    <button onclick="selectService(@service.Id, '@service.Title')"
                            class="text-sm text-blue-400 hover:text-blue-300 transition">
                        Bu hizmet için başvur →
                    </button>
                </div>
            }
        </div>
    }

    <!-- İletişim formu -->
    <div class="max-w-2xl mx-auto">
        <div class="text-center mb-8">
            <p class="font-mono text-gray-600 text-sm mb-2">// contact</p>
            <h2 class="text-2xl font-bold text-white">İletişime Geç</h2>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="bg-green-900/30 border border-green-800 text-green-400 rounded-xl p-4 mb-6 text-sm">
                ✓ @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="bg-red-900/30 border border-red-800 text-red-400 rounded-xl p-4 mb-6 text-sm">
                ✕ @TempData["Error"]
            </div>
        }

        <form method="post" asp-controller="Hire" asp-action="Contact" asp-route-area="" class="bg-gray-900 border border-gray-800 rounded-xl p-8 space-y-4">
            @Html.AntiForgeryToken()
            <div style="position: absolute; left: -9999px;" aria-hidden="true">
                <label for="website">Website</label>
                <input type="text" name="website" id="website" tabindex="-1" autocomplete="off" />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm text-gray-400 mb-1">Ad Soyad</label>
                    <input name="Name" type="text" required
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500 transition"
                           placeholder="Adın Soyadın" />
                </div>
                <div>
                    <label class="block text-sm text-gray-400 mb-1">E-posta</label>
                    <input name="Email" type="email" required
                           class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500 transition"
                           placeholder="ornek@email.com" />
                </div>
            </div>

            <div>
                <label class="block text-sm text-gray-400 mb-1">Konu</label>
                <input name="Subject" type="text"
                       class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500 transition"
                       placeholder="Ne hakkında konuşmak istiyorsun?" />
            </div>

            @if (services.Any())
            {
                <div>
                    <label class="block text-sm text-gray-400 mb-1">İlgilendiğin Hizmet</label>
                    <select name="serviceId" id="serviceSelect"
                            class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500 transition">
                        <option value="">Seçiniz (opsiyonel)</option>
                        @foreach (var s in services)
                        {
                            <option value="@s.Id">@s.Title</option>
                        }
                    </select>
                </div>
            }

            <div>
                <label class="block text-sm text-gray-400 mb-1">Mesaj</label>
                <textarea name="Message" rows="5" required
                          class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-blue-500 transition resize-none"
                          placeholder="Projen veya ihtiyacın hakkında kısaca anlat..."></textarea>
            </div>

            <button type="submit"
                    class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 rounded-lg transition">
                Gönder
            </button>
        </form>
    </div>
    <!-- Talep Sorgula Modal -->
    <div id="trackModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8 max-w-md w-full relative">
            <button onclick="closeTrackModal()"
                    class="absolute top-4 right-4 text-gray-500 hover:text-white transition">
                ✕
            </button>

            <div class="text-center mb-6">
                <p class="font-mono text-gray-600 text-sm mb-2">// track</p>
                <h3 class="text-lg font-bold text-white">Talep Sorgula</h3>
            </div>

            @if (TempData["Success"] != null && TempData["TicketNumber"] != null)
            {
                <div class="bg-green-900/30 border border-green-800 rounded-xl p-4 mb-6 text-center">
                    <p class="text-green-400 text-sm mb-2">✓ Talebin alındı!</p>
                    <p class="text-xs text-gray-500 mb-2">Bilet numaran:</p>
                    <p class="font-mono text-white text-sm bg-gray-800 rounded-lg px-3 py-2 select-all">
                        @TempData["TicketNumber"]
                    </p>
                    <p class="text-xs text-gray-600 mt-2">Bu numarayı sakla, talebini sorgulamak için kullanacaksın.</p>
                </div>
            }

            @if (TempData["TrackError"] != null)
            {
                <div class="bg-red-900/30 border border-red-800 text-red-400 rounded-xl p-4 mb-6 text-sm text-center">
                    @TempData["TrackError"]
                </div>
            }

            @if (ViewBag.TrackedMessage != null)
            {
                var tracked = ViewBag.TrackedMessage as Portfolio.Models.ContactMessage;
                var statusText = tracked!.Status switch
                {
                    Portfolio.Models.Enums.ContactStatus.New => "Alındı, henüz incelenmedi",
                    Portfolio.Models.Enums.ContactStatus.Read => "İncelendi",
                    Portfolio.Models.Enums.ContactStatus.Replied => "Yanıtlandı — e-postanı kontrol et",
                    Portfolio.Models.Enums.ContactStatus.Archived => "Arşivlendi",
                    Portfolio.Models.Enums.ContactStatus.Spam => "İşlem yapılmadı",
                    _ => "Bilinmiyor"
                };
                var statusColor = tracked.Status switch
                {
                    Portfolio.Models.Enums.ContactStatus.Replied => "text-green-400 bg-green-900/30",
                    Portfolio.Models.Enums.ContactStatus.New => "text-blue-400 bg-blue-900/30",
                    _ => "text-gray-400 bg-gray-800"
                };

                <div class="bg-gray-900 border border-gray-800 rounded-xl p-5 mb-6">
                    <p class="text-xs text-gray-600 mb-2">@tracked.CreatedAt.ToString("dd MMM yyyy HH:mm") tarihli talep</p>
                    <span class="text-sm px-3 py-1 rounded-full @statusColor">@statusText</span>
                </div>
            }

            <form method="post" action="/hire/track" class="flex gap-2">
                @Html.AntiForgeryToken()
                <input name="ticketNumber" type="text" required
                       placeholder="Bilet numaranı yapıştır"
                       class="flex-1 bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white text-sm font-mono focus:outline-none focus:border-blue-500 transition" />
                <button type="submit"
                        class="bg-gray-800 hover:bg-gray-700 text-white text-sm px-5 py-2.5 rounded-lg transition">
                    Sorgula
                </button>
            </form>
        </div>
    </div>
</div>
<script>
    function selectService(id, title) {
        document.getElementById('serviceSelect').value = id;
        document.querySelector('input[name="Subject"]').value = title + ' hakkında';
        document.querySelector('form[action*="contact"]').scrollIntoView({ behavior: 'smooth' });
    }

    function openTrackModal() {
        document.getElementById('trackModal').classList.remove('hidden');
    }

    function closeTrackModal() {
        document.getElementById('trackModal').classList.add('hidden');
    }

    // Sunucudan sonuç geldiyse (TempData) modal'ı otomatik aç
    @if (TempData["Success"] != null || TempData["TrackError"] != null || ViewBag.TrackedMessage != null)
    {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                openTrackModal();
            });
            </text>
    }

    // Modal dışına tıklayınca kapat
    document.getElementById('trackModal').addEventListener('click', function(e) {
        if (e.target === this) closeTrackModal();
    });
</script>