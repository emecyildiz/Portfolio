@{
    ViewData["Title"] = "Hire Me";
    ViewData["Description"] = "Cybersecurity, network infrastructure, software, and electronics project consulting.";
    var services = ViewBag.Services as List<Portfolio.Models.Service> ?? new();
    var cvUrl = (ViewBag.CvUrl as string)?.Trim();
    var hasSafeCvUrl = !string.IsNullOrEmpty(cvUrl)
        && ((cvUrl.StartsWith('/') && !cvUrl.StartsWith("//") && Uri.TryCreate(cvUrl, UriKind.Relative, out _))
            || (Uri.TryCreate(cvUrl, UriKind.Absolute, out var cvUri) && cvUri.Scheme == Uri.UriSchemeHttps));
}

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
    <header class="relative overflow-hidden border-b border-white/[0.07] pb-16">
        <div aria-hidden="true" class="site-grid absolute inset-0 -z-10 opacity-50"></div>
        <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
            <div>
                <div class="flex flex-wrap items-center gap-3"><span class="inline-flex items-center gap-2 rounded-full border border-signal/20 bg-signal/[0.06] px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.2em] text-signal"><span class="h-1.5 w-1.5 rounded-full bg-signal"></span>Available for selected work</span><span class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600">Secure · Traceable · Direct</span></div>
                <h1 class="mt-7 max-w-5xl text-5xl font-semibold leading-[.95] tracking-[-0.055em] text-white sm:text-7xl">Hire me for security and engineering work<span class="text-signal">.</span></h1>
                <p class="mt-7 max-w-3xl text-lg leading-8 text-slate-400">I take on selected cybersecurity, network infrastructure, software, and electronics work with a clear scope, documented decisions, and practical outcomes.</p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
                <button type="button" onclick="openTrackModal()" class="focus-ring inline-flex items-center justify-center gap-2 rounded-md border border-white/10 bg-white/[0.02] px-5 py-3.5 text-sm font-medium text-slate-300 transition hover:border-cyan/30 hover:text-white">Track a request <span aria-hidden="true">→</span></button>
                @if (hasSafeCvUrl)
                {
                    <a href="@cvUrl" download class="focus-ring inline-flex items-center justify-center gap-2 rounded-md bg-signal px-5 py-3.5 text-sm font-semibold text-ink transition hover:bg-white">Download CV <span aria-hidden="true">↓</span></a>
                }
            </div>
        </div>
    </header>

    @if (services.Any())
    {
        <section class="py-16 lg:py-20">
            <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><p class="font-mono text-[10px] uppercase tracking-[0.22em] text-cyan">Service modules / @services.Count.ToString("D2")</p><h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-white">Ways I can contribute.</h2></div><p class="max-w-md text-sm leading-6 text-slate-500">Choose a service to prefill the request form, or describe a custom scope below.</p></div>
            <div class="grid gap-4 md:grid-cols-2">
                @foreach (var service in services)
                {
                    <article class="card-lift technical-frame surface flex min-h-60 flex-col rounded-2xl p-6 hover:border-cyan/30">
                        <div class="flex items-start justify-between gap-4"><span class="grid h-10 w-10 place-items-center rounded-lg border border-cyan/20 bg-cyan/[0.05] font-mono text-[10px] text-cyan">@service.SortOrder.ToString("D2")</span>@if (!string.IsNullOrEmpty(service.IconClass)){<i aria-hidden="true" class="@service.IconClass text-cyan"></i>}</div>
                        <h3 class="mt-7 text-xl font-semibold tracking-[-0.02em] text-white">@service.Title</h3>
                        <p class="mt-3 text-sm leading-6 text-slate-500">@service.Description</p>
                        <button type="button" data-service-id="@service.Id" data-service-title="@service.Title" onclick="selectService(this)" class="focus-ring mt-auto inline-flex w-fit items-center gap-2 rounded-sm pt-7 text-sm font-medium text-cyan transition hover:text-white">Request this service <span aria-hidden="true">→</span></button>
                    </article>
                }
            </div>
        </section>
    }

    <section class="grid gap-10 border-t border-white/[0.07] pt-16 lg:grid-cols-[.65fr_1.35fr] lg:gap-16 lg:pt-20">
        <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-signal">Work inquiry</p>
            <h2 class="mt-4 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">Tell me what you need built, tested, or understood.</h2>
            <p class="mt-5 text-sm leading-7 text-slate-500">Share the project or role, desired outcome, timeline, and constraints. A ticket number is generated after submission so you can check the inquiry status later.</p>
            <ol class="mt-8 space-y-4 border-l border-line pl-5">
                <li><span class="font-mono text-[9px] uppercase tracking-[0.16em] text-signal">01 / Submit</span><p class="mt-1 text-sm text-slate-400">Describe the system or project.</p></li>
                <li><span class="font-mono text-[9px] uppercase tracking-[0.16em] text-cyan">02 / Retain</span><p class="mt-1 text-sm text-slate-400">Save the generated ticket number.</p></li>
                <li><span class="font-mono text-[9px] uppercase tracking-[0.16em] text-violet-300">03 / Track</span><p class="mt-1 text-sm text-slate-400">Check the review status at any time.</p></li>
            </ol>
        </div>

        <div>
            @if (TempData["Success"] != null)
            {
                <div role="status" class="mb-4 rounded-xl border border-signal/20 bg-signal/[0.06] p-4 text-sm text-signal">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div role="alert" class="mb-4 rounded-xl border border-rose-300/20 bg-rose-300/[0.06] p-4 text-sm text-rose-200">@TempData["Error"]</div>
            }

            <form id="contactForm" method="post" asp-controller="Hire" asp-action="Contact" asp-route-area="" class="technical-frame surface space-y-5 rounded-2xl p-5 sm:p-8">
                <div class="absolute -left-[9999px]" aria-hidden="true"><label for="website">Website</label><input type="text" name="Website" id="website" maxlength="200" tabindex="-1" autocomplete="off" /></div>

                <div class="grid gap-5 sm:grid-cols-2">
                    <div><label for="contactName" class="mb-2 block font-mono text-[9px] uppercase tracking-[0.14em] text-slate-500">Full name</label><input id="contactName" name="Name" type="text" required maxlength="100" autocomplete="name" placeholder="Your full name" class="w-full rounded-lg border border-white/10 bg-ink/60 px-4 py-3 text-sm text-white placeholder:text-slate-700 transition focus:border-cyan/40 focus:outline-none" /></div>
                    <div><label for="contactEmail" class="mb-2 block font-mono text-[9px] uppercase tracking-[0.14em] text-slate-500">Email</label><input id="contactEmail" name="Email" type="email" required maxlength="300" autocomplete="email" placeholder="you@example.com" class="w-full rounded-lg border border-white/10 bg-ink/60 px-4 py-3 text-sm text-white placeholder:text-slate-700 transition focus:border-cyan/40 focus:outline-none" /></div>
                </div>

                <div><label for="contactSubject" class="mb-2 block font-mono text-[9px] uppercase tracking-[0.14em] text-slate-500">Project or role</label><input id="contactSubject" name="Subject" type="text" maxlength="200" placeholder="What are you hiring for?" class="w-full rounded-lg border border-white/10 bg-ink/60 px-4 py-3 text-sm text-white placeholder:text-slate-700 transition focus:border-cyan/40 focus:outline-none" /></div>

                @if (services.Any())
                {
                    <div><label for="serviceSelect" class="mb-2 block font-mono text-[9px] uppercase tracking-[0.14em] text-slate-500">Service of interest</label><select name="ServiceId" id="serviceSelect" class="w-full rounded-lg border border-white/10 bg-ink/60 px-4 py-3 text-sm text-white transition focus:border-cyan/40 focus:outline-none"><option value="">Select a service (optional)</option>@foreach (var service in services){<option value="@service.Id">@service.Title</option>}</select></div>
                }

                <div><label for="contactMessage" class="mb-2 block font-mono text-[9px] uppercase tracking-[0.14em] text-slate-500">Project brief</label><textarea id="contactMessage" name="Message" rows="6" required maxlength="5000" placeholder="Describe the work, expected outcome, timeline, and constraints..." class="w-full resize-y rounded-lg border border-white/10 bg-ink/60 px-4 py-3 text-sm leading-6 text-white placeholder:text-slate-700 transition focus:border-cyan/40 focus:outline-none"></textarea><p class="mt-2 text-xs text-slate-700">Avoid including passwords, access tokens, private keys, or confidential datasets.</p></div>

                <div class="border-t border-white/10 pt-5 text-xs leading-6 text-slate-500">
                    Submitting this form stores the details above, your IP address, and browser information so the request can be answered and protected from abuse.
                    This is separate from optional analytics. See the <a href="/privacy" class="font-medium text-cyan underline underline-offset-4">privacy notice</a>.
                </div>

                <button type="submit" class="focus-ring inline-flex w-full items-center justify-center gap-3 rounded-md bg-signal px-6 py-3.5 text-sm font-semibold text-ink transition hover:bg-white">Send work inquiry <span aria-hidden="true">↗</span></button>
            </form>
        </div>
    </section>

    <div id="trackModal" class="hidden fixed inset-0 z-[80] items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="trackModalTitle" aria-describedby="trackModalDescription" aria-hidden="true">
        <div id="trackModalOverlay" class="absolute inset-0 bg-ink/85 backdrop-blur-sm"></div>
        <div class="technical-frame surface relative max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-2xl p-5 sm:p-8">
            <button id="trackModalClose" type="button" onclick="closeTrackModal()" aria-label="Close request tracking" class="focus-ring absolute right-4 top-4 rounded-md border border-white/10 px-3 py-2 font-mono text-[10px] text-slate-400 transition hover:text-white">ESC</button>
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-cyan">Request channel</p>
            <h2 id="trackModalTitle" class="mt-3 text-2xl font-semibold tracking-[-0.025em] text-white">Track a request</h2>
            <p id="trackModalDescription" class="mt-3 text-sm leading-6 text-slate-500">Paste the ticket number generated when the request was submitted.</p>

            @if (TempData["Success"] != null && TempData["TicketNumber"] != null)
            {
                <div class="mt-6 rounded-xl border border-signal/20 bg-signal/[0.06] p-5"><p class="text-sm font-medium text-signal">Your request has been received.</p><p class="mt-3 font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">Ticket number</p><p class="mt-2 select-all break-all rounded-lg border border-white/[0.07] bg-ink/60 px-3 py-2.5 font-mono text-sm text-white">@TempData["TicketNumber"]</p><p class="mt-2 text-xs text-slate-600">Store this number somewhere safe; it is required for tracking.</p></div>
            }

            @if (TempData["TrackError"] != null)
            {
                <div role="alert" class="mt-6 rounded-xl border border-rose-300/20 bg-rose-300/[0.06] p-4 text-sm text-rose-200">@TempData["TrackError"]</div>
            }

            @if (ViewBag.TrackedMessage != null)
            {
                var tracked = ViewBag.TrackedMessage as Portfolio.Models.ContactMessage;
                var statusText = tracked!.Status switch
                {
                    Portfolio.Models.Enums.ContactStatus.New => "Received, awaiting review",
                    Portfolio.Models.Enums.ContactStatus.Read => "Under review",
                    Portfolio.Models.Enums.ContactStatus.Replied => "Replied — check your email",
                    Portfolio.Models.Enums.ContactStatus.Archived => "Archived",
                    Portfolio.Models.Enums.ContactStatus.Spam => "No action taken",
                    _ => "Unknown"
                };
                var statusColor = tracked.Status switch
                {
                    Portfolio.Models.Enums.ContactStatus.Replied => "border-signal/20 bg-signal/[0.06] text-signal",
                    Portfolio.Models.Enums.ContactStatus.New => "border-cyan/20 bg-cyan/[0.06] text-cyan",
                    _ => "border-white/10 bg-white/[0.04] text-slate-400"
                };
                <div class="mt-6 rounded-xl border border-white/[0.07] bg-white/[0.02] p-5"><p class="font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">Submitted @tracked.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</p><span class="mt-3 inline-block rounded-full border px-3 py-1.5 text-xs @statusColor">@statusText</span></div>
            }

            <form method="post" asp-controller="Hire" asp-action="TrackTicket" asp-route-area="" class="mt-6 flex flex-col gap-3 sm:flex-row"><label for="ticketNumber" class="sr-only">Ticket number</label><input id="ticketNumber" name="ticketNumber" type="text" required maxlength="36" autocomplete="off" placeholder="00000000-0000-0000-0000-000000000000" class="min-w-0 flex-1 rounded-lg border border-white/10 bg-ink/60 px-4 py-3 font-mono text-xs text-white placeholder:text-slate-700 transition focus:border-cyan/40 focus:outline-none" /><button type="submit" class="focus-ring rounded-md bg-signal px-5 py-3 text-sm font-semibold text-ink transition hover:bg-white">Check status</button></form>
        </div>
    </div>
</section>

<script>
    let trackModalPreviousFocus = null;

    function trapTrackModalFocus(event) {
        const modal = document.getElementById('trackModal');
        const focusableElements = Array.from(modal.querySelectorAll(
            'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )).filter(element => element.offsetParent !== null);
        if (focusableElements.length === 0) return;

        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];
        if (event.shiftKey && document.activeElement === firstElement) {
            event.preventDefault();
            lastElement.focus();
        } else if (!event.shiftKey && document.activeElement === lastElement) {
            event.preventDefault();
            firstElement.focus();
        }
    }

    function selectService(button) {
        const serviceSelect = document.getElementById('serviceSelect');
        if (!serviceSelect) return;

        serviceSelect.value = button.dataset.serviceId;
        document.getElementById('contactSubject').value = `Regarding ${button.dataset.serviceTitle}`;
        document.getElementById('contactForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function openTrackModal() {
        const modal = document.getElementById('trackModal');
        trackModalPreviousFocus = document.activeElement;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('overflow-hidden');
        window.setTimeout(() => document.getElementById('ticketNumber').focus(), 0);
    }

    function closeTrackModal() {
        const modal = document.getElementById('trackModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('overflow-hidden');
        if (trackModalPreviousFocus) {
            trackModalPreviousFocus.focus();
            trackModalPreviousFocus = null;
        }
    }

    @if (TempData["Success"] != null || TempData["TrackError"] != null || ViewBag.TrackedMessage != null)
    {
        <text>document.addEventListener('DOMContentLoaded', openTrackModal);</text>
    }

    document.getElementById('trackModalOverlay').addEventListener('click', closeTrackModal);
    document.addEventListener('keydown', function (event) {
        const modalIsOpen = !document.getElementById('trackModal').classList.contains('hidden');
        if (modalIsOpen && event.key === 'Escape') closeTrackModal();
        else if (modalIsOpen && event.key === 'Tab') trapTrackModalFocus(event);
    });
</script>
