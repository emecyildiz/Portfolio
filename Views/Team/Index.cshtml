@model List<Portfolio.Models.TeamProject>
@{
    ViewData["Title"] = "Team Projects";
    ViewData["Description"] = "Hackathons, collaborative engineering, and team-built projects.";
}

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
    <header class="grid gap-8 border-b border-white/[0.07] pb-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-orange-300">Archive / Collaboration / 06</p>
            <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-[-0.045em] text-white sm:text-6xl">Complex problems solved together.</h1>
            <p class="mt-5 max-w-2xl text-base leading-7 text-slate-400">Hackathons, collaborative engineering, and projects where the result depended on clear roles, shared decisions, and fast iteration.</p>
        </div>
        <div class="flex items-center gap-4 lg:flex-col lg:items-end"><span class="font-mono text-4xl font-semibold text-orange-300">@Model.Count.ToString("D2")</span><span class="font-mono text-[9px] uppercase tracking-[0.2em] text-slate-600">Collaborations</span></div>
    </header>

    @if (!Model.Any())
    {
        <div class="technical-frame surface mt-8 grid min-h-72 place-items-center rounded-2xl px-6 text-center"><div><p class="font-mono text-[10px] uppercase tracking-[0.22em] text-orange-300">No public collaborations</p><p class="mt-3 text-sm text-slate-500">Published team projects will appear here.</p></div></div>
    }
    else
    {
        <div class="mt-8 grid gap-5 lg:grid-cols-2">
            @foreach (var project in Model)
            {
                <a href="/team/@project.Slug" class="focus-ring card-lift surface group overflow-hidden rounded-2xl hover:border-orange-300/30">
                    <div class="relative h-56 overflow-hidden border-b border-white/[0.07] bg-raised">
                        @if (!string.IsNullOrEmpty(project.CoverImageUrl))
                        {
                            <img src="@project.CoverImageUrl" alt="@project.Title" loading="lazy" class="h-full w-full object-cover opacity-75 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-100" />
                        }
                        else
                        {
                            <div class="site-grid grid h-full place-items-center"><span class="font-mono text-[10px] uppercase tracking-[0.2em] text-slate-700">Collaboration record</span></div>
                        }
                        @if (!string.IsNullOrEmpty(project.EventName))
                        {
                            <span class="absolute left-4 top-4 rounded-full border border-orange-300/20 bg-ink/80 px-3 py-1.5 font-mono text-[9px] uppercase tracking-[0.14em] text-orange-200 backdrop-blur">@project.EventName</span>
                        }
                    </div>
                    <div class="p-5 sm:p-6">
                        <h2 class="text-xl font-semibold tracking-[-0.02em] text-white transition group-hover:text-orange-200">@project.Title</h2>
                        <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-500">@project.Summary</p>
                        <div class="mt-6 flex items-center justify-between gap-4 border-t border-white/[0.07] pt-5 font-mono text-[9px] uppercase tracking-[0.12em] text-slate-600">
                            <span>@(project.EventDate?.ToString("MMM yyyy") ?? "Undated")</span>
                            @if (!string.IsNullOrEmpty(project.Outcome))
                            {
                                <span class="rounded-full border border-orange-300/20 bg-orange-300/[0.06] px-2.5 py-1 text-orange-200">@project.Outcome</span>
                            }
                            else
                            {
                                <span class="text-slate-700">Open project ↗</span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</section>
