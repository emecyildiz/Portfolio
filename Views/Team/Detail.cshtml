@model Portfolio.Models.TeamProject
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;
    var members = ViewBag.Members as List<Portfolio.Models.ExtraData.TeamMember> ?? new();
    var images = ViewBag.Images as List<Portfolio.Models.Media> ?? new();
    var githubUrl = Model.GithubUrl?.Trim();
    var liveDemoUrl = Model.LiveDemoUrl?.Trim();
    var eventUrl = Model.EventUrl?.Trim();
    var hasSafeGithubUrl = Uri.TryCreate(githubUrl, UriKind.Absolute, out var githubUri) && githubUri.Scheme == Uri.UriSchemeHttps;
    var hasSafeLiveDemoUrl = Uri.TryCreate(liveDemoUrl, UriKind.Absolute, out var liveDemoUri) && liveDemoUri.Scheme == Uri.UriSchemeHttps;
    var hasSafeEventUrl = Uri.TryCreate(eventUrl, UriKind.Absolute, out var eventUri) && eventUri.Scheme == Uri.UriSchemeHttps;
}

<article class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <nav aria-label="Breadcrumb" class="flex min-w-0 items-center gap-2 overflow-hidden font-mono text-[9px] uppercase tracking-[0.15em] text-slate-700"><a href="/" class="focus-ring rounded-sm transition hover:text-white">Home</a><span>/</span><a href="/team" class="focus-ring rounded-sm transition hover:text-orange-300">Team</a><span>/</span><span class="truncate text-slate-500">@Model.Slug</span></nav>

    <header class="mt-10 grid gap-8 border-b border-white/[0.07] pb-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-orange-300">@(string.IsNullOrEmpty(Model.EventName) ? "Collaboration record" : Model.EventName)</p>
            <h1 class="mt-5 max-w-4xl text-4xl font-semibold leading-[1.04] tracking-[-0.045em] text-white sm:text-6xl">@Model.Title</h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-400">@Model.Summary</p>
            <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">
                @if (Model.EventDate.HasValue){<span>@Model.EventDate.Value.ToString("dd MMMM yyyy")</span>}
                <span>@members.Count @(members.Count == 1 ? "member" : "members")</span>
                @if (!string.IsNullOrEmpty(Model.Outcome)){<span class="text-orange-300">@Model.Outcome</span>}
            </div>
        </div>
        <div class="flex flex-wrap gap-2 lg:max-w-48 lg:justify-end">
            @if (hasSafeGithubUrl){<a href="@githubUrl" target="_blank" rel="noopener noreferrer" class="focus-ring rounded-md border border-white/10 px-4 py-2.5 text-xs text-slate-300 transition hover:border-orange-300/30 hover:text-white">GitHub ↗</a>}
            @if (hasSafeLiveDemoUrl){<a href="@liveDemoUrl" target="_blank" rel="noopener noreferrer" class="focus-ring rounded-md bg-signal px-4 py-2.5 text-xs font-semibold text-ink transition hover:bg-white">Demo ↗</a>}
            @if (hasSafeEventUrl){<a href="@eventUrl" target="_blank" rel="noopener noreferrer" class="focus-ring rounded-md border border-orange-300/20 bg-orange-300/[0.05] px-4 py-2.5 text-xs text-orange-200 transition hover:border-orange-300/40">Event ↗</a>}
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <figure class="mt-10 overflow-hidden rounded-2xl border border-white/[0.08] bg-panel"><img src="@Model.CoverImageUrl" alt="@Model.Title" class="max-h-[38rem] w-full object-cover" /></figure>
    }

    <section class="surface mt-10 rounded-2xl p-5 sm:p-7">
        <div class="grid gap-6 sm:grid-cols-2">
            <div><p class="font-mono text-[9px] uppercase tracking-[0.16em] text-slate-600">My role</p><p class="mt-2 text-sm text-white">@Model.MyRole</p></div>
            <div><p class="font-mono text-[9px] uppercase tracking-[0.16em] text-slate-600">Team size</p><p class="mt-2 text-sm text-white">@members.Count @(members.Count == 1 ? "member" : "members")</p></div>
        </div>
        @if (members.Any())
        {
            <div class="mt-6 border-t border-white/[0.07] pt-6"><p class="mb-4 font-mono text-[9px] uppercase tracking-[0.16em] text-slate-600">Team roster</p><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var member in members)
                {
                    var memberGithubUrl = member.GithubUrl?.Trim();
                    var memberLinkedinUrl = member.LinkedinUrl?.Trim();
                    var hasSafeMemberGithubUrl = Uri.TryCreate(memberGithubUrl, UriKind.Absolute, out var memberGithubUri) && memberGithubUri.Scheme == Uri.UriSchemeHttps;
                    var hasSafeMemberLinkedinUrl = Uri.TryCreate(memberLinkedinUrl, UriKind.Absolute, out var memberLinkedinUri) && memberLinkedinUri.Scheme == Uri.UriSchemeHttps;
                    <div class="rounded-xl border border-white/[0.07] bg-white/[0.02] p-4"><p class="text-sm font-medium text-white">@member.Name</p><p class="mt-1 text-xs text-slate-500">@member.Role</p><div class="mt-3 flex gap-3 font-mono text-[9px] uppercase tracking-[0.1em]">@if (hasSafeMemberGithubUrl){<a href="@memberGithubUrl" target="_blank" rel="noopener noreferrer" class="focus-ring rounded-sm text-orange-300 hover:text-white">GitHub ↗</a>}@if (hasSafeMemberLinkedinUrl){<a href="@memberLinkedinUrl" target="_blank" rel="noopener noreferrer" class="focus-ring rounded-sm text-orange-300 hover:text-white">LinkedIn ↗</a>}</div></div>
                }
            </div></div>
        }
    </section>

    <div class="mx-auto mt-12 max-w-3xl prose prose-lg prose-invert prose-headings:font-semibold prose-headings:tracking-[-0.025em] prose-headings:text-white prose-p:leading-8 prose-p:text-slate-400 prose-a:text-orange-300 prose-a:no-underline hover:prose-a:text-white prose-code:rounded prose-code:bg-raised prose-code:px-1.5 prose-code:py-0.5 prose-code:text-signal prose-pre:border prose-pre:border-white/[0.08] prose-pre:bg-panel prose-blockquote:border-orange-300 prose-blockquote:text-slate-400 prose-strong:text-white prose-li:text-slate-400">@Html.Raw(ViewBag.ContentHtml)</div>

    @if (images.Any())
    {
        <section class="mt-16 border-t border-white/[0.07] pt-10"><p class="mb-5 font-mono text-[9px] uppercase tracking-[0.18em] text-orange-300">Project gallery / @images.Count.ToString("D2")</p><div class="grid grid-cols-2 gap-3 md:grid-cols-3">@foreach (var image in images){<img src="@image.Url" alt="@image.AltText" loading="lazy" class="aspect-[4/3] w-full rounded-xl border border-white/[0.08] object-cover transition hover:border-orange-300/30" />}</div></section>
    }

    <footer class="mt-14 border-t border-white/[0.07] pt-8"><a href="/team" class="focus-ring inline-flex items-center gap-2 rounded-sm font-mono text-[10px] uppercase tracking-[0.14em] text-slate-500 transition hover:text-orange-300"><span aria-hidden="true">←</span> Back to collaborations</a></footer>
</article>
