@model Portfolio.Models.HomelabPost
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;
    var hardware = ViewBag.Hardware as List<string> ?? new();
    var software = ViewBag.Software as List<string> ?? new();
    var images = ViewBag.Images as List<Portfolio.Models.Media> ?? new();
    var related = ViewBag.Related as List<Portfolio.Models.HomelabPost> ?? new();
    var topologyJson = ViewBag.NetworkTopologyJson as string;
}

<div class="max-w-4xl mx-auto px-6 py-16">

    <div class="flex items-center gap-2 text-sm text-gray-600 mb-8 font-mono">
        <a href="/" class="hover:text-white transition">~</a>
        <span>/</span>
        <a href="/homelab" class="hover:text-white transition">homelab</a>
        <span>/</span>
        <span class="text-gray-400">@Model.Slug</span>
    </div>

    <div class="mb-10">
        <div class="flex items-center gap-2 mb-4">
            <span class="font-mono text-xs text-teal-400 bg-teal-900/20 px-2 py-1 rounded">@Model.Topic</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">@Model.Title</h1>
        <p class="text-gray-400 text-lg">@Model.Summary</p>

        <div class="flex flex-wrap items-center gap-4 mt-6 text-sm text-gray-600">
            <span>@(Model.PublishedAt?.ToString("dd MMMM yyyy") ?? "")</span>
            <span>@Model.ReadingTimeMinutes dk okuma</span>
            <span>@Model.ViewCount görüntülenme</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <img src="@Model.CoverImageUrl" alt="@Model.Title"
             class="w-full rounded-xl mb-10 border border-gray-800" />
    }

    <!-- Donanım / Yazılım kartı -->
    @if (hardware.Any() || software.Any())
    {
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-10">
            <p class="text-xs text-gray-600 font-mono mb-4">// kurulum</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                @if (hardware.Any())
                {
                    <div>
                        <p class="text-xs text-gray-600 mb-3">Donanım</p>
                        <div class="space-y-1">
                            @foreach (var hw in hardware)
                            {
                                <div class="flex items-center gap-2">
                                    <span class="text-teal-400 text-xs">▸</span>
                                    <span class="font-mono text-sm text-gray-300">@hw</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (software.Any())
                {
                    <div>
                        <p class="text-xs text-gray-600 mb-3">Yazılım</p>
                        <div class="space-y-1">
                            @foreach (var sw in software)
                            {
                                <div class="flex items-center gap-2">
                                    <span class="text-teal-400 text-xs">▸</span>
                                    <span class="font-mono text-sm text-gray-300">@sw</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Ağ diyagramı -->
    @if (!string.IsNullOrEmpty(Model.NetworkDiagramUrl))
    {
        <div class="mb-10">
            <p class="text-xs text-gray-600 font-mono mb-3">// ağ topolojisi</p>
            <img src="@Model.NetworkDiagramUrl" alt="Ağ Topolojisi"
                 class="w-full rounded-xl border border-gray-800" />
        </div>
    }
    <!-- İnteraktif Ağ Haritası -->
    @if (!string.IsNullOrEmpty(topologyJson))
    {
        <div class="mb-10">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-gray-600 font-mono">// interaktif ağ haritası</p>
                <p class="text-xs text-gray-700">Cihaza tıkla, detayları gör</p>
            </div>
            <div id="network-map" class="w-full h-[500px] bg-gray-950 border border-gray-800 rounded-xl"></div>
        </div>

        <!-- Cihaz Detay Paneli -->
        <div id="deviceDetailPanel" class="hidden fixed inset-0 z-50">
            <div id="deviceDetailOverlay" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
            <div class="absolute right-0 top-0 h-full w-full max-w-md bg-gray-900 border-l border-gray-800 overflow-y-auto">
                <div class="p-6">
                    <div class="flex items-center justify-between mb-6">
                        <p class="font-mono text-xs text-gray-600">// cihaz detayı</p>
                        <button onclick="closeDeviceDetail()" class="text-gray-500 hover:text-white transition">✕</button>
                    </div>
                    <div id="deviceDetailContent"></div>
                </div>
            </div>
        </div>

        <script src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
        <script>
            const topologyData = @Html.Raw(topologyJson);
            const linkedProjects = @Html.Raw(ViewBag.LinkedProjectsJson ?? "[]");

            const htmlEscapeMap = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
            function escapeHtml(value) {
                return String(value ?? '').replace(/[&<>"']/g, character => htmlEscapeMap[character]);
            }

            function safeWebUrl(value) {
                if (!value) return '';

                try {
                    const url = new URL(String(value), window.location.origin);
                    return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : '';
                } catch {
                    return '';
                }
            }

            // Cihaz tipine göre renk paleti
            const typeColors = {
                router: '#3B82F6', switch: '#8B5CF6', firewall: '#EF4444',
                server: '#10B981', pc: '#6B7280', laptop: '#6B7280',
                microcontroller: '#F59E0B', mobile: '#6B7280', custom: '#EC4899',
                sensor: '#F59E0B', audio: '#14B8A6', antenna: '#06B6D4'
            };

            const connectionStyles = {
                ethernet: { dashes: false, color: '#6B7280' },
                wifi: { dashes: [5, 5], color: '#3B82F6' },
                usb: { dashes: [2, 4], color: '#8B5CF6' },
                power: { dashes: false, color: '#EF4444', width: 3 },
                other: { dashes: false, color: '#F59E0B' }
            };

            // Eski kayıtlarda konum yoksa geriye dönük uyumlu grid yerleşimi kullan.
            const gridPositions = (topologyData.nodes || []).map((n, i) => ({
                ...n,
                x: Number.isFinite(n.x) ? n.x : (i % 4) * 150,
                y: Number.isFinite(n.y) ? n.y : Math.floor(i / 4) * 150
            }));

            const nodes = new vis.DataSet(
                gridPositions.map(n => {
                    const imageUrl = safeWebUrl(n.iconUrl);
                    return {
                        id: n.id,
                        label: n.label,
                        shape: imageUrl ? 'image' : 'dot',
                        image: imageUrl || undefined,
                        color: imageUrl ? undefined : (typeColors[n.deviceType] || '#6B7280'),
                        size: 24,
                        font: { color: '#D1D5DB', size: 13, face: 'Inter' },
                        title: escapeHtml(n.shortInfo || n.label),
                        borderWidth: 2,
                        shapeProperties: { useImageSize: false },
                        x: n.x,
                        y: n.y
                    };
                })
            );

            const edges = new vis.DataSet(
                (topologyData.edges || []).map((e, i) => {
                    const style = connectionStyles[e.connectionType] || connectionStyles.other;
                    return {
                        id: i,
                        from: e.from,
                        to: e.to,
                        label: e.label || '',
                        dashes: style.dashes,
                        color: { color: style.color },
                        width: style.width || 2,
                        font: { color: '#6B7280', size: 10, strokeWidth: 0 },
                        smooth: false
                    };
                })
            );

            const container = document.getElementById('network-map');
            const data = { nodes, edges };
                        const options = {
                physics: {
                    enabled: false   // Fizik motorunu kapat — cihazlar sabit dursun, sen konumlandır
                },
                interaction: {
                    hover: true,
                    tooltipDelay: 100,
                    dragNodes: true,      // Cihazları sürükleyebil
                    dragView: true,       // Boş alanı sürükleyip haritayı kaydırabil
                    zoomView: true         // Zoom yapabil
                },
                layout: {
                    improvedLayout: true
                },
                edges: {
                    smooth: false          // Düz çizgiler — makarna görünümü kalksın
                }
            };

            const network = new vis.Network(container, data, options);

            network.on('click', function(params) {
                if (params.nodes.length > 0) {
                    const nodeId = params.nodes[0];
                    const device = (topologyData.nodes || []).find(n => n.id === nodeId);
                    if (device) showDeviceDetail(device);
                }
            });

            function showDeviceDetail(device) {
                let imageUrl = device.standaloneImageUrl;
                let hardware = device.standaloneHardware;
                let projectLink = null;

                if (device.linkedProjectSlug) {
                    const linked = linkedProjects.find(p => p.slug === device.linkedProjectSlug);
                    if (linked) {
                        imageUrl = linked.coverImageUrl;
                        projectLink = `/electronics/${encodeURIComponent(linked.slug)}`;

                        try {
                            const extra = JSON.parse(linked.extraData || '{}');
                            if (extra.components && extra.components.length) {
                                hardware = extra.components.join(', ');
                            } else if (extra.microcontroller) {
                                hardware = extra.microcontroller;
                            }
                        } catch (e) {}
                    }
                }

                const content = document.getElementById('deviceDetailContent');
                const safeImageUrl = safeWebUrl(imageUrl);
                content.innerHTML = `
                    ${safeImageUrl ? `<img src="${escapeHtml(safeImageUrl)}" class="w-full rounded-xl mb-4 border border-gray-800" />` : ''}

                    <h2 class="text-xl font-bold text-white mb-1">${escapeHtml(device.label)}</h2>
                    <span class="inline-block text-xs px-2 py-0.5 rounded font-mono mb-4"
                          style="background: ${typeColors[device.deviceType] || '#6B7280'}22; color: ${typeColors[device.deviceType] || '#6B7280'}">
                        ${escapeHtml(device.deviceType)}
                    </span>

                    ${device.shortInfo ? `<p class="text-gray-400 text-sm mb-4">${escapeHtml(device.shortInfo)}</p>` : ''}

                    <div class="space-y-3 border-t border-gray-800 pt-4">
                        ${device.ipAddress ? `
                            <div>
                                <p class="text-xs text-gray-600 mb-1">IP Adresi</p>
                                <p class="font-mono text-sm text-gray-300">${escapeHtml(device.ipAddress)}</p>
                            </div>
                        ` : ''}

                        ${hardware ? `
                            <div>
                                <p class="text-xs text-gray-600 mb-1">Donanım</p>
                                <p class="text-sm text-gray-300">${escapeHtml(hardware)}</p>
                            </div>
                        ` : ''}

                        ${device.homelabRole ? `
                            <div>
                                <p class="text-xs text-gray-600 mb-1">Bu Ağdaki Rolü</p>
                                <p class="text-sm text-gray-300">${escapeHtml(device.homelabRole)}</p>
                            </div>
                        ` : ''}

                        ${device.homelabNotes ? `
                            <div>
                                <p class="text-xs text-gray-600 mb-1">Notlar</p>
                                <p class="text-sm text-gray-400">${escapeHtml(device.homelabNotes)}</p>
                            </div>
                        ` : ''}
                    </div>

                    ${projectLink ? `
                        <a href="${escapeHtml(projectLink)}" class="mt-6 inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm px-4 py-2.5 rounded-lg transition">
                            Yapım detaylarını gör →
                        </a>
                    ` : ''}
                `;

                document.getElementById('deviceDetailPanel').classList.remove('hidden');
            }

            function closeDeviceDetail() {
                document.getElementById('deviceDetailPanel').classList.add('hidden');
            }

            document.getElementById('deviceDetailOverlay').addEventListener('click', closeDeviceDetail);
        </script>
    }

    <div class="prose prose-invert prose-lg max-w-none
                prose-headings:text-white prose-headings:font-bold
                prose-p:text-gray-400 prose-p:leading-relaxed
                prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline
                prose-code:text-green-400 prose-code:bg-gray-800 prose-code:px-1 prose-code:rounded prose-code:text-sm
                prose-pre:bg-gray-900 prose-pre:border prose-pre:border-gray-800
                prose-strong:text-white prose-li:text-gray-400">
        @Html.Raw(ViewBag.ContentHtml)
    </div>

    @if (images.Any())
    {
        <div class="mt-12">
            <h3 class="text-sm font-mono text-gray-600 mb-4">// görseller</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                @foreach (var img in images)
                {
                    <div>
                        <img src="@img.Url" alt="@img.AltText"
                             class="w-full rounded-lg border border-gray-800 hover:border-gray-600 transition" />
                        @if (!string.IsNullOrEmpty(img.Caption))
                        {
                            <p class="text-xs text-gray-600 mt-1 text-center">@img.Caption</p>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (related.Any())
    {
        <div class="mt-16 pt-8 border-t border-gray-800">
            <h3 class="text-sm font-mono text-gray-600 mb-6">// ilgili yazılar</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                @foreach (var r in related)
                {
                    <a href="/homelab/@r.Slug"
                       class="bg-gray-900 border border-gray-800 hover:border-teal-900/50 rounded-xl p-4 transition group">
                        <span class="font-mono text-xs text-teal-400">@r.Topic</span>
                        <h4 class="text-white text-sm font-medium group-hover:text-teal-300 transition mt-1 mb-1">@r.Title</h4>
                        <p class="text-gray-600 text-xs line-clamp-2">@r.Summary</p>
                    </a>
                }
            </div>
        </div>
    }

    <div class="mt-12 pt-8 border-t border-gray-800">
        <a href="/homelab" class="text-sm text-gray-500 hover:text-white transition font-mono">
            ← /homelab
        </a>
    </div>
</div>
