@model Portfolio.Models.HomelabPost
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;
    var hardware = ViewBag.Hardware as List<string> ?? new();
    var software = ViewBag.Software as List<string> ?? new();
    var images = ViewBag.Images as List<Portfolio.Models.Media> ?? new();
    var related = ViewBag.Related as List<Portfolio.Models.HomelabPost> ?? new();
    var networkDiagramUrl = Model.NetworkDiagramUrl?.Trim();
    var hasSafeNetworkDiagramUrl = !string.IsNullOrEmpty(networkDiagramUrl)
        && ((networkDiagramUrl.StartsWith('/') && !networkDiagramUrl.StartsWith("//") && Uri.TryCreate(networkDiagramUrl, UriKind.Relative, out _))
            || (Uri.TryCreate(networkDiagramUrl, UriKind.Absolute, out var diagramUri) && diagramUri.Scheme == Uri.UriSchemeHttps));
    var topologyJson = ViewBag.NetworkTopologyJson as string;
    Func<Portfolio.Models.Enums.HomelabTopic, string> topicLabel = topic => topic switch
    {
        Portfolio.Models.Enums.HomelabTopic.NetworkSetup => "Network Setup",
        Portfolio.Models.Enums.HomelabTopic.ServerManagement => "Server Management",
        Portfolio.Models.Enums.HomelabTopic.VPN => "VPN",
        _ => topic.ToString()
    };
}

<article class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <nav aria-label="Breadcrumb" class="flex min-w-0 items-center gap-2 overflow-hidden font-mono text-[9px] uppercase tracking-[0.15em] text-slate-700"><a href="/" class="focus-ring rounded-sm transition hover:text-white">Home</a><span>/</span><a href="/homelab" class="focus-ring rounded-sm transition hover:text-teal-300">Homelab</a><span>/</span><span class="truncate text-slate-500">@Model.Slug</span></nav>

    <header class="mt-10 grid gap-8 border-b border-white/[0.07] pb-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
            <div class="flex flex-wrap items-center gap-2"><span class="rounded-full border border-teal-300/20 bg-teal-300/[0.06] px-2.5 py-1 font-mono text-[9px] uppercase tracking-[0.14em] text-teal-200">@topicLabel(Model.Topic)</span>@if (Model.IsMainLab){<span class="inline-flex items-center gap-1.5 font-mono text-[9px] uppercase tracking-[0.14em] text-signal"><span class="h-1.5 w-1.5 rounded-full bg-signal"></span>Primary topology</span>}</div>
            <h1 class="mt-6 max-w-5xl text-4xl font-semibold leading-[1.04] tracking-[-0.045em] text-white sm:text-6xl">@Model.Title</h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-400">@Model.Summary</p>
            <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600"><span>@(Model.PublishedAt?.ToString("dd MMMM yyyy") ?? "Undated")</span><span>@Model.ReadingTimeMinutes min read</span><span>@Model.ViewCount unique @(Model.ViewCount == 1 ? "view" : "views")</span></div>
        </div>
        <div class="rounded-xl border border-teal-300/15 bg-teal-300/[0.04] px-5 py-4 text-right"><p class="font-mono text-[9px] uppercase tracking-[0.16em] text-slate-600">Infrastructure status</p><p class="mt-2 inline-flex items-center gap-2 text-sm font-medium text-teal-200"><span class="h-2 w-2 rounded-full bg-teal-300 shadow-[0_0_12px_rgba(94,234,212,.7)]"></span>Documented</p></div>
    </header>

    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <figure class="mt-10 overflow-hidden rounded-2xl border border-white/[0.08] bg-panel"><img src="@Model.CoverImageUrl" alt="@Model.Title" class="max-h-[38rem] w-full object-cover" /></figure>
    }

    @if (hardware.Any() || software.Any())
    {
        <section class="technical-frame surface mt-10 rounded-2xl p-5 sm:p-7">
            <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-teal-300">Deployment inventory</p>
            <div class="mt-6 grid gap-8 md:grid-cols-2">
                @if (hardware.Any())
                {
                    <div><p class="font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">Hardware / @hardware.Count.ToString("D2")</p><div class="mt-4 grid gap-2 sm:grid-cols-2">@foreach (var item in hardware){<div class="flex items-center gap-2 rounded-lg border border-white/[0.07] bg-white/[0.02] px-3 py-2.5"><span class="text-teal-300">›</span><span class="min-w-0 truncate font-mono text-[10px] text-slate-300">@item</span></div>}</div></div>
                }
                @if (software.Any())
                {
                    <div><p class="font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">Software / @software.Count.ToString("D2")</p><div class="mt-4 grid gap-2 sm:grid-cols-2">@foreach (var item in software){<div class="flex items-center gap-2 rounded-lg border border-white/[0.07] bg-white/[0.02] px-3 py-2.5"><span class="text-cyan">›</span><span class="min-w-0 truncate font-mono text-[10px] text-slate-300">@item</span></div>}</div></div>
                }
            </div>
        </section>
    }

    @if (hasSafeNetworkDiagramUrl)
    {
        <section class="mt-12"><div class="mb-4 flex items-end justify-between gap-4"><div><p class="font-mono text-[9px] uppercase tracking-[0.18em] text-teal-300">Static topology</p><h2 class="mt-2 text-2xl font-semibold text-white">Network diagram</h2></div><span class="font-mono text-[9px] uppercase tracking-[0.12em] text-slate-700">Reference image</span></div><img src="@networkDiagramUrl" alt="Network topology for @Model.Title" class="w-full rounded-2xl border border-white/[0.08] bg-panel" /></section>
    }

    @if (!string.IsNullOrEmpty(topologyJson))
    {
        <section class="mt-12">
            <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="font-mono text-[9px] uppercase tracking-[0.18em] text-teal-300">Interactive topology</p><h2 class="mt-2 text-2xl font-semibold text-white">Explore the network</h2></div><p id="network-map-instructions" class="font-mono text-[9px] uppercase tracking-[0.12em] text-slate-600">Select a device · Scroll to zoom</p></div>
            <div class="technical-frame surface overflow-hidden rounded-2xl p-2 sm:p-3"><div id="network-map" aria-label="Interactive network topology" class="h-[420px] w-full rounded-xl border border-slate-400/30 sm:h-[560px]" style="background-color: #e8eef2; background-image: linear-gradient(rgba(15, 23, 42, .08) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, .08) 1px, transparent 1px); background-size: 32px 32px;"></div></div>
        </section>

        <dialog id="deviceDetailPanel" class="fixed inset-y-0 left-auto right-0 m-0 h-dvh max-h-none w-full max-w-md overflow-y-auto border-0 border-l border-white/[0.08] bg-panel p-0 text-left text-slate-100 shadow-2xl backdrop:bg-ink/85 backdrop:backdrop-blur-sm" aria-labelledby="deviceDetailTitle">
            <aside class="min-h-full">
                <div class="p-5 sm:p-7">
                    <div class="mb-7 flex items-center justify-between border-b border-white/[0.07] pb-4"><p class="font-mono text-[9px] uppercase tracking-[0.18em] text-teal-300">Device record</p><button id="deviceDetailClose" type="button" onclick="closeDeviceDetail()" aria-label="Close device details" class="focus-ring rounded-md border border-white/10 px-3 py-2 font-mono text-[10px] text-slate-400 transition hover:text-white">ESC</button></div>
                    <div id="deviceDetailContent"></div>
                </div>
            </aside>
        </dialog>

        <script src="~/vendor/vis-network/vis-network.min.js" asp-append-version="true"></script>
        <script>
            const topologyData = @Html.Raw(topologyJson);
            const linkedProjects = @Html.Raw(ViewBag.LinkedProjectsJson ?? "[]");
            const isLayoutLocked = topologyData.isLayoutLocked === true;

            const htmlEscapeMap = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
            function escapeHtml(value) {
                return String(value ?? '').replace(/[&<>"']/g, character => htmlEscapeMap[character]);
            }

            function safeWebUrl(value) {
                if (!value) return '';

                try {
                    const rawValue = String(value).trim();
                    const url = new URL(rawValue, window.location.origin);
                    const isRootRelative = rawValue.startsWith('/') && !rawValue.startsWith('//') && url.origin === window.location.origin;
                    return isRootRelative || url.protocol === 'https:' ? url.href : '';
                } catch {
                    return '';
                }
            }

            const typeColors = {
                router: '#55D6FF', switch: '#A78BFA', firewall: '#FB7185',
                server: '#B8F36B', pc: '#94A3B8', laptop: '#94A3B8',
                microcontroller: '#FBBF24', mobile: '#94A3B8', custom: '#F472B6',
                sensor: '#FBBF24', audio: '#5EEAD4', antenna: '#22D3EE'
            };

            const connectionStyles = {
                ethernet: { dashes: false, color: '#64748B' },
                wifi: { dashes: [5, 5], color: '#55D6FF' },
                usb: { dashes: [2, 4], color: '#A78BFA' },
                power: { dashes: false, color: '#FB7185', width: 3 },
                other: { dashes: false, color: '#FBBF24' }
            };

            // Older topology records receive stable grid coordinates.
            const gridPositions = (topologyData.nodes || []).map((node, index) => ({
                ...node,
                x: Number.isFinite(node.x) ? node.x : (index % 4) * 150,
                y: Number.isFinite(node.y) ? node.y : Math.floor(index / 4) * 150
            }));

            const nodes = new vis.DataSet(gridPositions.map(node => {
                const imageUrl = safeWebUrl(node.iconUrl);
                return {
                    id: node.id,
                    label: node.label,
                    shape: imageUrl ? 'image' : 'dot',
                    image: imageUrl || undefined,
                    color: imageUrl ? undefined : (typeColors[node.deviceType] || '#94A3B8'),
                    size: 24,
                    font: { color: '#0F172A', size: 13, face: 'Space Grotesk Variable', strokeWidth: 3, strokeColor: '#E8EEF2' },
                    title: escapeHtml(node.shortInfo || node.label),
                    borderWidth: 2,
                    shapeProperties: { useImageSize: false, interpolation: false },
                    x: node.x,
                    y: node.y
                };
            }));

            const edges = new vis.DataSet((topologyData.edges || []).map((edge, index) => {
                const style = connectionStyles[edge.connectionType] || connectionStyles.other;
                return {
                    id: index,
                    from: edge.from,
                    to: edge.to,
                    label: edge.label || '',
                    dashes: style.dashes,
                    color: { color: style.color },
                    width: style.width || 2,
                    font: { color: '#334155', size: 10, strokeWidth: 3, strokeColor: '#E8EEF2' },
                    smooth: false
                };
            }));

            const container = document.getElementById('network-map');
            document.getElementById('network-map-instructions').textContent = isLayoutLocked
                ? 'Select a device · Layout locked · Scroll to zoom'
                : 'Select a device · Drag to reposition · Scroll to zoom';
            const network = new vis.Network(container, { nodes, edges }, {
                physics: { enabled: false },
                interaction: { hover: true, tooltipDelay: 100, dragNodes: !isLayoutLocked, dragView: true, zoomView: true },
                layout: { improvedLayout: true },
                edges: { smooth: false }
            });

            network.on('click', function (params) {
                if (params.nodes.length > 0) {
                    const device = (topologyData.nodes || []).find(node => node.id === params.nodes[0]);
                    if (device) showDeviceDetail(device);
                }
            });

            let deviceDetailPreviousFocus = null;

            function showDeviceDetail(device) {
                let imageUrl = device.standaloneImageUrl;
                let hardwareDescription = device.standaloneHardware;
                let projectLink = null;

                if (device.linkedProjectSlug) {
                    const linked = linkedProjects.find(project => project.slug === device.linkedProjectSlug);
                    if (linked) {
                        imageUrl = linked.coverImageUrl;
                        projectLink = `/electronics/${encodeURIComponent(linked.slug)}`;

                        hardwareDescription = linked.hardwareDescription || hardwareDescription;
                    }
                }

                const safeImageUrl = safeWebUrl(imageUrl);
                document.getElementById('deviceDetailContent').innerHTML = `
                    ${safeImageUrl ? `<img src="${escapeHtml(safeImageUrl)}" alt="" class="mb-5 w-full rounded-xl border border-white/10" />` : ''}
                    <h2 id="deviceDetailTitle" class="text-2xl font-semibold tracking-[-0.02em] text-white">${escapeHtml(device.label)}</h2>
                    <span class="mt-3 inline-block rounded-full px-2.5 py-1 font-mono text-[9px] uppercase tracking-[0.14em]"
                          style="background: ${typeColors[device.deviceType] || '#94A3B8'}18; color: ${typeColors[device.deviceType] || '#94A3B8'}">
                        ${escapeHtml(device.deviceType)}
                    </span>
                    ${device.shortInfo ? `<p class="mt-5 text-sm leading-6 text-slate-400">${escapeHtml(device.shortInfo)}</p>` : ''}
                    <div class="mt-6 space-y-5 border-t border-white/[0.07] pt-6">
                        ${device.ipAddress ? `<div><p class="font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">Network segment</p><p class="mt-2 font-mono text-sm text-white">${escapeHtml(device.ipAddress)}</p></div>` : ''}
                        ${hardwareDescription ? `<div><p class="font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">Hardware</p><p class="mt-2 text-sm leading-6 text-slate-300">${escapeHtml(hardwareDescription)}</p></div>` : ''}
                        ${device.homelabRole ? `<div><p class="font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">Network role</p><p class="mt-2 text-sm leading-6 text-slate-300">${escapeHtml(device.homelabRole)}</p></div>` : ''}
                        ${device.homelabNotes ? `<div><p class="font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">Notes</p><p class="mt-2 text-sm leading-6 text-slate-400">${escapeHtml(device.homelabNotes)}</p></div>` : ''}
                    </div>
                    ${projectLink ? `<a href="${escapeHtml(projectLink)}" class="mt-7 inline-flex items-center gap-2 rounded-md bg-signal px-4 py-3 text-sm font-semibold text-ink transition hover:bg-white">View build details <span aria-hidden="true">→</span></a>` : ''}
                `;

                const panel = document.getElementById('deviceDetailPanel');
                deviceDetailPreviousFocus = document.activeElement;
                if (!panel.open) panel.showModal();
                document.body.classList.add('overflow-hidden');
                window.requestAnimationFrame(() => document.getElementById('deviceDetailClose').focus());
            }

            function closeDeviceDetail() {
                const panel = document.getElementById('deviceDetailPanel');
                if (panel.open) panel.close();
            }

            const deviceDetailPanel = document.getElementById('deviceDetailPanel');
            deviceDetailPanel.addEventListener('click', function (event) {
                if (event.target === deviceDetailPanel) closeDeviceDetail();
            });
            deviceDetailPanel.addEventListener('close', function () {
                document.body.classList.remove('overflow-hidden');
                if (deviceDetailPreviousFocus instanceof HTMLElement) deviceDetailPreviousFocus.focus();
                deviceDetailPreviousFocus = null;
            });
        </script>
    }

    <div class="mx-auto mt-12 max-w-3xl prose prose-lg prose-invert prose-headings:font-semibold prose-headings:tracking-[-0.025em] prose-headings:text-white prose-p:leading-8 prose-p:text-slate-400 prose-a:text-teal-300 prose-a:no-underline hover:prose-a:text-white prose-code:rounded prose-code:bg-raised prose-code:px-1.5 prose-code:py-0.5 prose-code:text-signal prose-pre:border prose-pre:border-white/[0.08] prose-pre:bg-panel prose-blockquote:border-teal-300 prose-blockquote:text-slate-400 prose-strong:text-white prose-li:text-slate-400">@Html.Raw(ViewBag.ContentHtml)</div>

    @if (images.Any())
    {
        <section class="mt-16 border-t border-white/[0.07] pt-10"><p class="mb-5 font-mono text-[9px] uppercase tracking-[0.18em] text-teal-300">Infrastructure gallery / @images.Count.ToString("D2")</p><div class="grid grid-cols-2 gap-3 md:grid-cols-3">@foreach (var image in images){<figure><img src="@image.Url" alt="@image.AltText" loading="lazy" class="aspect-[4/3] w-full rounded-xl border border-white/[0.08] object-cover transition hover:border-teal-300/30" />@if (!string.IsNullOrEmpty(image.Caption)){<figcaption class="mt-2 text-center text-xs text-slate-600">@image.Caption</figcaption>}</figure>}</div></section>
    }

    @if (related.Any())
    {
        <section class="mt-20 border-t border-white/[0.07] pt-10"><div class="mb-6 flex items-end justify-between gap-4"><div><p class="font-mono text-[9px] uppercase tracking-[0.18em] text-teal-300">Continue exploring</p><h2 class="mt-2 text-2xl font-semibold text-white">Related infrastructure</h2></div><a href="/homelab" class="focus-ring rounded-sm text-sm text-slate-500 hover:text-white">All notes →</a></div><div class="grid gap-3 md:grid-cols-3">@foreach (var item in related){<a href="/homelab/@item.Slug" class="focus-ring card-lift surface group rounded-xl p-5 hover:border-teal-300/30"><p class="font-mono text-[9px] uppercase tracking-[0.14em] text-teal-300">@topicLabel(item.Topic)</p><h3 class="mt-3 text-sm font-medium text-white transition group-hover:text-teal-200">@item.Title</h3><p class="mt-2 line-clamp-2 text-xs leading-5 text-slate-600">@item.Summary</p></a>}</div></section>
    }

    <footer class="mt-14 border-t border-white/[0.07] pt-8"><a href="/homelab" class="focus-ring inline-flex items-center gap-2 rounded-sm font-mono text-[10px] uppercase tracking-[0.14em] text-slate-500 transition hover:text-teal-300"><span aria-hidden="true">←</span> Back to infrastructure</a></footer>
</article>
