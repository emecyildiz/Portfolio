@model Portfolio.Models.Project
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;
    var extra = ViewBag.Extra as Portfolio.Models.ExtraData.WebAppExtraData
                ?? new Portfolio.Models.ExtraData.WebAppExtraData();
    var images = ViewBag.Images as List<Portfolio.Models.Media> ?? new();
    var related = ViewBag.Related as List<Portfolio.Models.Project> ?? new();
}

<div class="max-w-4xl mx-auto px-6 py-16">

    <div class="flex items-center gap-2 text-sm text-gray-600 mb-8 font-mono">
        <a href="/" class="hover:text-white transition">~</a>
        <span>/</span>
        <a href="/webapps" class="hover:text-white transition">webapps</a>
        <span>/</span>
        <span class="text-gray-400">@Model.Slug</span>
    </div>

    <div class="mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">@Model.Title</h1>
        <p class="text-gray-400 text-lg">@Model.Summary</p>

        <div class="flex flex-wrap items-center gap-4 mt-6 text-sm text-gray-600">
            <span>@(Model.PublishedAt?.ToString("dd MMMM yyyy") ?? "")</span>
            <span>@Model.ReadingTimeMinutes dk okuma</span>
            @if (!string.IsNullOrEmpty(Model.GithubUrl))
            {
                <a href="@Model.GithubUrl" target="_blank"
                   class="text-blue-400 hover:text-blue-300 transition">GitHub →</a>
            }
            @if (!string.IsNullOrEmpty(Model.LiveDemoUrl))
            {
                <a href="@Model.LiveDemoUrl" target="_blank"
                   class="text-green-400 hover:text-green-300 transition">Canlı Demo →</a>
            }
            @if (!string.IsNullOrEmpty(extra.Subdomain))
            {
                <a href="https://@extra.Subdomain" target="_blank"
                   class="text-purple-400 hover:text-purple-300 transition">@extra.Subdomain →</a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <img src="@Model.CoverImageUrl" alt="@Model.Title"
             class="w-full rounded-xl mb-10 border border-gray-800" />
    }

    <!-- Proje bilgileri -->
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-10">
        <p class="text-xs text-gray-600 font-mono mb-4">// proje detayları</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            @if (!string.IsNullOrEmpty(extra.MyRole))
            {
                <div>
                    <p class="text-xs text-gray-600 mb-1">Rolüm</p>
                    <p class="text-gray-300 text-sm">@extra.MyRole</p>
                </div>
            }
            @if (extra.TeamSize.HasValue)
            {
                <div>
                    <p class="text-xs text-gray-600 mb-1">Ekip</p>
                    <p class="text-gray-300 text-sm">@extra.TeamSize kişi</p>
                </div>
            }
            @if (extra.IsSchoolProject == true)
            {
                <div>
                    <p class="text-xs text-gray-600 mb-1">Tür</p>
                    <p class="text-gray-300 text-sm">Okul Projesi</p>
                </div>
            }
        </div>

        @if (extra.TechStack?.Any() ?? false)
        {
            <div class="mt-4 pt-4 border-t border-gray-800">
                <p class="text-xs text-gray-600 mb-2">Tech Stack</p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var tech in extra.TechStack!)
                    {
                        <span class="font-mono text-xs bg-gray-800 text-purple-300 px-2 py-1 rounded">@tech</span>
                    }
                </div>
            </div>
        }
    </div>

    <div class="prose prose-invert prose-lg max-w-none
                prose-headings:text-white prose-headings:font-bold
                prose-p:text-gray-400 prose-p:leading-relaxed
                prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline
                prose-code:text-green-400 prose-code:bg-gray-800 prose-code:px-1 prose-code:rounded prose-code:text-sm
                prose-pre:bg-gray-900 prose-pre:border prose-pre:border-gray-800
                prose-strong:text-white prose-li:text-gray-400">
        @Html.Raw(ViewBag.ContentHtml)
    </div>

    @if (images.Any())
    {
        <div class="mt-12">
            <h3 class="text-sm font-mono text-gray-600 mb-4">// görseller</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                @foreach (var img in images)
                {
                    <img src="@img.Url" alt="@img.AltText"
                         class="w-full rounded-lg border border-gray-800 hover:border-gray-600 transition" />
                }
            </div>
        </div>
    }

    @if (related.Any())
    {
        <div class="mt-16 pt-8 border-t border-gray-800">
            <h3 class="text-sm font-mono text-gray-600 mb-6">// diğer uygulamalar</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                @foreach (var r in related)
                {
                    <a href="/webapps/@r.Slug"
                       class="bg-gray-900 border border-gray-800 hover:border-purple-900/50 rounded-xl p-4 transition group">
                        <h4 class="text-white text-sm font-medium group-hover:text-purple-300 transition mb-1">@r.Title</h4>
                        <p class="text-gray-600 text-xs line-clamp-2">@r.Summary</p>
                    </a>
                }
            </div>
        </div>
    }

    <div class="mt-12 pt-8 border-t border-gray-800">
        <a href="/webapps" class="text-sm text-gray-500 hover:text-white transition font-mono">
            ← /webapps
        </a>
    </div>
</div>