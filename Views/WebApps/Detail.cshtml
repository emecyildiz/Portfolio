@model Portfolio.Models.Project
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;
    var extra = ViewBag.Extra as Portfolio.Models.ExtraData.WebAppExtraData ?? new Portfolio.Models.ExtraData.WebAppExtraData();
    var images = ViewBag.Images as List<Portfolio.Models.Media> ?? new();
    var related = ViewBag.Related as List<Portfolio.Models.Project> ?? new();
    var githubUrl = Model.GithubUrl?.Trim();
    var liveDemoUrl = Model.LiveDemoUrl?.Trim();
    var subdomain = extra.Subdomain?.Trim();
    var hasSafeGithubUrl = Uri.TryCreate(githubUrl, UriKind.Absolute, out var githubUri) && githubUri.Scheme == Uri.UriSchemeHttps;
    var hasSafeLiveDemoUrl = Uri.TryCreate(liveDemoUrl, UriKind.Absolute, out var liveDemoUri) && liveDemoUri.Scheme == Uri.UriSchemeHttps;
    var hasSafeSubdomain = !string.IsNullOrEmpty(subdomain) && Uri.CheckHostName(subdomain) == UriHostNameType.Dns;
}

<article class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <nav aria-label="Breadcrumb" class="flex min-w-0 items-center gap-2 overflow-hidden font-mono text-[9px] uppercase tracking-[0.15em] text-slate-700"><a href="/" class="focus-ring rounded-sm transition hover:text-white">Home</a><span>/</span><a href="/webapps" class="focus-ring rounded-sm transition hover:text-cyan">Web Apps</a><span>/</span><span class="truncate text-slate-500">@Model.Slug</span></nav>

    <header class="mt-10 grid gap-8 border-b border-white/[0.07] pb-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div><p class="font-mono text-[10px] uppercase tracking-[0.22em] text-cyan">Software system record</p><h1 class="mt-5 max-w-5xl text-4xl font-semibold leading-[1.04] tracking-[-0.045em] text-white sm:text-6xl">@Model.Title</h1><p class="mt-6 max-w-3xl text-lg leading-8 text-slate-400">@Model.Summary</p><div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600"><span>@(Model.PublishedAt?.ToString("dd MMMM yyyy") ?? "Undated")</span><span>@Model.ReadingTimeMinutes min read</span><span>@Model.ViewCount @(Model.ViewCount == 1 ? "view" : "views")</span></div></div>
        <div class="flex flex-wrap gap-2 lg:max-w-64 lg:justify-end">@if (hasSafeGithubUrl){<a href="@githubUrl" target="_blank" rel="noopener noreferrer" class="focus-ring rounded-md border border-white/10 px-4 py-2.5 text-xs text-slate-300 transition hover:border-cyan/30 hover:text-white">GitHub ↗</a>}@if (hasSafeLiveDemoUrl){<a href="@liveDemoUrl" target="_blank" rel="noopener noreferrer" class="focus-ring rounded-md bg-signal px-4 py-2.5 text-xs font-semibold text-ink transition hover:bg-white">Live demo ↗</a>}@if (hasSafeSubdomain){<a href="https://@subdomain" target="_blank" rel="noopener noreferrer" class="focus-ring rounded-md border border-cyan/20 bg-cyan/[0.05] px-4 py-2.5 text-xs text-cyan transition hover:border-cyan/40">@subdomain ↗</a>}</div>
    </header>

    @if (!string.IsNullOrEmpty(Model.CoverImageUrl)){<figure class="mt-10 overflow-hidden rounded-2xl border border-white/[0.08] bg-panel"><img src="@Model.CoverImageUrl" alt="@Model.Title" class="max-h-[38rem] w-full object-cover" /></figure>}

    <section class="technical-frame surface mt-10 rounded-2xl p-5 sm:p-7">
        <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-cyan">Project specification</p>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            @if (!string.IsNullOrEmpty(extra.MyRole)){<div><p class="font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">My role</p><p class="mt-2 text-sm text-white">@extra.MyRole</p></div>}
            @if (extra.TeamSize.HasValue){<div><p class="font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">Team</p><p class="mt-2 text-sm text-white">@extra.TeamSize @(extra.TeamSize == 1 ? "member" : "members")</p></div>}
            @if (extra.IsSchoolProject == true){<div><p class="font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">Type</p><p class="mt-2 text-sm text-white">Academic project</p></div>}
        </div>
        @if (extra.TechStack?.Any() ?? false){<div class="mt-6 border-t border-white/[0.07] pt-6"><p class="font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">Technology stack</p><div class="mt-3 flex flex-wrap gap-2">@foreach (var tech in extra.TechStack!){<span class="rounded-md border border-cyan/15 bg-cyan/[0.04] px-2.5 py-1 font-mono text-[9px] text-cyan">@tech</span>}</div></div>}
    </section>

    <div class="mx-auto mt-12 max-w-3xl prose prose-lg prose-invert prose-headings:font-semibold prose-headings:tracking-[-0.025em] prose-headings:text-white prose-p:leading-8 prose-p:text-slate-400 prose-a:text-cyan prose-a:no-underline hover:prose-a:text-white prose-code:rounded prose-code:bg-raised prose-code:px-1.5 prose-code:py-0.5 prose-code:text-signal prose-pre:border prose-pre:border-white/[0.08] prose-pre:bg-panel prose-blockquote:border-cyan prose-blockquote:text-slate-400 prose-strong:text-white prose-li:text-slate-400">@Html.Raw(ViewBag.ContentHtml)</div>

    @if (images.Any()){<section class="mt-16 border-t border-white/[0.07] pt-10"><p class="mb-5 font-mono text-[9px] uppercase tracking-[0.18em] text-cyan">Interface gallery / @images.Count.ToString("D2")</p><div class="grid grid-cols-2 gap-3 md:grid-cols-3">@foreach (var image in images){<img src="@image.Url" alt="@image.AltText" loading="lazy" class="aspect-[4/3] w-full rounded-xl border border-white/[0.08] object-cover transition hover:border-cyan/30" />}</div></section>}

    @if (related.Any()){<section class="mt-20 border-t border-white/[0.07] pt-10"><div class="mb-6 flex items-end justify-between gap-4"><div><p class="font-mono text-[9px] uppercase tracking-[0.18em] text-cyan">Continue exploring</p><h2 class="mt-2 text-2xl font-semibold text-white">Related applications</h2></div><a href="/webapps" class="focus-ring rounded-sm text-sm text-slate-500 hover:text-white">All software →</a></div><div class="grid gap-3 md:grid-cols-3">@foreach (var item in related){<a href="/webapps/@item.Slug" class="focus-ring card-lift surface group rounded-xl p-5 hover:border-cyan/30"><h3 class="text-sm font-medium text-white transition group-hover:text-cyan">@item.Title</h3><p class="mt-2 line-clamp-2 text-xs leading-5 text-slate-600">@item.Summary</p></a>}</div></section>}

    <footer class="mt-14 border-t border-white/[0.07] pt-8"><a href="/webapps" class="focus-ring inline-flex items-center gap-2 rounded-sm font-mono text-[10px] uppercase tracking-[0.14em] text-slate-500 transition hover:text-cyan"><span aria-hidden="true">←</span> Back to software</a></footer>
</article>
