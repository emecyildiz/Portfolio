@model List<Portfolio.Models.Project>
@{
    ViewData["Title"] = "Web Applications";
    ViewData["Description"] = "Independent, academic, and collaborative software projects.";
}

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
    <header class="grid gap-8 border-b border-white/[0.07] pb-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-cyan">Archive / Software / 03</p>
            <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-[-0.045em] text-white sm:text-6xl">Software designed as a working system.</h1>
            <p class="mt-5 max-w-2xl text-base leading-7 text-slate-400">Independent, academic, and collaborative applications—from architecture and backend services to the interface people use.</p>
        </div>
        <div class="flex items-center gap-4 lg:flex-col lg:items-end"><span class="font-mono text-4xl font-semibold text-cyan">@Model.Count.ToString("D2")</span><span class="font-mono text-[9px] uppercase tracking-[0.2em] text-slate-600">Released systems</span></div>
    </header>

    @if (!Model.Any())
    {
        <div class="technical-frame surface mt-8 grid min-h-72 place-items-center rounded-2xl px-6 text-center"><div><p class="font-mono text-[10px] uppercase tracking-[0.22em] text-cyan">No public releases</p><p class="mt-3 text-sm text-slate-500">Published software projects will appear here.</p></div></div>
    }
    else
    {
        <div class="mt-8 grid gap-5 lg:grid-cols-2">
            @foreach (var project in Model)
            {
                var extra = new Portfolio.Models.ExtraData.WebAppExtraData();
                if (!string.IsNullOrEmpty(project.ExtraData))
                    extra = System.Text.Json.JsonSerializer.Deserialize<Portfolio.Models.ExtraData.WebAppExtraData>(project.ExtraData) ?? extra;

                <a href="/webapps/@project.Slug" class="focus-ring card-lift surface group grid overflow-hidden rounded-2xl hover:border-cyan/30 sm:grid-cols-[11rem_1fr]">
                    <div class="relative min-h-48 overflow-hidden border-b border-white/[0.07] bg-raised sm:border-b-0 sm:border-r">
                        @if (!string.IsNullOrEmpty(project.CoverImageUrl))
                        {
                            <img src="@project.CoverImageUrl" alt="@project.Title" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-75 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-100" />
                        }
                        else
                        {
                            <div class="site-grid absolute inset-0 grid place-items-center"><span class="font-mono text-[9px] uppercase tracking-[0.18em] text-slate-700">APP</span></div>
                        }
                    </div>
                    <div class="flex min-w-0 flex-col p-5 sm:p-6">
                        <div class="flex flex-wrap items-center gap-2">
                            @if (!string.IsNullOrEmpty(project.LiveDemoUrl))
                            {
                                <span class="inline-flex items-center gap-1.5 font-mono text-[9px] uppercase tracking-[0.14em] text-signal"><span class="h-1.5 w-1.5 rounded-full bg-signal"></span>Live</span>
                            }
                            @if (extra.IsSchoolProject == true)
                            {
                                <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">Academic</span>
                            }
                        </div>
                        <h2 class="mt-4 text-xl font-semibold tracking-[-0.02em] text-white transition group-hover:text-cyan">@project.Title</h2>
                        <p class="mt-3 line-clamp-2 text-sm leading-6 text-slate-500">@project.Summary</p>
                        @if (extra.TechStack?.Any() ?? false)
                        {
                            <div class="mt-5 flex flex-wrap gap-1.5">
                                @foreach (var tech in extra.TechStack!.Take(4))
                                {
                                    <span class="rounded-md border border-cyan/15 bg-cyan/[0.04] px-2 py-1 font-mono text-[9px] text-cyan">@tech</span>
                                }
                            </div>
                        }
                        <div class="mt-auto flex items-center justify-between gap-4 border-t border-white/[0.07] pt-5 font-mono text-[9px] uppercase tracking-[0.12em] text-slate-600"><span>@(project.PublishedAt?.ToString("dd MMM yyyy") ?? "Undated")</span><span class="text-slate-700">Open system ↗</span></div>
                    </div>
                </a>
            }
        </div>
    }
</section>
