@model Portfolio.Models.BlogPost
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;
    var related = ViewBag.Related as List<Portfolio.Models.BlogPost> ?? new();
}

<article class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <nav aria-label="Breadcrumb" class="flex min-w-0 items-center gap-2 overflow-hidden font-mono text-[9px] uppercase tracking-[0.15em] text-slate-700">
        <a href="/" class="focus-ring rounded-sm transition hover:text-white">Home</a><span>/</span><a href="/blog" class="focus-ring rounded-sm transition hover:text-violet-300">Blog</a><span>/</span><span class="truncate text-slate-500">@Model.Slug</span>
    </nav>

    <header class="mt-10 border-b border-white/[0.07] pb-10">
        <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-violet-300">Field note / @(Model.PublishedAt?.ToString("yyyy.MM.dd") ?? "Undated")</p>
        <h1 class="mt-5 max-w-5xl text-4xl font-semibold leading-[1.04] tracking-[-0.045em] text-white sm:text-6xl">@Model.Title</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-400">@Model.Summary</p>
        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600"><span>@(Model.PublishedAt?.ToString("dd MMMM yyyy") ?? "Undated")</span><span>@Model.ReadingTimeMinutes min read</span><span>@Model.ViewCount unique @(Model.ViewCount == 1 ? "view" : "views")</span></div>
    </header>

    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <figure class="mt-10 overflow-hidden rounded-2xl border border-white/[0.08] bg-panel"><img src="@Model.CoverImageUrl" alt="@Model.Title" class="max-h-[36rem] w-full object-cover" /></figure>
    }

    <div class="mx-auto mt-12 max-w-3xl prose prose-lg prose-invert prose-headings:font-semibold prose-headings:tracking-[-0.025em] prose-headings:text-white prose-p:leading-8 prose-p:text-slate-400 prose-a:text-violet-300 prose-a:no-underline hover:prose-a:text-white prose-code:rounded prose-code:bg-raised prose-code:px-1.5 prose-code:py-0.5 prose-code:text-signal prose-pre:border prose-pre:border-white/[0.08] prose-pre:bg-panel prose-blockquote:border-violet-300 prose-blockquote:text-slate-400 prose-strong:text-white prose-li:text-slate-400">
        @Html.Raw(ViewBag.ContentHtml)
    </div>

    @if (related.Any())
    {
        <section class="mt-20 border-t border-white/[0.07] pt-10">
            <div class="mb-6 flex items-end justify-between gap-4"><div><p class="font-mono text-[9px] uppercase tracking-[0.18em] text-violet-300">Continue reading</p><h2 class="mt-2 text-2xl font-semibold text-white">Related notes</h2></div><a href="/blog" class="focus-ring rounded-sm text-sm text-slate-500 transition hover:text-white">All writing →</a></div>
            <div class="grid gap-3 md:grid-cols-3">
                @foreach (var post in related)
                {
                    <a href="/blog/@post.Slug" class="focus-ring card-lift surface group rounded-xl p-5 hover:border-violet-300/30"><p class="font-mono text-[9px] uppercase tracking-[0.12em] text-slate-600">@(post.PublishedAt?.ToString("dd MMM yyyy") ?? "Undated")</p><h3 class="mt-3 text-sm font-medium text-white transition group-hover:text-violet-200">@post.Title</h3></a>
                }
            </div>
        </section>
    }

    <footer class="mt-12 border-t border-white/[0.07] pt-8"><a href="/blog" class="focus-ring inline-flex items-center gap-2 rounded-sm font-mono text-[10px] uppercase tracking-[0.14em] text-slate-500 transition hover:text-violet-300"><span aria-hidden="true">←</span> Back to writing</a></footer>
</article>
