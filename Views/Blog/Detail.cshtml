@model Portfolio.Models.BlogPost
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;
    var related = ViewBag.Related as List<Portfolio.Models.BlogPost> ?? new();
}

<div class="max-w-3xl mx-auto px-6 py-16">

    <div class="flex items-center gap-2 text-sm text-gray-600 mb-8 font-mono">
        <a href="/" class="hover:text-white transition">~</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white transition">blog</a>
        <span>/</span>
        <span class="text-gray-400">@Model.Slug</span>
    </div>

    <div class="mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">@Model.Title</h1>
        <p class="text-gray-400 text-lg">@Model.Summary</p>

        <div class="flex items-center gap-4 mt-6 text-sm text-gray-600">
            <span>@(Model.PublishedAt?.ToString("dd MMMM yyyy") ?? "")</span>
            <span>@Model.ReadingTimeMinutes dk okuma</span>
            <span>@Model.ViewCount görüntülenme</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <img src="@Model.CoverImageUrl" alt="@Model.Title"
             class="w-full rounded-xl mb-10 border border-gray-800" />
    }

    <div class="prose prose-invert prose-lg max-w-none
                prose-headings:text-white prose-headings:font-bold
                prose-p:text-gray-400 prose-p:leading-relaxed
                prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline
                prose-code:text-green-400 prose-code:bg-gray-800 prose-code:px-1 prose-code:rounded prose-code:text-sm
                prose-pre:bg-gray-900 prose-pre:border prose-pre:border-gray-800
                prose-strong:text-white prose-li:text-gray-400">
        @Html.Raw(ViewBag.ContentHtml)
    </div>

    @if (related.Any())
    {
        <div class="mt-16 pt-8 border-t border-gray-800">
            <h3 class="text-sm font-mono text-gray-600 mb-6">// diğer yazılar</h3>
            <div class="space-y-4">
                @foreach (var r in related)
                {
                    <a href="/blog/@r.Slug"
                       class="flex items-center gap-4 group">
                        <div>
                            <p class="text-xs text-gray-600 font-mono mb-1">
                                @(r.PublishedAt?.ToString("dd MMM yyyy") ?? "")
                            </p>
                            <h4 class="text-white text-sm font-medium group-hover:text-purple-300 transition">
                                @r.Title
                            </h4>
                        </div>
                    </a>
                }
            </div>
        </div>
    }

    <div class="mt-12 pt-8 border-t border-gray-800">
        <a href="/blog" class="text-sm text-gray-500 hover:text-white transition font-mono">
            ← /blog
        </a>
    </div>
</div>