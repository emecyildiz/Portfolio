@model List<Portfolio.Models.BlogPost>
@{
    ViewData["Title"] = "Blog";
    ViewData["Description"] = "Technical notes, lessons learned, and field observations.";
}

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
    <header class="grid gap-8 border-b border-white/[0.07] pb-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-violet-300">Archive / Writing / 05</p>
            <h1 class="mt-5 max-w-3xl text-4xl font-semibold tracking-[-0.045em] text-white sm:text-6xl">Field notes from work in progress.</h1>
            <p class="mt-5 max-w-2xl text-base leading-7 text-slate-400">Technical articles, lessons learned, decisions reconsidered, and the useful details that emerge while building and researching.</p>
        </div>
        <a href="/blog/rss.xml" target="_blank" rel="noopener noreferrer" class="focus-ring inline-flex items-center justify-center gap-2 rounded-md border border-violet-300/20 bg-violet-300/[0.05] px-4 py-3 font-mono text-[10px] uppercase tracking-[0.16em] text-violet-200 transition hover:border-violet-300/40 hover:bg-violet-300/10">Follow via RSS <span aria-hidden="true">↗</span></a>
    </header>

    @if (!Model.Any())
    {
        <div class="technical-frame surface mt-8 grid min-h-72 place-items-center rounded-2xl px-6 text-center"><div><p class="font-mono text-[10px] uppercase tracking-[0.22em] text-violet-300">Notebook empty</p><p class="mt-3 text-sm text-slate-500">Published writing will appear here.</p></div></div>
    }
    else
    {
        <div class="mt-8 divide-y divide-white/[0.07] border-y border-white/[0.07]">
            @foreach (var post in Model)
            {
                <a href="/blog/@post.Slug" class="focus-ring group grid gap-5 py-7 transition sm:grid-cols-[7rem_1fr_auto] sm:items-center sm:gap-7 sm:px-3">
                    @if (!string.IsNullOrEmpty(post.CoverImageUrl))
                    {
                        <img src="@post.CoverImageUrl" alt="@post.Title" loading="lazy" class="h-32 w-full rounded-xl object-cover opacity-75 transition group-hover:opacity-100 sm:h-24" />
                    }
                    else
                    {
                        <div class="site-grid grid h-24 w-full place-items-center rounded-xl border border-white/[0.07] bg-panel"><span class="font-mono text-[9px] text-violet-300">TXT</span></div>
                    }
                    <div class="min-w-0">
                        <p class="font-mono text-[9px] uppercase tracking-[0.14em] text-violet-300">@(post.PublishedAt?.ToString("dd MMM yyyy") ?? "Undated") · @post.ReadingTimeMinutes min read</p>
                        <h2 class="mt-3 text-xl font-semibold tracking-[-0.02em] text-white transition group-hover:text-violet-200 sm:text-2xl">@post.Title</h2>
                        <p class="mt-3 line-clamp-2 text-sm leading-6 text-slate-500">@post.Summary</p>
                    </div>
                    <span aria-hidden="true" class="hidden text-slate-700 transition group-hover:translate-x-1 group-hover:text-violet-300 sm:block">→</span>
                </a>
            }
        </div>
    }
</section>
