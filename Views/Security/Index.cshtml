@model List<Portfolio.Models.SecurityResearch>
@{
    ViewData["Title"] = "Security Research";
    ViewData["Description"] = "Research into malware analysis, hardware vulnerabilities, RF security, and network attacks.";
    var currentType = ViewBag.CurrentType as string;
    Func<Portfolio.Models.Enums.ResearchType, string> researchTypeLabel = type => type switch
    {
        Portfolio.Models.Enums.ResearchType.MalwareAnalysis => "Malware Analysis",
        Portfolio.Models.Enums.ResearchType.HardwareVuln => "Hardware Vulnerability",
        Portfolio.Models.Enums.ResearchType.RFSecurity => "RF Security",
        Portfolio.Models.Enums.ResearchType.WebSecurity => "Web Security",
        Portfolio.Models.Enums.ResearchType.NetworkSecurity => "Network Security",
        Portfolio.Models.Enums.ResearchType.MobileSecurity => "Mobile Security",
        _ => "Other"
    };
}

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
    <header class="grid gap-8 border-b border-white/[0.07] pb-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-rose-300">Archive / Security / 01</p>
            <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-[-0.045em] text-white sm:text-6xl">Security research under controlled conditions.</h1>
            <p class="mt-5 max-w-2xl text-base leading-7 text-slate-400">Malware analysis, reverse engineering, hardware vulnerabilities, RF attacks, and network security documented from observation to outcome.</p>
        </div>
        <div class="flex items-center gap-4 lg:flex-col lg:items-end">
            <span class="font-mono text-4xl font-semibold text-rose-300">@Model.Count.ToString("D2")</span>
            <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-slate-600">Published records</span>
        </div>
    </header>

    <nav aria-label="Research type filters" class="surface my-8 flex flex-wrap items-center gap-2 rounded-xl p-2">
        <span class="hidden px-3 font-mono text-[9px] uppercase tracking-[0.18em] text-slate-600 sm:block">Filter</span>
        <a href="/security" class="focus-ring rounded-lg border px-3 py-2 font-mono text-[10px] uppercase tracking-[0.12em] transition @(string.IsNullOrEmpty(currentType) ? "border-rose-300/30 bg-rose-300/10 text-rose-200" : "border-transparent text-slate-500 hover:bg-white/[0.04] hover:text-white")">All</a>
        @foreach (var type in Enum.GetValues<Portfolio.Models.Enums.ResearchType>())
        {
            <a href="/security?type=@type" class="focus-ring rounded-lg border px-3 py-2 font-mono text-[10px] uppercase tracking-[0.12em] transition @(currentType == type.ToString() ? "border-rose-300/30 bg-rose-300/10 text-rose-200" : "border-transparent text-slate-500 hover:bg-white/[0.04] hover:text-white")">@researchTypeLabel(type)</a>
        }
    </nav>

    @if (!Model.Any())
    {
        <div class="technical-frame surface grid min-h-72 place-items-center rounded-2xl px-6 text-center">
            <div><p class="font-mono text-[10px] uppercase tracking-[0.22em] text-rose-300">No public records</p><p class="mt-3 text-sm text-slate-500">Published security research will appear here.</p></div>
        </div>
    }
    else
    {
        <div class="grid gap-4 lg:grid-cols-2">
            @foreach (var research in Model)
            {
                <a href="/security/@research.Slug" class="focus-ring card-lift technical-frame surface group flex min-h-72 flex-col rounded-2xl p-5 hover:border-rose-300/30 sm:p-6">
                    <div class="flex items-start gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                @if (!string.IsNullOrEmpty(research.SeverityLevel))
                                {
                                    var severityColor = research.SeverityLevel switch
                                    {
                                        "critical" => "border-red-400/30 bg-red-400/10 text-red-300",
                                        "high" => "border-orange-400/30 bg-orange-400/10 text-orange-300",
                                        "medium" => "border-amber-400/30 bg-amber-400/10 text-amber-300",
                                        "low" => "border-cyan/30 bg-cyan/10 text-cyan",
                                        _ => "border-white/10 bg-white/[0.04] text-slate-400"
                                    };
                                    <span class="rounded-full border px-2.5 py-1 font-mono text-[9px] uppercase tracking-[0.14em] @severityColor">@research.SeverityLevel</span>
                                }
                                <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-slate-600">@researchTypeLabel(research.ResearchType)</span>
                                @if (!string.IsNullOrEmpty(research.CveId))
                                {
                                    <span class="font-mono text-[9px] text-rose-300">@research.CveId</span>
                                }
                            </div>
                            <h2 class="mt-7 text-xl font-semibold tracking-[-0.02em] text-white transition group-hover:text-rose-200">@research.Title</h2>
                        </div>
                        @if (!string.IsNullOrEmpty(research.CoverImageUrl))
                        {
                            <img src="@research.CoverImageUrl" alt="@research.Title" loading="lazy" class="h-20 w-20 shrink-0 rounded-xl object-cover opacity-75 transition group-hover:opacity-100 sm:h-24 sm:w-24" />
                        }
                    </div>

                    <p class="mt-4 line-clamp-3 text-sm leading-6 text-slate-500">@research.Summary</p>
                    @if (!string.IsNullOrEmpty(research.TargetCategory))
                    {
                        <p class="mt-4 font-mono text-[9px] uppercase tracking-[0.14em] text-slate-700">Target / @research.TargetCategory</p>
                    }
                    <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-white/[0.07] pt-5 font-mono text-[9px] uppercase tracking-[0.12em] text-slate-600">
                        <span>@(research.PublishedAt?.ToString("dd MMM yyyy") ?? "Undated")</span>
                        <span>@research.ReadingTimeMinutes min read</span>
                        <span class="ml-auto">@research.ViewCount unique @(research.ViewCount == 1 ? "view" : "views")</span>
                    </div>
                </a>
            }
        </div>
    }
</section>
