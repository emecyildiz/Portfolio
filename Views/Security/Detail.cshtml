@model Portfolio.Models.SecurityResearch
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;
    var images = ViewBag.Images as List<Portfolio.Models.Media> ?? new();
    var related = ViewBag.Related as List<Portfolio.Models.SecurityResearch> ?? new();
}

<div class="max-w-4xl mx-auto px-6 py-16">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-sm text-gray-600 mb-8 font-mono">
        <a href="/" class="hover:text-white transition">~</a>
        <span>/</span>
        <a href="/security" class="hover:text-white transition">security</a>
        <span>/</span>
        <span class="text-gray-400">@Model.Slug</span>
    </div>

    <!-- Header -->
    <div class="mb-10">
        <div class="flex flex-wrap items-center gap-2 mb-4">
            @if (!string.IsNullOrEmpty(Model.SeverityLevel))
            {
                var sevColor = Model.SeverityLevel switch
                {
                    "critical" => "text-red-400 bg-red-900/30 border-red-900",
                    "high" => "text-orange-400 bg-orange-900/30 border-orange-900",
                    "medium" => "text-amber-400 bg-amber-900/30 border-amber-900",
                    "low" => "text-blue-400 bg-blue-900/30 border-blue-900",
                    _ => "text-gray-400 bg-gray-800 border-gray-700"
                };
                <span class="font-mono text-xs px-2 py-1 rounded border @sevColor">
                    @Model.SeverityLevel.ToUpper()
                </span>
            }
            <span class="text-xs text-gray-500 font-mono">@Model.ResearchType</span>
            @if (!string.IsNullOrEmpty(Model.CveId))
            {
                <span class="font-mono text-xs text-red-400 bg-red-900/20 px-2 py-1 rounded border border-red-900/50">
                    @Model.CveId
                </span>
            }
        </div>

        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">@Model.Title</h1>
        <p class="text-gray-400 text-lg">@Model.Summary</p>

        <div class="flex flex-wrap items-center gap-4 mt-6 text-sm text-gray-600">
            <span>@(Model.PublishedAt?.ToString("dd MMMM yyyy") ?? "")</span>
            <span>@Model.ReadingTimeMinutes dk okuma</span>
            <span>@Model.ViewCount görüntülenme</span>
            @if (!string.IsNullOrEmpty(Model.GithubUrl))
            {
                <a href="@Model.GithubUrl" target="_blank"
                   class="text-blue-400 hover:text-blue-300 transition">GitHub / PoC →</a>
            }
        </div>
    </div>

    <!-- Kapak görseli -->
    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <img src="@Model.CoverImageUrl" alt="@Model.Title"
             class="w-full rounded-xl mb-10 border border-gray-800" />
    }

    <!-- Teknik bilgi kartı -->
    @{
        var tools = new List<string>();
        if (!string.IsNullOrEmpty(Model.ToolsUsed))
            tools = System.Text.Json.JsonSerializer.Deserialize<List<string>>(Model.ToolsUsed) ?? tools;
    }

    @if (!string.IsNullOrEmpty(Model.TargetCategory) || tools.Any())
    {
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-10 grid grid-cols-2 gap-6">
            @if (!string.IsNullOrEmpty(Model.TargetCategory))
            {
                <div>
                    <p class="text-xs text-gray-600 font-mono mb-2">// hedef sistem</p>
                    <p class="text-gray-300 text-sm">@Model.TargetCategory</p>
                </div>
            }
            @if (tools.Any())
            {
                <div>
                    <p class="text-xs text-gray-600 font-mono mb-2">// kullanılan araçlar</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var tool in tools)
                        {
                            <span class="font-mono text-xs bg-gray-800 text-gray-300 px-2 py-1 rounded">@tool</span>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- Markdown içerik -->
    <div class="prose prose-invert prose-lg max-w-none
                prose-headings:text-white prose-headings:font-bold
                prose-p:text-gray-400 prose-p:leading-relaxed
                prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline
                prose-code:text-green-400 prose-code:bg-gray-800 prose-code:px-1 prose-code:rounded prose-code:text-sm
                prose-pre:bg-gray-900 prose-pre:border prose-pre:border-gray-800
                prose-blockquote:border-red-600 prose-blockquote:text-gray-400
                prose-strong:text-white prose-li:text-gray-400">
        @Html.Raw(ViewBag.ContentHtml)
    </div>

    <!-- Görsel galeri -->
    @if (images.Any())
    {
        <div class="mt-12">
            <h3 class="text-sm font-mono text-gray-600 mb-4">// görseller</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                @foreach (var img in images)
                {
                    <div>
                        <img src="@img.Url" alt="@img.AltText"
                             class="w-full rounded-lg border border-gray-800 hover:border-gray-600 transition cursor-pointer" />
                        @if (!string.IsNullOrEmpty(img.Caption))
                        {
                            <p class="text-xs text-gray-600 mt-1 text-center">@img.Caption</p>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- İlgili araştırmalar -->
    @if (related.Any())
    {
        <div class="mt-16 pt-8 border-t border-gray-800">
            <h3 class="text-sm font-mono text-gray-600 mb-6">// ilgili araştırmalar</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                @foreach (var r in related)
                {
                    <a href="/security/@r.Slug"
                       class="bg-gray-900 border border-gray-800 hover:border-red-900/50 rounded-xl p-4 transition group">
                        <h4 class="text-white text-sm font-medium group-hover:text-red-300 transition mb-1">@r.Title</h4>
                        <p class="text-gray-600 text-xs line-clamp-2">@r.Summary</p>
                    </a>
                }
            </div>
        </div>
    }

    <!-- Geri dön -->
    <div class="mt-12 pt-8 border-t border-gray-800">
        <a href="/security" class="text-sm text-gray-500 hover:text-white transition font-mono">
            ← /security
        </a>
    </div>
</div>