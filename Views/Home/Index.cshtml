@model Portfolio.Models.ViewModels.HomepageViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["Description"] = "Siber güvenlik, elektronik ve yazılım geliştirme alanlarında çalışmalarım";
}

<!-- Hero -->
<section class="max-w-6xl mx-auto px-6 pt-24 pb-32">
    <div class="max-w-3xl">
        <p class="font-mono text-accent-blue text-sm mb-4">$ whoami</p>
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-6 leading-tight">
            Siber Güvenlik<br />
            <span class="gradient-text">Araştırmacısı</span>
        </h1>
        <p class="text-gray-400 text-lg leading-relaxed mb-8 max-w-2xl">
            Malware analizi, donanım güvenliği ve RF sistemleri üzerine araştırmalar yapıyorum.
            Elektronik projeler geliştiriyor, homelab'ımda ağ güvenliği testleri yürütüyorum.
        </p>
        <div class="flex flex-wrap gap-4">
            <a href="/security"
               class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition glow-blue">
                Araştırmalarım
            </a>
            <a href="/hire"
               class="border border-gray-700 hover:border-gray-500 text-gray-300 hover:text-white px-6 py-3 rounded-lg font-medium transition">
                İşe Al
            </a>
        </div>
        <!-- Şu an ne yapıyorum -->
        <!-- Şu an ne yapıyorum -->
        @if (ViewBag.CurrentlyWorking != null)
        {
            var working = ViewBag.CurrentlyWorking as Portfolio.Models.Note;
            <div class="mt-6">
                <div class="bg-gray-900 border border-gray-800 rounded-xl px-5 py-3 inline-flex items-center gap-3 max-w-full">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                    </span>
                    <span class="text-xs text-gray-500 font-mono">şu an üzerinde çalışıyorum:</span>
                    <span class="text-sm text-gray-300">@working!.Title</span>
                </div>
            </div>
        }
    </div>

    

    <!-- Terminal animasyonu -->
    <div class="mt-16 bg-gray-900 border border-gray-800 rounded-xl p-6 max-w-2xl font-mono text-sm">
        <div class="flex items-center gap-2 mb-4">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
            <span class="text-gray-600 text-xs ml-2">bash</span>
        </div>
        <div class="space-y-2 text-gray-400">
            <p><span class="text-green-400">➜</span> <span class="text-blue-400">~</span> cat skills.txt</p>
            <p class="text-gray-300">Siber Güvenlik: Malware Analysis, RF Security, Hardware Vuln</p>
            <p class="text-gray-300">Elektronik: ESP32, Arduino, Devre Tasarımı</p>
            <p class="text-gray-300">Homelab: pfSense, VLAN, Docker, Proxmox</p>
            <p class="text-gray-300">Geliştirme: C#, Python, ASP.NET Core</p>
            <p><span class="text-green-400">➜</span> <span class="text-blue-400">~</span> <span class="animate-pulse">_</span></p>
        </div>
    </div>
</section>

<!-- Öne Çıkan Güvenlik Araştırmaları -->
@if (Model.FeaturedSecurity.Any())
{
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-gray-800/50">
        <div class="flex items-center justify-between mb-8">
            <div>
                <p class="font-mono text-accent-red text-xs mb-1">// featured</p>
                <h2 class="text-2xl font-bold text-white">Güvenlik Araştırmaları</h2>
            </div>
            <a href="/security" class="text-sm text-gray-500 hover:text-white transition">Tümü →</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            @foreach (var r in Model.FeaturedSecurity)
            {
                <a href="/security/@r.Slug"
                   class="bg-gray-900 border border-gray-800 hover:border-red-900/50 rounded-xl p-5 transition group">
                    <div class="flex items-center gap-2 mb-3">
                        @if (!string.IsNullOrEmpty(r.SeverityLevel))
                        {
                            var sevColor = r.SeverityLevel switch
                            {
                                "critical" => "text-red-400 bg-red-900/30",
                                "high" => "text-orange-400 bg-orange-900/30",
                                "medium" => "text-amber-400 bg-amber-900/30",
                                _ => "text-gray-400 bg-gray-800"
                            };
                            <span class="text-xs px-2 py-0.5 rounded font-mono @sevColor">@r.SeverityLevel.ToUpper()</span>
                        }
                        <span class="text-xs text-gray-600">@r.ResearchType</span>
                    </div>
                    <h3 class="text-white font-medium mb-2 group-hover:text-red-300 transition">@r.Title</h3>
                    <p class="text-gray-500 text-sm line-clamp-2">@r.Summary</p>
                    @if (!string.IsNullOrEmpty(r.CveId))
                    {
                        <p class="font-mono text-xs text-red-400 mt-3">@r.CveId</p>
                    }
                </a>
            }
        </div>
    </section>
}

<!-- Öne Çıkan Projeler -->
@if (Model.FeaturedProjects.Any())
{
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-gray-800/50">
        <div class="flex items-center justify-between mb-8">
            <div>
                <p class="font-mono text-accent-blue text-xs mb-1">// featured</p>
                <h2 class="text-2xl font-bold text-white">Projeler</h2>
            </div>
            <a href="/electronics" class="text-sm text-gray-500 hover:text-white transition">Tümü →</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            @foreach (var p in Model.FeaturedProjects)
            {
                <a href="/@p.Category.Slug/@p.Slug"
                   class="bg-gray-900 border border-gray-800 hover:border-blue-900/50 rounded-xl overflow-hidden transition group">
                    @if (!string.IsNullOrEmpty(p.CoverImageUrl))
                    {
                        <img src="@p.CoverImageUrl" alt="@p.Title"
                             class="w-full h-40 object-cover group-hover:opacity-80 transition" />
                    }
                    else
                    {
                        <div class="w-full h-40 bg-gray-800 flex items-center justify-center">
                            <span class="text-gray-600 font-mono text-sm">no image</span>
                        </div>
                    }
                    <div class="p-5">
                        <h3 class="text-white font-medium mb-2 group-hover:text-blue-300 transition">@p.Title</h3>
                        <p class="text-gray-500 text-sm line-clamp-2">@p.Summary</p>
                    </div>
                </a>
            }
        </div>
    </section>
}

<!-- Homelab -->
@if (Model.FeaturedHomelab.Any())
{
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-gray-800/50">
        <div class="flex items-center justify-between mb-8">
            <div>
                <p class="font-mono text-accent-teal text-xs mb-1">// featured</p>
                <h2 class="text-2xl font-bold text-white">Homelab</h2>
            </div>
            <a href="/homelab" class="text-sm text-gray-500 hover:text-white transition">Tümü →</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            @foreach (var h in Model.FeaturedHomelab)
            {
                <a href="/homelab/@h.Slug"
                   class="bg-gray-900 border border-gray-800 hover:border-teal-900/50 rounded-xl p-5 transition group">
                    <span class="text-xs text-teal-400 font-mono">@h.Topic</span>
                    <h3 class="text-white font-medium mt-2 mb-2 group-hover:text-teal-300 transition">@h.Title</h3>
                    <p class="text-gray-500 text-sm line-clamp-2">@h.Summary</p>
                    <p class="text-gray-700 text-xs mt-3">@h.ReadingTimeMinutes dk okuma</p>
                </a>
            }
        </div>
    </section>
}

<!-- Son Blog Yazıları -->
@if (Model.RecentBlog.Any())
{
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-gray-800/50">
        <div class="flex items-center justify-between mb-8">
            <div>
                <p class="font-mono text-accent-purple text-xs mb-1">// recent</p>
                <h2 class="text-2xl font-bold text-white">Blog</h2>
            </div>
            <a href="/blog" class="text-sm text-gray-500 hover:text-white transition">Tümü →</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            @foreach (var b in Model.RecentBlog)
            {
                <a href="/blog/@b.Slug"
                   class="bg-gray-900 border border-gray-800 hover:border-purple-900/50 rounded-xl p-5 transition group flex gap-4">
                    @if (!string.IsNullOrEmpty(b.CoverImageUrl))
                    {
                        <img src="@b.CoverImageUrl" alt="@b.Title"
                             class="w-20 h-20 object-cover rounded-lg flex-shrink-0" />
                    }
                    <div>
                        <h3 class="text-white font-medium mb-1 group-hover:text-purple-300 transition">@b.Title</h3>
                        <p class="text-gray-500 text-sm line-clamp-2">@b.Summary</p>
                        <p class="text-gray-700 text-xs mt-2">
                            @(b.PublishedAt?.ToString("dd MMM yyyy") ?? "") · @b.ReadingTimeMinutes dk
                        </p>
                    </div>
                </a>
            }
        </div>
    </section>
}

<!-- Sertifikalar -->
@{
    var certs = ViewBag.Certificates as List<Portfolio.Models.Certificate> ?? new();
}
@if (certs.Any())
{
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-gray-800/50">
        <div class="mb-8">
            <p class="font-mono text-amber-400 text-xs mb-1">// certifications</p>
            <h2 class="text-2xl font-bold text-white">Sertifikalar</h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            @foreach (var cert in certs)
            {
                <div class="bg-gray-900 border border-gray-800 hover:border-amber-900/50 rounded-xl p-5 transition text-center">
                    @if (!string.IsNullOrEmpty(cert.ImageUrl))
                    {
                        <img src="@cert.ImageUrl" alt="@cert.Title" class="w-16 h-16 mx-auto mb-3 object-contain" />
                    }
                    else
                    {
                        <div class="w-16 h-16 mx-auto mb-3 bg-amber-900/20 rounded-full flex items-center justify-center">
                            <span class="text-amber-400 text-2xl">🎖</span>
                        </div>
                    }
                    <h3 class="text-white text-sm font-medium mb-1">@cert.Title</h3>
                    <p class="text-gray-600 text-xs">@cert.Issuer</p>
                    <p class="text-gray-700 text-xs mt-1">@cert.IssuedDate.ToString("MMM yyyy")</p>
                    @if (!string.IsNullOrEmpty(cert.CredentialUrl))
                    {
                        <a href="@cert.CredentialUrl" target="_blank"
                           class="text-xs text-blue-400 hover:text-blue-300 transition mt-2 inline-block">
                            Doğrula →
                        </a>
                    }
                </div>
            }
        </div>
    </section>
}

<!-- İletişim CTA -->
<section class="max-w-6xl mx-auto px-6 py-16 border-t border-gray-800/50">
    <div class="bg-gradient-to-r from-blue-950/50 to-purple-950/50 border border-blue-900/30 rounded-2xl p-10 text-center">
        <p class="font-mono text-blue-400 text-sm mb-3">// contact</p>
        <h2 class="text-3xl font-bold text-white mb-4">Birlikte çalışalım</h2>
        <p class="text-gray-400 mb-8 max-w-md mx-auto">
            Ağ güvenliği, penetrasyon testi veya elektronik proje danışmanlığı için iletişime geç.
        </p>
        <a href="/hire"
           class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-medium transition inline-block glow-blue">
            İletişime Geç
        </a>
    </div>
</section>