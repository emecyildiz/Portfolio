@model Portfolio.Models.ViewModels.HomepageViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "Cybersecurity research, electronics projects, homelab work, and software development.";
    var activity = ViewBag.RecentActivity as List<Portfolio.Models.ViewModels.ActivityItem> ?? new();
    var certs = ViewBag.Certificates as List<Portfolio.Models.Certificate> ?? new();
    var currentFocusUrl = Model.CurrentFocus?.Url?.Trim();
    var hasSafeCurrentFocusUrl = false;
    if (!string.IsNullOrWhiteSpace(currentFocusUrl))
    {
        var isSafeInternalPath = currentFocusUrl.StartsWith('/') &&
                                 !currentFocusUrl.StartsWith("//") &&
                                 Uri.TryCreate(currentFocusUrl, UriKind.Relative, out _);
        var isSafeExternalUrl = Uri.TryCreate(currentFocusUrl, UriKind.Absolute, out var absoluteCurrentFocusUrl) &&
                                absoluteCurrentFocusUrl.Scheme == Uri.UriSchemeHttps;
        hasSafeCurrentFocusUrl = isSafeInternalPath || isSafeExternalUrl;
    }
}

<section class="home-lead public-container">
    <div class="home-lead__grid">
        <div>
            <p class="archive-label">Independent engineering portfolio / work in progress</p>
            <h1>Security research, hardware experiments, and systems I have built.</h1>
            <p class="home-lead__summary">
                This is a working record of reverse engineering, malware analysis, electronics,
                self-hosted infrastructure, and software—documented with the decisions, failures,
                and technical details that shaped each result.
            </p>
            <div class="public-actions">
                @if (Model.FeaturedProjects.Any())
                {
                    <a href="#selected-work" class="public-button focus-ring">View selected work <span aria-hidden="true">↓</span></a>
                }
                else
                {
                    <a href="/electronics" class="public-button focus-ring">Browse published projects <span aria-hidden="true">→</span></a>
                }
                <a href="/activity" class="public-button--quiet focus-ring">Open chronological archive <span aria-hidden="true">→</span></a>
            </div>
        </div>

        <aside class="home-lead__aside">
            @if (Model.CurrentFocus != null)
            {
                <p class="archive-label">Current focus</p>
                <p class="home-lead__aside-title">@Model.CurrentFocus.Title</p>
                <p class="home-lead__aside-copy">The subject currently on the workbench. This note changes as active research and builds move forward.</p>
                @if (hasSafeCurrentFocusUrl)
                {
                    <a href="@currentFocusUrl" target="_blank" rel="noopener noreferrer" class="home-lead__aside-link focus-ring">Open related record ↗</a>
                }
            }
            else
            {
                <p class="archive-label">Archive scope</p>
                <p class="home-lead__aside-title">Built, inspected, and documented.</p>
                <p class="home-lead__aside-copy">Projects are published as technical records, not marketing case studies. Evidence and implementation details come first.</p>
            }
        </aside>
    </div>
</section>

<nav aria-label="Portfolio disciplines" class="discipline-index">
    <div class="discipline-index__inner public-container">
        <a href="/security" class="discipline-link focus-ring">
            <span class="discipline-link__number">01 / Research</span>
            <strong>Security</strong>
            <small>Malware analysis, reverse engineering, vulnerability research.</small>
        </a>
        <a href="/electronics" class="discipline-link focus-ring">
            <span class="discipline-link__number">02 / Build</span>
            <strong>Electronics</strong>
            <small>Embedded devices, circuit work, sensors, and hardware experiments.</small>
        </a>
        <a href="/homelab" class="discipline-link focus-ring">
            <span class="discipline-link__number">03 / Operate</span>
            <strong>Homelab</strong>
            <small>Networks, virtualization, services, and defensive infrastructure.</small>
        </a>
        <a href="/webapps" class="discipline-link focus-ring">
            <span class="discipline-link__number">04 / Develop</span>
            <strong>Software</strong>
            <small>Web applications, backend services, automation, and tooling.</small>
        </a>
    </div>
</nav>

@if (Model.FeaturedProjects.Any())
{
    <section id="selected-work" class="editorial-section public-container">
        <header class="section-heading">
            <p class="archive-label">01 / Selected work</p>
            <h2>Projects with the process left visible.</h2>
            <a href="/activity" class="focus-ring">Full archive →</a>
        </header>

        <div class="selected-work">
            @{ var projectIndex = 0; }
            @foreach (var project in Model.FeaturedProjects)
            {
                projectIndex++;
                <a href="/@project.Category.Slug/@project.Slug" class="selected-work__item focus-ring">
                    <div class="selected-work__meta">
                        <span>@projectIndex.ToString("D2")</span><br />
                        <span>@project.Category.Name</span><br />
                        <span>@(project.PublishedAt?.ToString("yyyy.MM.dd") ?? "In progress")</span>
                    </div>
                    <div>
                        <h3 class="selected-work__title">@project.Title</h3>
                        <p class="selected-work__summary">@project.Summary</p>
                    </div>
                    <div class="selected-work__visual">
                        @if (!string.IsNullOrEmpty(project.CoverImageUrl))
                        {
                            <img src="@project.CoverImageUrl" alt="@project.Title" loading="lazy" class="selected-work__image" />
                        }
                        else
                        {
                            <div class="selected-work__placeholder">Project image pending</div>
                        }
                    </div>
                </a>
            }
        </div>
    </section>
}

@if (Model.FeaturedSecurity.Any() || Model.FeaturedHomelab.Any())
{
    <section class="editorial-section public-container">
        <div class="editorial-columns">
            @if (Model.FeaturedSecurity.Any())
            {
                <div>
                    <header class="editorial-column__header">
                        <div>
                            <p class="archive-label">02 / Investigation</p>
                            <h2>Security research</h2>
                        </div>
                        <a href="/security" class="focus-ring">All research ↗</a>
                    </header>
                    <div class="record-list">
                        @foreach (var research in Model.FeaturedSecurity)
                        {
                            <a href="/security/@research.Slug" class="record-row focus-ring">
                                <span class="record-row__type">@research.ResearchType<br />@research.SeverityLevel</span>
                                <span>
                                    <span class="record-row__title">@research.Title</span>
                                    <span class="record-row__summary">@research.Summary</span>
                                </span>
                                <span aria-hidden="true" class="record-row__arrow">↗</span>
                            </a>
                        }
                    </div>
                </div>
            }

            @if (Model.FeaturedHomelab.Any())
            {
                <div>
                    <header class="editorial-column__header">
                        <div>
                            <p class="archive-label">03 / Infrastructure</p>
                            <h2>Homelab records</h2>
                        </div>
                        <a href="/homelab" class="focus-ring">Open the lab ↗</a>
                    </header>
                    <div class="record-list">
                        @foreach (var lab in Model.FeaturedHomelab)
                        {
                            <a href="/homelab/@lab.Slug" class="record-row focus-ring">
                                <span class="record-row__type">@lab.Topic<br />@lab.ReadingTimeMinutes min</span>
                                <span>
                                    <span class="record-row__title">@lab.Title</span>
                                    <span class="record-row__summary">@lab.Summary</span>
                                </span>
                                <span aria-hidden="true" class="record-row__arrow">↗</span>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (activity.Any() || Model.RecentBlog.Any())
{
    <section class="editorial-section public-container">
        <div class="editorial-columns">
            @if (activity.Any())
            {
                <div>
                    <header class="editorial-column__header">
                        <div>
                            <p class="archive-label">04 / Chronology</p>
                            <h2>Recent activity</h2>
                        </div>
                        <a href="/activity" class="focus-ring">Full timeline →</a>
                    </header>
                    <div class="record-list">
                        @foreach (var item in activity)
                        {
                            <a href="@item.Url" class="record-row focus-ring">
                                <span class="record-row__date">@(item.Date?.ToString("dd MMM") ?? "—")<br />@item.TypeLabel</span>
                                <span class="record-row__title">@item.Title</span>
                                <span aria-hidden="true" class="record-row__arrow">→</span>
                            </a>
                        }
                    </div>
                </div>
            }

            @if (Model.RecentBlog.Any())
            {
                <div>
                    <header class="editorial-column__header">
                        <div>
                            <p class="archive-label">05 / Writing</p>
                            <h2>Technical notes</h2>
                        </div>
                        <a href="/blog" class="focus-ring">All notes →</a>
                    </header>
                    <div class="record-list">
                        @foreach (var post in Model.RecentBlog)
                        {
                            <a href="/blog/@post.Slug" class="record-row focus-ring">
                                <span class="record-row__date">@(post.PublishedAt?.ToString("dd MMM") ?? "—")<br />@post.ReadingTimeMinutes min</span>
                                <span>
                                    <span class="record-row__title">@post.Title</span>
                                    <span class="record-row__summary">@post.Summary</span>
                                </span>
                                <span aria-hidden="true" class="record-row__arrow">→</span>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (certs.Any())
{
    <section class="editorial-section public-container">
        <header class="section-heading">
            <p class="archive-label">06 / Credentials</p>
            <h2>Verified learning and formal training.</h2>
            <span></span>
        </header>
        <div class="credential-strip">
            @foreach (var cert in certs)
            {
                var certificateImageUrl = cert.ImageUrl?.Trim();
                var credentialUrl = cert.CredentialUrl?.Trim();
                var hasSafeCertificateImageUrl = !string.IsNullOrEmpty(certificateImageUrl)
                    && ((certificateImageUrl.StartsWith('/') && !certificateImageUrl.StartsWith("//") && Uri.TryCreate(certificateImageUrl, UriKind.Relative, out _))
                        || (Uri.TryCreate(certificateImageUrl, UriKind.Absolute, out var certificateImageUri) && certificateImageUri.Scheme == Uri.UriSchemeHttps));
                var hasSafeCredentialUrl = Uri.TryCreate(credentialUrl, UriKind.Absolute, out var credentialUri)
                    && credentialUri.Scheme == Uri.UriSchemeHttps;
                <article class="credential-item">
                    @if (hasSafeCertificateImageUrl)
                    {
                        <img src="@certificateImageUrl" alt="@cert.Title" loading="lazy" />
                    }
                    else
                    {
                        <span class="credential-item__mark">CERT</span>
                    }
                    <div>
                        <h3>@cert.Title</h3>
                        <p>@cert.Issuer · @cert.IssuedDate.ToString("MMM yyyy")</p>
                        @if (hasSafeCredentialUrl)
                        {
                            <a href="@credentialUrl" target="_blank" rel="noopener noreferrer" class="focus-ring">Verify credential ↗</a>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

<section class="editorial-section public-container">
    <div class="contact-band">
        <div>
            <p class="archive-label">Contact / project requests</p>
            <h2>Need engineering or security work?</h2>
            <p>Send the scope, constraints, and expected outcome. A ticket number is created so the request can be tracked without losing context.</p>
        </div>
        <a href="/hire" class="focus-ring">Submit a work request <span aria-hidden="true">↗</span></a>
    </div>
</section>
