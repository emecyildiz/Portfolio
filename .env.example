# Copy this file to .env and replace every placeholder before running Docker Compose.
# Never commit the real .env file.

POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=portfolio_db

ADMIN_PATH=replace-with-a-private-admin-path
ADMIN_EMAIL=replace-with-your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password

# Generate with: openssl rand -base64 32
ANALYTICS_HASH_KEY=replace-with-a-base64-encoded-32-byte-random-key

# Public details shown in the privacy notice.
# These values are not secrets, but they must be accurate before launch.
PRIVACY_CONTROLLER_NAME=replace-with-the-public-operator-name
PRIVACY_CONTACT_EMAIL=replace-with-the-public-privacy-email
PRIVACY_HOSTING_PROVIDER=OVHcloud
PRIVACY_HOSTING_COUNTRY=France

# Generate with: openssl rand -hex 32
WEEKLY_REPORT_TOKEN=replace-with-a-64-character-hexadecimal-token

# Leave disabled until the Resend domain is verified and the API key is set.
TICKET_EMAIL_ENABLED=false
TICKET_EMAIL_API_KEY=replace-with-a-resend-sending-api-key
TICKET_EMAIL_FROM_NAME=Emecworks
TICKET_EMAIL_FROM_ADDRESS=tickets@notify.emecworks.com
TICKET_EMAIL_REPLY_TO_ADDRESS=contact@emecworks.com
TICKET_EMAIL_PUBLIC_BASE_URL=https://emecworks.com
TICKET_EMAIL_DAILY_SEND_LIMIT=80
TICKET_EMAIL_MAX_PENDING_ITEMS=120

# Cloudflare Turnstile protects the public work-request form.
# Keep disabled until the production widget has been created.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=replace-with-the-public-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-the-private-turnstile-secret-key
TURNSTILE_EXPECTED_HOSTNAME=emecworks.com
TURNSTILE_EXPECTED_ACTION=contact

# Semicolon-separated host names accepted by ASP.NET Core in production.
ALLOWED_HOSTS=emecworks.com;www.emecworks.com
