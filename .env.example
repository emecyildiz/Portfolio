# Copy this file to .env and replace every placeholder before running Docker Compose.
# Never commit the real .env file.

POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=portfolio_db

ADMIN_PATH=replace-with-a-private-admin-path
ADMIN_EMAIL=replace-with-your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password

# Semicolon-separated host names accepted by ASP.NET Core in production.
ALLOWED_HOSTS=portfolio.example.com;www.portfolio.example.com
